---
import "../styles/global.css";
---

<footer class="footer">
  <div class="footer-container">

    <div class="footer-top">
      <div class="footer-social">
        <p>Follow Us</p>
          <a href="https://instagram.com/planethimalayas.kamal" target="_blank"><i class="fab fa-instagram"></i></a>
          <a href="https://facebook.com/planethimalayas" target="_blank"><i class="fab fa-facebook"></i></a>
          <a href="https://linkedin.com/company/planethimalayas" target="_blank"><i class="fab fa-linkedin"></i></a>
          <a href="https://youtube.com/@planethimalayas" target="_blank"><i class="fab fa-youtube"></i></a>
      </div>
    </div>

    <!-- First row (columns like Google) -->
    <div class="footer-columns">

      <div class="footer-col">
        <h4>Treks by Difficulty</h4>
        <ul>
          <li><a href="/upcoming-treks?difficulty=easy">Easy</a></li>
          <li><a href="/upcoming-treks?difficulty=moderate">Moderate</a></li>
          <li><a href="/upcoming-treks?difficulty=difficult">Difficult</a></li>
        </ul>
      </div>

      <div class="footer-col">
        <h4>Treks by Season</h4>
        <ul>
          <li><a href="/upcoming-treks?season=summer">Summer</a></li>
          <li><a href="/upcoming-treks?season=autumn">Autumn</a></li>
          <li><a href="/upcoming-treks?season=winter">Winter</a></li>
          <li><a href="/upcoming-treks?season=spring">Spring</a></li>
          <li><a href="/upcoming-treks?season=monsoon">Monsoon</a></li>
        </ul>
      </div>

      <div class="footer-col">
        <h4>Treks by Month</h4>
        <ul>
          <li><a href="/upcoming-treks?month=january">January</a></li>
          <li><a href="/upcoming-treks?month=february">February</a></li>
          <li><a href="/upcoming-treks?month=march">March</a></li>
          <li><a href="/upcoming-treks?month=april">April</a></li>
          <li><a href="/upcoming-treks?month=may">May</a></li>
          <li><a href="/upcoming-treks?month=june">June</a></li>
          <li><a href="/upcoming-treks?month=july">July</a></li>
          <li><a href="/upcoming-treks?month=august">August</a></li>
          <li><a href="/upcoming-treks?month=september">September</a></li>
          <li><a href="/upcoming-treks?month=october">October</a></li>
          <li><a href="/upcoming-treks?month=november">November</a></li>
          <li><a href="/upcoming-treks?month=december">December</a></li>
        </ul>
      </div>

      <div class="footer-col">
      <h4>Treks by region</h4>
        <ul>
        <li><a href="/upcoming-treks?region=uttarakhand" target="_blank" rel="noopener noreferrer">Uttarakhand</a></li>
        <li><a href="/upcoming-treks?region=himachal" target="_blank" rel="noopener noreferrer">Himachal</a></li>
        <li><a href="/upcoming-treks?region=ladakh" target="_blank" rel="noopener noreferrer">Ladakh</a></li>
        <li><a href="/upcoming-treks?region=kashmir" target="_blank" rel="noopener noreferrer">Kashmir</a></li>
        <li><a href="/upcoming-treks?region=sikkim" target="_blank" rel="noopener noreferrer">Sikkim</a></li>
        <li><a href="/upcoming-treks?region=west%20bengal" target="_blank" rel="noopener noreferrer">West Bengal</a></li>
        <li><a href="/upcoming-treks?region=nepal" target="_blank" rel="noopener noreferrer">Nepal</a></li>
        </ul>
      </div>

      <div class="footer-col">
      <h4>Treks by days</h4>
        <ul>
        <li><a href="/upcoming-treks?days=4" target="_blank" rel="noopener noreferrer">4 Days</a></li>
        <li><a href="/upcoming-treks?days=5" target="_blank" rel="noopener noreferrer">5 Days</a></li>
        <li><a href="/upcoming-treks?days=6" target="_blank" rel="noopener noreferrer">6 Days</a></li>
        <li><a href="/upcoming-treks?days=7" target="_blank" rel="noopener noreferrer">7 Days</a></li>
        <li><a href="/upcoming-treks?days=8" target="_blank" rel="noopener noreferrer">8 Days</a></li>
        <li><a href="/upcoming-treks?days=9" target="_blank" rel="noopener noreferrer">9 Days</a></li>
        <li><a href="/upcoming-treks?days=10" target="_blank" rel="noopener noreferrer">10 Days</a></li>
        </ul>
      </div>
    </div>

    <div class="footer-home">
      <p><a href="/" class="footer-brand">Planethimalayas</a></p>
      <div class="footer-quick-links">
        <a href="/upcoming-treks">Upcoming Treks</a>
        <a href="/terms-and-conditions">Terms & Conditions</a>
        <a href="/cancellation-and-refund-policy">Cancellation Policy</a>
        <a href="/faqs">FAQs</a>
        <a href="/blogs">Articles</a>
        <a href="/about">About Us</a>
      </div>
    </div>


    <!-- Bottom bar -->
    <div class="footer-bottom">
      <div class="footer-legal">
        <a href="/docs/privacy-policy.pdf" target="_blank">Privacy Policy</a>
        <span>|</span>
        <a href="/docs/terms-and-conditions.pdf" target="_blank">Terms & Conditions</a>
      </div>
      <div class="footer-copy">
        © 2025 Planethimalayas | All Rights Reserved
      </div>
    </div>
  </div>
</footer>

<style>
.footer {
  background: #f9f9f9;
  padding: 3rem 2rem;
  font-family: Roboto, sans-serif;
  color: #333;
  
}

.footer-container {
  max-width: 100%;
  margin: 0 auto;
}

.footer-top {
  display: flex;
  flex-direction: column;
  gap: 0.5rem;
  border-bottom: 1px solid #ddd;
  padding-bottom: 1rem;
  font-size: 0.9rem;
  color: #333;
  margin-bottom: 1rem;
}

.footer-top i {
  font-size: 1.5rem;
  padding: 0 1rem;
}

.footer-top a:hover {
  color: #ff7300;
}

.footer-social {
  display: flex;
  gap: 0.5rem;
  flex-wrap: wrap;
}

.footer-columns {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
  gap: 2rem;
  margin-bottom: 2rem;
  margin-top: 2rem;
}

.footer-col h4 {
  font-family: Helvetica, sans-serif;
  font-size: 1rem;
  font-weight: bold;
  margin-bottom: 1rem;
  color: #000;
}

.footer-col ul {
  list-style: none;
  padding: 0;
  margin: 0;
}

.footer-col li {
  margin-bottom: 0.6rem;
  font-size: 0.9rem;
}

.footer-col a {
  color: #333;
  text-decoration: none;
}

.footer-col a:hover {
  color: #ff7300;
}

.footer-home {
  display: flex;
  flex-direction: column;
  gap: 1rem; /* space between brand name and links */
  border-top: 1px solid #ddd;
  padding-top: 2rem;
  padding-bottom: 2rem;
  font-size: 0.9rem;
  color: #666;
}

.footer-brand {
  font-size: 2rem;
  color: #666;
  text-decoration: none;
}

.footer-brand:hover {
  color: #ff7300;
}

.footer-quick-links {
  display: flex;
  flex-wrap: wrap;
  gap: 2rem; /* increase this to add more spacing between <a> links */
}

.footer-home a {
  color: #666;
  text-decoration: none;
}

.footer-home a:hover {
  color: #ff7300;
}


.footer-bottom {
  display: flex;
  flex-direction: column;
  gap: 0.5rem;
  border-top: 1px solid #ddd;
  padding-top: 2rem;
  font-size: 0.9rem;
  color: #666;
}

.footer-bottom a {
  color: #666;
  text-decoration: none;
}

.footer-bottom a:hover {
  color: #ff7300;
}

.footer-legal {
  display: flex;
  gap: 0.5rem;
  flex-wrap: wrap;
}
</style>
