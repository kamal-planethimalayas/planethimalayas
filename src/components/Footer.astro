<style>
.footer {
  background: #f9f9f9;
  padding: 3rem 2rem;
  font-family: Roboto, sans-serif;
  color: #333;
  
}

.footer-container {
  max-width: 100%;
  margin: 0 auto;
}

.footer-top {
  display: flex;
  flex-direction: column;
  gap: 0.5rem;
  border-bottom: 1px solid #ddd;
  padding-bottom: 1rem;
  font-size: 0.9rem;
  color: #333;
  margin-bottom: 1rem;
}

.footer-top i {
  font-size: 1.5rem;
  padding: 0 1rem;
}

.footer-top a:hover {
  color: #ff7300;
}

.footer-social {
  display: flex;
  gap: 0.5rem;
  flex-wrap: wrap;
}

.footer-social h4 {
  font-size: 1rem;
  font-color: #000;
  font-family: Helvetica, sans-serif;
  margin-right: 1rem;
}

.footer-columns {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
  gap: 2rem;
  margin-bottom: 2rem;
  margin-top: 2rem;
}

.footer-col h4 {
  font-family: Helvetica, sans-serif;
  font-size: 1rem;
  font-weight: bold;
  margin-bottom: 1rem;
  color: #000;
}

.footer-col ul {
  list-style: none;
  padding: 0;
  margin: 0;
}

.footer-col li {
  margin-bottom: 0.6rem;
  font-size: 0.9rem;
}

.footer-col a {
  color: #333;
  text-decoration: none;
}

.footer-col a:hover {
  color: #ff7300;
}

.footer-home {
  display: flex;
  flex-direction: column;
  gap: 1rem; /* space between brand name and links */
  border-top: 1px solid #ddd;
  padding-top: 2rem;
  padding-bottom: 2rem;
  font-size: 0.9rem;
  color: #666;
}

.footer-brand {
  font-size: 2rem;
  text-decoration: none;
  display: inline-block;
  transition: transform 0.2s ease, letter-spacing 0.2s ease;
}

/* Planet = black */
.brand-planet {
  color: #000;
}

/* Himalayas = brand color */
.brand-himalayas {
  color: #ff7300;
}

.footer-brand:hover {
  letter-spacing: 0.5px;
}


.footer-address strong {
  color: #000;
  font-size: 1rem;
  margin-right: 1rem;
  font-family: Helvetica, sans-serif;
}

.footer-quick-links {
  display: flex;
  flex-wrap: wrap;
  gap: 2rem; /* increase this to add more spacing between <a> links */
}

.footer-home a:not(.footer-brand) {
  color: #666;
  text-decoration: none;
}

.footer-home a:not(.footer-brand):hover {
  color: #ff7300;
}

.footer-brand,
.footer-brand:visited,
.footer-brand:active,
.footer-brand:focus {
  color: inherit;
  text-decoration: none;
}


.footer-bottom {
  display: flex;
  flex-direction: column;
  gap: 0.5rem;
  border-top: 1px solid #ddd;
  padding-top: 2rem;
  font-size: 0.9rem;
  color: #666;
}

.footer-bottom a {
  color: #666;
  text-decoration: none;
}

.footer-bottom a:hover {
  color: #ff7300;
}

.footer-legal {
  display: flex;
  gap: 0.5rem;
  flex-wrap: wrap;
}
</style>
