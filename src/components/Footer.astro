---
import "../styles/global.css";
---
<div class="container">
<style>
  .footer-heading {
    font-family: Helvetica, sans-serif;
    font-size: 2rem;
    font-weight: bold;
    text-align: left;
  }
  .footer-underline {
      height: 2px;
      background-color: #ff7300;
      width: 100%;
      margin: 0 auto 2rem auto;
    }

  footer {
    font-family: 'Roboto', sans-serif;
    color: black;
    background-color: white;
  }

  .footer-top {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 1.5rem;
    margin-bottom: 2rem;
  }

  .footer-card {
    background: white;
    padding: 1rem;
    border-radius: 10px;
    box-shadow: 2px 6px 15px rgba(0, 0, 0, 0.3); /* <- This creates the full card shadow */
    margin-bottom: 1rem;
  }

  .footer-card h4 {
    font-family: Helvetica, sans-serif;
    font-weight: bold;
    margin-bottom: 0.5rem;
    border-bottom: 2px solid #ff7300;
  }

  .footer-card ul {
    list-style: none;
    padding: 0;
    margin: 0;  
  }

  .footer-card li {
    font-weight: normal;
    margin-bottom: 0.4rem;
    font-size: 0.85rem;
    
  }

  .brand-separator {
    height: 2px;
    width: 100%;
    background-color: #ff7300;
    margin: 2rem 0;
  }

  .footer-bottom-section {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 1.5rem;
    margin-bottom: 2rem;
  }

 .social-links {
  display: flex;
  gap: 16px; /* spacing between icons */
  padding: 0;
  margin: 0;
  list-style: none;
}

.social-links a {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 48px;   /* circle size */
  height: 48px;
  border-radius: 50%;
  background: #f5f5f5; /* light background */
  transition: all 0.3s ease;
}

.social-links i {
  font-size: 22px; /* icon size */
}

.social-links a:hover {
  background: var(--brand-color, #ff7300);
  transform: scale(1.1);
}

.social-links a:hover i {
  color: white !important;
}

.social-links a,
.social-links a:visited,
.social-links a:hover,
.social-links a:focus {
  text-decoration: none;
}


  .copyright {
    font-size: 0.85rem;
    opacity: 0.8;
  }
</style>

