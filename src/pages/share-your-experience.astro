---
import Layout from "../layouts/Layout.astro";
const brandColor = "#ff7300";
---

<Layout>

<head>
<meta charset="UTF-8">
</head>

  <!-- HERO SECTION -->
  <section class="share-hero">
    <div class="overlay"></div>
    <div class="hero-text">
      <h1>
        Share Your Himalayan Journey
      </h1>
      <p>
        Your stories inspire us and the community of fellow trekkers. Let the mountains speak through your experience.
      </p>
    </div>
  </section>

  <!-- FORM SECTION -->
  <section class="form-section">
    <div class="form-container">
      <h2 style="font-family: Helvetica, Arial, sans-serif; color: #ff7300; margin-bottom: 1.5rem; text-align: left;font-size: 2rem">
      Share Your Journey Among the Peaks
      </h2>
      <form id="experienceForm" action="https://formspree.io/f/xrbldkrb" method="POST">
        <label>
          Name
          <input type="text" name="name" required placeholder="Enter your full name...">
        </label>

        <label>
          Email-address
          <input type="text" name="name" required placeholder="Enter your email adress...">
        </label>

        <label>
          Location / City
          <input type="text" name="location" placeholder="Enter your location/city...(optional)">
        </label>

        <label>
          Your Trek Experience
          <textarea name="experience" rows="5" required placeholder="Write your trek experience..."></textarea>
        </label>

        <label>
          Can we feature your testimonial on our website?
          <select name="featureTestimonial" id="featureTestimonial" required>
            <option value="">Select</option>
            <option value="yes">Yes</option>
            <option value="no">No</option>
          </select>
        </label>

        <div id="conditionalFields" class="conditional-fields">
          <label>
            Your Profession
            <input type="text" name="profession" placeholder=Enter your profession here...">
          </label>

          <label>
            Upload Your Photo
            <input type="file" name="photo" accept="image/*" placeholder=Upload your image here...">
          </label>
        </div>

        <button type="submit" class="submit-btn">Submit</button>
      </form>

      <div id="thankYouMessage" class="thank-you-message">
        <p>
          Thank you for your precious time to share your trekking experience with us. Your feedback helps us grow better. In the meantime, you may like to take a tour of our upcoming treks.
        </p>
        <a href="/upcoming-treks" class="upcoming-btn">Upcoming Treks</a>
      </div>
    </div>
  </section>

  <!-- JS -->
  <script type="module">
    const featureSelect = document.getElementById('featureTestimonial');
    const conditionalFields = document.getElementById('conditionalFields');
    const form = document.getElementById('experienceForm');
    const thankYou = document.getElementById('thankYouMessage');

    featureSelect.addEventListener('change', () => {
      conditionalFields.style.display = featureSelect.value === 'yes' ? 'flex' : 'none';
    });

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      try {
        const response = await fetch(form.action, {
          method: 'POST',
          body: new FormData(form),
          headers: { 'Accept': 'application/json' }
        });
        if(response.ok){
          form.style.display = 'none';
          thankYou.style.display = 'block';
        } else {
          alert('Oops! There was a problem submitting your form.');
        }
      } catch(err) {
        alert('Oops! There was a problem submitting your form.');
      }
    });
  </script>
</Layout>

<style>
/* Hero Section */
.share-hero {
  position: relative;
  background: url('/images/extras/experience-hero.jpg') center 15%/cover no-repeat;
  min-height: 100vh;
  display: flex;
  align-items: center;
  justify-content: fles-start;
  text-align: left;
  color: white;
   z-index: 2;
   padding-left: 0;
   margin: 0;
  
  
}

.share-hero .overlay {
  position: absolute;
  bottom: 0; left: 0;
  width: 100%; height: 40%;
  background: rgba(0,0,0,0.5);
  z-index: 1;
}

.share-hero .hero-text {
  position: relative;
  z-index: 2;
  max-width: 100%;
  
  margin: 100px;
  text-shadow: 2px 4px 8px rgba(0, 0, 0, 0.8);
  font-size: 1.25rem;
  max-width: 100%;
  transform: translateY(120px);
  
}

.share-hero .hero-text h1 {
  color: white; /* explicit white heading */
  font-family: Helvetica, sans-serif;
  text-shadow: 2px 4px 8px rgba(0, 0, 0, 0.8);
  font-size: 2.5rem;
  text-align: left;
}

@media (min-width: 1024px) {
  .share-hero {
    background-position: top -350px center; /* move image up by 50px */
  }
}
@media (min-width: 1024px) {
  .share-hero .container {
    transform: translateY(16px); /* move text down by 100px */
  }
}
.brand-color {
  color: #ff7300;
}

/* Form Section */
.form-section {
  margin: 2rem 0;
  background-color: #f9f9f9;
  width: 100%;
  box-sizing: border-box;
}

.form-container {
  max-width: 800px; /* Adjust width as needed */
  margin: 2rem 100px; /* Left-aligned on desktop */
  padding: 1rem 0;
}

.form-container form {
  display: flex;
  flex-direction: column;
  gap: 1.5rem;
  text-align: left;
}

.form-container input,
.form-container textarea,
.form-container select {
  width: 100%;
  padding: 0.75rem;
  border-radius: 6px;
  border: 1px solid #ccc;
}

.conditional-fields {
  display: none;
  flex-direction: column;
  gap: 1rem;
}

.submit-btn {
  display: inline-block;
  background-color: #ff7300;
  color: white;
  font-weight: bold;
  padding: 0.75rem 1.5rem;
  border: none;
  border-radius: 6px;
  cursor: pointer;
  text-align: center;
  text-decoration: none;
  width: 200px;
}

.submit-btn {
  background-color: #e66400; /* Slightly darker on hover */
}

/* Thank You Message */
.thank-you-message {
  display: none;
  margin-top: 2rem;
  text-align: center;
  font-family: Roboto, sans-serif;
  font-size: 1rem;
  color: #444;
}

.upcoming-btn {
  display: inline-block;
  margin-top: 1rem;
  padding: 0.75rem 1.5rem;
  background-color: #ff7300;
  color: white;
  border-radius: 6px;
  text-decoration: none;
  font-weight: bold;
}

/* Responsive Mobile Adjustments */
@media (max-width: 768px) {

  /* Hero Section */
  .share-hero {
    margin-top: -55px;
    height: 100vh;; /* height including hidden navbar */
    display: flex;
    align-items: center; /* vertically center text */
    justify-content: center; /* horizontally center text */
    text-align: left;
    position: relative;
  }

  .share-hero .hero-text {
    font-size: 1rem;
    margin-left: 10px;
    margin-right: 10px;
    position: relative;
    z-index: 2;
    max-width: 80%;
    transform: translateY(-180px); /* move text down by 100px */
  }

  .share-hero .hero-text h1 {
    font-size: 2.5rem; /* slightly smaller than desktop */
    text-align: left;
  }

  .share-hero .overlay {
    
    background: rgba(0,0,0,0.5);
    width:100%;
    height: 40%;
    top:0;
  }


  /* Form Section */
  .form-container {
    margin: 100px; 
    max-width: 100%;
    

    
  }

  .form-container form {
    gap: 1rem; /* slightly smaller gaps for mobile */
  }

  /* Buttons */
  .submit-btn,
  .upcoming-btn {
    width: 100%; /* full-width buttons on mobile */
    padding: 0.75rem;
  }
}

</style>