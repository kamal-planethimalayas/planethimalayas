---
import Layout from "../layouts/Layout.astro";
const brandColor = "#ff7300";
---

<Layout>

<head>
<meta charset="UTF-8">
</head>

  <!-- HERO SECTION -->
  <section class="share-hero reveal">
  <div class="share-hero-overlay"></div>
    <div class="container">
      <h1>
        Share Your Himalayan Journey
      </h1>
      <p>
        Your stories inspire us and the community of fellow trekkers. Let the mountains speak through your experience.
      </p>
    </div>
  </section>

  <!-- FORM SECTION -->
  <section class="form-section reveal">
    <div class="form-container">
      <h2 style="font-family: Helvetica, Arial, sans-serif; color: #ff7300; margin-bottom: 1.5rem; text-align: left;font-size: 2rem">
      Share Your Journey Among the Peaks
      </h2>
      <form id="experienceForm" action="https://formspree.io/f/xrbldkrb" method="POST">
        <label>
          Name
          <input type="text" name="name" required placeholder="Enter your full name...">
        </label>

        <label>
          Email-address
          <input type="text" name="name" required placeholder="Enter your email adress...">
        </label>

        <label>
          Location / City
          <input type="text" name="location" placeholder="Enter your location/city...(optional)">
        </label>

        <label>
          Your Trek Experience
          <textarea name="experience" rows="5" required placeholder="Write your trek experience..."></textarea>
        </label>

        <label>
          Can we feature your testimonial on our website?
          <select name="featureTestimonial" id="featureTestimonial" required>
            <option value="">Select</option>
            <option value="yes">Yes</option>
            <option value="no">No</option>
          </select>
        </label>

        <div id="conditionalFields" class="conditional-fields">
          <label>
            Your Profession
            <input type="text" name="profession" placeholder=Enter your profession here...">
          </label>

          <label>
            Upload Your Photo 
            <input 
              type="file" 
              name="photo" 
              accept=".jpg,.jpeg,.png,.gif" 
              placeholder="Upload your image here..."
            >
            <small style="display:block; font-size:0.9rem; color:#666; margin-top:0.25rem;">
              Accepted formats: JPG, JPEG, PNG, GIF. Max size: 5 MB
            </small>
          </label>

        </div>

        <button type="submit" class="submit-btn">Submit</button>
      </form>

      <div id="thankYouMessage" class="thank-you-message">
        <p>
          Thank you for your precious time to share your trekking experience with us. Your feedback helps us grow better. In the meantime, you may like to take a tour of our upcoming treks.
        </p>
        <a href="/upcoming-treks" class="upcoming-btn">Upcoming Treks</a>
      </div>
    </div>
  </section>

  <!-- JS -->
  <script type="module">
    const featureSelect = document.getElementById('featureTestimonial');
    const conditionalFields = document.getElementById('conditionalFields');
    const form = document.getElementById('experienceForm');
    const thankYou = document.getElementById('thankYouMessage');

    featureSelect.addEventListener('change', () => {
      conditionalFields.style.display = featureSelect.value === 'yes' ? 'flex' : 'none';
    });

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      try {
        const response = await fetch(form.action, {
          method: 'POST',
          body: new FormData(form),
          headers: { 'Accept': 'application/json' }
        });
        if(response.ok){
          form.style.display = 'none';
          thankYou.style.display = 'block';
        } else {
          alert('Oops! There was a problem submitting your form.');
        }
      } catch(err) {
        alert('Oops! There was a problem submitting your form.');
      }
    });
  </script>

  <script>
    const heroContainer = document.querySelector(".share-hero .container");
    const hero = document.querySelector(".share-hero");

    window.addEventListener("scroll", () => {
      const heroRect = hero.getBoundingClientRect();
      const scrollY = window.scrollY;

      if (heroRect.bottom > 0) {
        let move = scrollY * 0.5;                
        const maxMove = hero.offsetHeight / 2;

        heroContainer.style.transform = `translateY(${move}px)`;
      }
    });
  </script>
</Layout>

<style>
/* HERO SECTION height-55px + image push higher*/

.share-hero {
  width: 100%;
  height: 100vh;
  background: url('/images/main/experience-hero9.jpg') center 60% no-repeat;
  background-size: cover; /* stretches to full width, crops if needed */
  display: flex;
  flex-direction: column;
  justify-content: flex-start;   /* content starts from left */
  align-items: center;           /* vertical center */
  padding: 2rem 2rem;
  color: #fff;
  position: relative;
}

.share-hero-overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(
    rgba(0, 0, 0, 0.4),
    rgba(0, 0, 0, 0.4)
  );
}

.share-hero .container{
  display: flex;
  flex-direction: column;
  justify-content: center;
  will-change: transform;
  transition: transform 0.1s linear;
  overflow: hidden;
}

.share-hero p {
  font-family: Roboto, sans-serif;
  font-size: 1.5rem;
  text-shadow: 2px 2px 5px rgba(0, 0, 0, 0.7),
    4px 4px 10px rgba(0, 0, 0, 0.5),
    0 0 8px rgba(0, 0, 0, 0.3);
  max-width: 1200px;
}

.share-hero h1 {
  font-family: Helvetica, Arial, sans-serif;
  color: white;
  font-size: 3rem;
  margin-bottom: 1rem;
  text-shadow:  3px 3px 6px rgba(0, 0, 0, 0.7),
    6px 6px 12px rgba(0, 0, 0, 0.5),
    0 0 10px rgba(0, 0, 0, 0.3);
}

.brand-color {
  color: #ff7300;
}

/* Form Section */
.form-section {
  background-color: #f9f9f9;
  width: 100%;
  box-sizing: border-box;
}

.form-container {
  max-width: 1200px; /* Adjust width as needed */
  margin: 0 100px; /* Left-aligned on desktop */
  padding: 1rem 0;
}

.form-container form {
  display: flex;
  flex-direction: column;
  gap: 1.5rem;
  text-align: left;
}

.form-container input,
.form-container textarea,
.form-container select {
  width: 100%;
  padding: 0.75rem;
  border-radius: 6px;
  border: 1px solid #ccc;
}

.conditional-fields {
  display: none;
  flex-direction: column;
  gap: 1rem;
}

.submit-btn {
  display: inline-block;
  background: transparent;
  color: #ff7300;
  font-family: "Roboto", sans-serif;
  font-weight: 700;
  padding: 0.7rem 2.5rem;
  border-radius: 8px;
  border: 2px solid #ff7300;
  text-decoration: none;
  box-shadow: 0 4px 10px rgba(0,0,0,0.2);
  transition: transform 0.3s ease, box-shadow 0.3s ease;
  padding: 0.75rem 1.5rem;
  cursor: pointer;
  text-align: center;
  text-decoration: none;
  width: 200px;
}

.submit-btn:hover {
  background: #ff7300;
  color: black;
  transform: scale(1.05);
  /* Bottom glow effect only */
  box-shadow: 0 8px 20px #ff7300, 0 6px 15px rgba(0, 0, 0, 0.4);
}

/* Thank You Message */
.thank-you-message {
  display: none;
  margin-top: 2rem;
  text-align: center;
  font-family: Roboto, sans-serif;
  font-size: 1rem;
  color: #444;
}

.upcoming-btn {
  display: inline-block;
  margin-top: 1rem;
  padding: 0.75rem 1.5rem;
  background-color: #ff7300;
  color: white;
  border-radius: 6px;
  text-decoration: none;
  font-weight: bold;
}

/* Responsive Mobile Adjustments */
@media (max-width: 768px) {

  /* Hero Section */
  .share-hero {
    height: 70vh;
    padding: 1rem 1rem;
    margin-top: -55px;
    overflow: hidden;
  }

  .share-hero p {
    font-size: 1rem;    
  }

  .share-hero h1 {
    font-size: 2rem;
  }

  /* Form Section */
  .form-container {
    max-width: 100%;
    margin: 0 1.5rem;     /* small side padding instead of large margins */
    padding: 0;
  }

  .form-container form {
    gap: 1rem; /* slightly smaller gaps for mobile */
  }

  /* Buttons */
  .submit-btn,
  .upcoming-btn {
    width: 100%; /* full-width buttons on mobile */
  }
}

</style>