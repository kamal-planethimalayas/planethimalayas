---
// src/pages/booking.astro
import BookingForm from "../components/BookingForm.jsx";
import global from "../styles/global.css?inline";
import phoneCss from "react-phone-input-2/lib/style.css?inline";
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <title>Booking Form</title>
    <style is:global>
/* Fix for react-phone-input-2 */
.react-tel-input {
  width: 100%;
  font-family: Helvetica, Arial, sans-serif;
}
.react-tel-input .form-control {
  padding-left: 48px; /* space for flag */
  height: 38px;
  border: 1px solid #ccc;
  border-radius: 5px;
}
.react-tel-input .flag-dropdown {
  border: none;
  background: transparent;
}
.react-tel-input .selected-flag {
  width: 55px;
  background: #fff;
}

/* Voucher input placeholder fix */
.voucher-input::placeholder {
  font-weight: bold !important;
  color: #444;
}
</style>
  </head>
  <body>
    <BookingForm client:only="react" />
  </body>
</html>
