---
import Layout from "../layouts/Layout.astro";
import { blogs } from "../data/blogsData.js";
---

<Layout>
  <!-- BLOG HERO (same as FAQ hero) -->
  <section class="faq-hero reveal">
    <div class="container">
      <h1 class="faq-hero-title">Journal</h1>
      <div class="faq-search-wrapper">
        <input
          id="blog-search"
          type="text"
          placeholder="Search topics like fitness, packing, AMS..."
        />
      </div>
    </div>
  </section>

  <section class="journal-intro">
  <div class="container">
    <p>
      Explore detailed trekking guides, fitness tips, packing checklists, and real Himalayan experiences. 
      Whether you're preparing for your first trek or planning a high-altitude expedition, our journal 
      helps you make informed decisions and trek with confidence.
    </p>
  </div>
</section>

<section class="blog-categories">
<h2 class="categories-title">Browse by <span>category</span></h2>
  <div class="container categories-grid">
    
    <button class="category-btn active" data-category="all">All</button>
    <button class="category-btn" data-category="Trek Guides">Trek Guides</button>
    <button class="category-btn" data-category="Preparation">Preparation</button>
    <button class="category-btn" data-category="Trekkig Tips & Basics">Trekkig Tips & Basics</button>
    <button class="category-btn" data-category="Health & Wellness">Health & Wellness</button>
    <button class="category-btn" data-category="Stories">Stories</button>

  </div>
</section>

  <!-- Blog Cards Section -->
<section class="blogs-section">
  <div class="container blogs-list">
    {blogs.map((blog, index) => (
      <a 
        href={`/blogs/${blog.slug}`} 
        class="blog-card" 
        target="_blank" 
        rel="noopener noreferrer"
        key={index}
        data-category={blog.category}
        data-search={`${blog.slug} ${blog.tags.join(" ")} ${blog.content}`}
      >
        <img src={blog.thumbnail} alt={blog.title} class="blog-thumb" />
        <div class="blog-content">
          <span class="blog-category">{blog.category}</span>
          <h2>{blog.title}</h2>

          <!-- Description wrapper: desc-inner holds the HTML so measurement is accurate -->
          <div class="blog-description" data-index={index}>
            <div class="desc-inner" set:html={blog.description}></div>
          </div>

          <span class="read-more" aria-expanded="false" style="display:none;">Read More</span>

                  
        </div>
      </a>
    ))}
  </div>
</section>

<section class="faq-preview">
  <div class="container">
    <h2>Still have <span>questions before your trek?</span></h2>
    <p>
      From altitude sickness and fitness to packing and safety — find clear answers 
      to everything you need before heading to the Himalayas.
    </p>
    <a href="/faqs" class="faq-btn">Explore FAQs</a>
  </div>
</section>

  <script>
  const searchInput = document.getElementById("blog-search");
  const blogCards = document.querySelectorAll(".blog-card");

  searchInput.addEventListener("input", () => {
    const value = searchInput.value.toLowerCase();

    blogCards.forEach(card => {
      // Read visible text
      const text = card.textContent.toLowerCase();

      // Read extra search data (slug, tags, content)
      const extra = card.getAttribute("data-search")?.toLowerCase() || "";

      // Match against both visible text + hidden data
      const haystack = text + " " + extra;

      card.style.display = haystack.includes(value) ? "flex" : "none";
    });
  });

  // Parallax effect (kept same)
  const heroTitle = document.querySelector(".faq-hero-title");
  window.addEventListener("scroll", () => {
    const scrollY = window.scrollY;
    heroTitle.style.transform = `translateY(${scrollY * 0.3}px)`;
  });
</script>

  <script>
  // Utility: debounce
  const debounce = (fn, wait = 120) => {
    let t;
    return (...args) => {
      clearTimeout(t);
      t = setTimeout(() => fn(...args), wait);
    };
  };

  function setupReadMoreControls() {
    document.querySelectorAll(".blog-card").forEach(card => {
      const desc = card.querySelector(".blog-description");
      const inner = desc.querySelector(".desc-inner") || desc;
      const toggle = card.querySelector(".read-more");

      // Ensure clamp class is present first to allow consistent measurement
      desc.classList.add("clamp");

      // Measure overflow after layout settled
      const isOverflowing = inner.scrollHeight > desc.clientHeight + 2; // small tolerance

      if (isOverflowing) {
        desc.classList.add("has-overflow");
        toggle.style.display = "inline-block";
        toggle.setAttribute("aria-expanded", "false");
      } else {
        // no overflow → don't show fade or toggle (keep text fully visible)
        desc.classList.remove("has-overflow");
        // optional: remove clamp so layout isn't artificially limited (keeps it natural)
        desc.classList.remove("clamp");
        toggle.style.display = "none";
      }

      // Toggle behavior — prevent card navigation
      toggle.onclick = function (e) {
        e.preventDefault();
        e.stopPropagation(); // prevent anchor click bubbling
        const expanded = desc.classList.toggle("expanded");
        // When expanded, remove clamp (so it displays fully); when collapsed, reapply clamp
        if (expanded) {
          desc.classList.remove("clamp");
          desc.classList.add("expanded");
          toggle.textContent = "Read Less";
          toggle.setAttribute("aria-expanded", "true");
        } else {
          desc.classList.remove("expanded");
          // if it originally had overflow, reapply clamp
          if (desc.classList.contains("has-overflow")) desc.classList.add("clamp");
          toggle.textContent = "Read More";
          toggle.setAttribute("aria-expanded", "false");
        }
      };
    });
  }

  // Run after everything loads (fonts/images) so measurements are accurate
  window.addEventListener("load", () => {
    // run once immediately after load
    setupReadMoreControls();
    // ensure re-check shortly after to catch any late layout shifts
    setTimeout(setupReadMoreControls, 200);
  });

  // Recalculate on resize (debounced)
  window.addEventListener("resize", debounce(() => {
    setupReadMoreControls();
  }, 160));
</script>

  <style>
    /* Reuse FAQ hero styles exactly */
    .faq-hero {
      background: linear-gradient(135deg, rgba(0,0,0,0.6), rgba(0,0,0,0.9)), #ff7300;
      color: #fff;
      padding: 4rem 1rem 2rem 1rem;
      text-align: center;
      position: relative;
      overflow: hidden;
    }

    @media (max-width: 768px) {
      .faq-hero {
        margin-top: -55px;
      }
    }

    .faq-hero-title {
      font-size: 2.5rem;
      font-weight: 900;
      margin-bottom: 1.5rem;
      font-family: 'Helvetica', sans-serif;
      color: #ffffff;
      text-shadow: 
        2px 2px 6px rgba(0,0,0,0.7),
        4px 4px 10px rgba(0,0,0,0.5);
      transform: translateY(0);
      transition: transform 0.2s ease-out;
    }

    .faq-search-wrapper {
      max-width: 500px;
      margin: 0 auto;
    }

    .faq-search-wrapper input {
      width: 100%;
      padding: 0.8rem 1rem;
      border-radius: 50px;
      border: none;
      font-size: 1rem;
      box-shadow: 0 2px 6px rgba(0,0,0,0.15);
      transition: box-shadow 0.3s ease, transform 0.2s ease;
    }

    .faq-search-wrapper input:focus {
      outline: none;
      box-shadow: 0 0 8px 2px #ff7300;
      transform: scale(1.02);
    }

    /* Blog Cards Section */
.blogs-section {
  padding: 2rem 0;
  background: #fff;
}

.blogs-list {
  display: grid;
  gap: 1rem;
  grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
  padding: 0 1rem;
}

/* BLOG CARD – DARK + BRAND SHADOW */
.blog-card {
  display: flex;
  flex-direction: column;
  border-radius: 12px;
  border: 2px solid #ff7300;
  overflow: hidden;
  text-decoration: none;
  color: #fff; 
  background: #121316; /* card black */
  backdrop-filter: blur(14px);
  -webkit-backdrop-filter: blur(14px);

  box-shadow:
    inset 0 1px 1px rgba(255, 255, 255, 0.35),
    0 10px 28px rgba(0, 0, 0, 0.35),
    0 0 12px rgba(255, 115, 0, 0.35);

  transition:
    transform 0.3s ease,
    box-shadow 0.3s ease,
    background 0.3s ease;
}

.blog-card:hover {
  transform: translateY(-5px) scale(1.02);
  box-shadow:
    inset 0 1px 1px rgba(255, 255, 255, 0.45),
    0 14px 35px rgba(0, 0, 0, 0.45),
    0 0 30px rgba(255, 115, 0, 1),
    0 0 60px rgba(255, 115, 0, 0.75);
}

/* Thumbnail */
.blog-thumb {
  width: 100%;
  height: 160px;
  object-fit: cover;
  transition: transform 0.3s ease;
}

.blog-card:hover .blog-thumb {
  transform: scale(1.05);
}

/* Content */
.blog-content {
  padding: 1rem;
   
}

.blog-content h2 {
  font-size: 1.5rem;
  margin-bottom: 0.5rem;
  font-weight: bold;
  color: #ff7300;
}

/* AUTHOR BLOCK INSIDE BLOG CARDS */
.blog-author-block {
  display: flex;
  align-items: center;
  gap: 0.6rem;
  margin: 0.6rem 0 0.4rem 0;
}

.blog-author-thumb {
  width: 38px;
  height: 38px;
  object-fit: cover;
  flex-shrink: 0;
  background: #fff;
  padding: 6px;
}

.blog-author-text {
  display: flex;
  flex-direction: column;
  line-height: 1.1;
}

.blog-author-name {
  font-size: 0.95rem;
  font-weight: 700;
  color: #fff;;
}

.blog-author-date {
  font-size: 0.8rem;
  color: #fff;
}

/* DESCRIPTION BASE */
.blog-description {
  line-height: 1.5em;
  font-size: 1rem;
  margin: 0.5rem 0;
  position: relative;
  max-height: none;
  overflow: visible;
  color: #fff;
  transition: max-height 0.3s ease;
}

/* CLAMP */
.blog-description.clamp {
  max-height: calc(1.5em * 5);
  overflow: hidden;
}

/* DARK FADE OVERLAY */
.blog-description.clamp.has-overflow::after {
  content: "";
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 2.2em;
  background: linear-gradient(
  to bottom,
  rgba(18, 19, 22, 0),
  rgba(18, 19, 22, 0.65),
  #121316
);
  pointer-events: none;
}

/* EXPANDED STATE */
.blog-description.expanded {
  max-height: none;
  overflow: visible;
}
.blog-description.expanded::after {
  display: none;
}

.desc-inner {
  line-height: 1.5em;
  color: #fff;
}

/* READ MORE */
.read-more {
  display: inline-block;
  color: #ff7300; /* brand */
  font-weight: 700;
  cursor: pointer;
  font-size: 0.9rem;
  margin-top: 0.4rem;
  user-select: none;
}

.journal-intro {
  text-align: left;
  margin-top: 1rem;
}

.journal-intro p {
  color: #333;
}

.blog-categories {
  padding: 1rem;
}

.categories-grid {
  display: flex;
  gap: 0.6rem;
  flex-wrap: wrap;
  padding: 1rem 1rem;
}

.category-btn {
  padding: 8px 14px;
  border-radius: 20px;
  border: 2px solid #ff7300;
  background: transparent;
  color: #ff7300;
  font-weight: 600;
  cursor: pointer;
  background: rgba(0, 0, 0, 0.75);
backdrop-filter: blur(15px);
-webkit-backdrop-filter: blur(15px);


  box-shadow:
    inset 0 1px 1px rgba(255,255,255,0.35),
    0 6px 14px rgba(0,0,0,0.35),
    0 0 10px rgba(255,115,0,0.3);

  transition: all 0.25s ease;
  position: relative;
}

.category-btn::before {
  content: "";
  position: absolute;
  inset: 0;
  border-radius: inherit;
  background: linear-gradient(
    135deg,
    rgba(255,255,255,0.45),
    rgba(255,255,255,0.05)
  );
  opacity: 0.35;
  pointer-events: none;
}

.category-btn:hover,
.category-btn.active {
  background: #ff7300;
  color: #000;
  box-shadow:
    inset 0 1px 1px rgba(255,255,255,0.45),
    0 10px 24px rgba(0,0,0,0.4),
    0 0 18px rgba(255,115,0,1),
    0 0 36px rgba(255,115,0,0.7);
}

.blog-category {
  display: inline-block;
  font-size: 0.75rem;
  font-weight: 700;
  color: #000;
  background: #ff7300;
  padding: 4px 8px;
  border-radius: 6px;
  margin-bottom: 6px;
}

.categories-title {
  font-size: 2.5rem;
  font-family: 'Helvetica', sans-serif;
  color: black;
}

.categories-title span,
.faq-preview span {
  color: #ff7300;
  border-bottom: 4px solid #ff7300;
  padding-bottom: 2px;
  display: inline-block;
}

.faq-preview {
  text-align: left;
  margin-bottom: 1rem;
}

.faq-preview h2 {
  font-size: 2.5rem;
  font-family: 'Helvetica', sans-serif;
  color: black;
  margin-bottom: 0.5rem;
}

.faq-preview p {
  color: #333;
}

.faq-btn {
  display: inline-block;
  padding: 10px 18px;
  color: #ff7300;
  border-radius: 8px;
  font-weight: bold;
  text-decoration: none;

  background: rgba(0, 0, 0, 0.75);
backdrop-filter: blur(15px);
-webkit-backdrop-filter: blur(15px);


  box-shadow:
    inset 0 1px 1px rgba(255,255,255,0.35),
    0 6px 14px rgba(0,0,0,0.35),
    0 0 10px rgba(255,115,0,0.3);

  transition: all 0.25s ease;
  position: relative;
}

.faq-btn::before {
  content: "";
  position: absolute;
  inset: 0;
  border-radius: inherit;
  background: linear-gradient(
    135deg,
    rgba(255,255,255,0.45),
    rgba(255,255,255,0.05)
  );
  opacity: 0.35;
  pointer-events: none;
}

.faq-btn:hover {
  background: #ff7300;
  color: #000;
  transform: scale(1.05);

  box-shadow:
    inset 0 1px 1px rgba(255,255,255,0.45),
    0 12px 28px rgba(0,0,0,0.45),
    0 0 22px rgba(255,115,0,1),
    0 0 42px rgba(255,115,0,0.7);
}

  </style>
</Layout>

<script>
const categoryButtons = document.querySelectorAll(".category-btn");

categoryButtons.forEach(btn => {
  btn.addEventListener("click", () => {

    // Active state
    categoryButtons.forEach(b => b.classList.remove("active"));
    btn.classList.add("active");

    const selected = btn.getAttribute("data-category");

    document.querySelectorAll(".blog-card").forEach(card => {
      const category = card.getAttribute("data-category");

      if (selected === "all" || category === selected) {
        card.style.display = "flex";
      } else {
        card.style.display = "none";
      }
    });

  });
});
</script>