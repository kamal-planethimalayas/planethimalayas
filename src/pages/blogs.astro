---
import Layout from "../layouts/Layout.astro";
import { blogs } from "../data/blogsData.js";

const category = Astro.url.searchParams.get("category");

const filteredBlogs = category
  ? blogs.filter(
      b => b.category.toLowerCase().trim() === category.toLowerCase().trim()
    )
  : blogs;
---

<Layout>
  <!-- BLOG HERO (same as FAQ hero) -->
  <section class="faq-hero reveal">
    <div class="container">
      <h1 class="faq-hero-title">Journal</h1>
      <div class="faq-search-wrapper">
        <input
          id="blog-search"
          type="text"
          placeholder="Search topics like fitness, packing, AMS..."
        />
      </div>
    </div>
  </section>

  <section class="journal-intro">
  <div class="container">
    <p>
      Explore detailed trekking guides, fitness tips, packing checklists, and real Himalayan experiences. 
      Whether you're preparing for your first trek or planning a high-altitude expedition, our journal 
      helps you make informed decisions and trek with confidence.
    </p>
  </div>
</section>

<section class="blog-categories">
<h2 class="categories-title">Browse by <span>category</span></h2>
  <div class="container categories-grid">
    
    <button class="category-btn active" data-category="all">All</button>
    <button class="category-btn" data-category="Trek Guides">Trek Guides</button>
    <button class="category-btn" data-category="Preparation Tips">Preparation Tips</button>
    <button class="category-btn" data-category="Gear & Logistics">Gear & Logistics</button>
    <button class="category-btn" data-category="Health & Wellness">Health & Wellness</button>
    <button class="category-btn" data-category="Stories">Stories</button>

  </div>
</section>

 <!-- Blog Cards Section -->
<section class="blogs-section">
  <div class="container blogs-list">
    {filteredBlogs.map((blog, index) => (
      <a 
        href={`/blogs/${blog.slug}`} 
        class="blog-card" 
        target="_blank" 
        rel="noopener noreferrer"
        key={index}
        data-category={blog.category}
        data-search={`${blog.slug} ${blog.tags.join(" ")} ${blog.content}`}
      >
        <img src={blog.thumbnail} alt={blog.title} />

        <div class="blog-content">
          <span class="blog-category">{blog.category}</span>

          <h2>{blog.title}</h2>

          <!-- AUTHOR (TEXT ONLY) -->
          <div class="blog-author-block">
            <div class="blog-author-text">
              <span class="blog-author-name">{blog.author.name}</span>
              <span class="blog-author-date">{blog.date}</span>
            </div>
          </div>
        </div>

      </a>
    ))}
  </div>
</section>

<section class="faq-preview">
  <div class="container">
    <h2>Still have <span>questions before your trek?</span></h2>
    <p>
      From altitude sickness and fitness to packing and safety — find clear answers 
      to everything you need before heading to the Himalayas.
    </p>
    <a href="/faqs" class="faq-btn">Explore FAQs</a>
  </div>
</section>

  <style>
    /* Reuse FAQ hero styles exactly */
    .faq-hero {
      background: linear-gradient(135deg, rgba(0,0,0,0.6), rgba(0,0,0,0.9)), #ff7300;
      color: #fff;
      padding: 4rem 1rem 2rem 1rem;
      text-align: center;
      position: relative;
      overflow: hidden;
    }

    @media (max-width: 768px) {
      .faq-hero {
        margin-top: -55px;
      }
    }

    .faq-hero-title {
      font-size: 2.5rem;
      font-weight: 900;
      margin-bottom: 1.5rem;
      font-family: 'Helvetica', sans-serif;
      color: #ffffff;
      text-shadow: 
        2px 2px 6px rgba(0,0,0,0.7),
        4px 4px 10px rgba(0,0,0,0.5);
      transform: translateY(0);
      transition: transform 0.2s ease-out;
    }

    .faq-search-wrapper {
      max-width: 500px;
      margin: 0 auto;
    }

    .faq-search-wrapper input {
      width: 100%;
      padding: 0.8rem 1rem;
      border-radius: 50px;
      border: none;
      font-size: 1rem;
      box-shadow: 0 2px 6px rgba(0,0,0,0.15);
      transition: box-shadow 0.3s ease, transform 0.2s ease;
    }

    .faq-search-wrapper input:focus {
      outline: none;
      box-shadow: 0 0 8px 2px #ff7300;
      transform: scale(1.02);
    }

    /* Blog Cards Section */
.blogs-section {
  background: #fff;
}

.blogs-list {
  display: grid;
  gap: 1rem;

  /* FULL WIDTH UTILIZATION */
  grid-template-columns: repeat(4, 1fr);

  width: 100%;
  padding: 0 1.2rem;
}

/* smoother, less stiff animation */
@keyframes fadeInUp {
  from {
    opacity: 0;
    transform: translateY(16px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* BLOG CARD – CLEAN EDITORIAL STYLE */
.blog-card {
  display: flex;
  flex-direction: column;
  border-radius: 12px;
  border: 2px solid #ff7300;
  overflow: hidden;
  text-decoration: none;
  color: #fff; 
  background: #121316;

  box-shadow:
    0 10px 28px rgba(0, 0, 0, 0.35),
    0 0 12px rgba(255, 115, 0, 0.25);

  transition: transform 0.25s ease, box-shadow 0.25s ease;
}

.blog-card:hover {
  transform: translateY(-6px);
  box-shadow:
    0 16px 40px rgba(0, 0, 0, 0.5),
    0 0 25px rgba(255, 115, 0, 0.7);
}

/* IMAGE */
.blog-thumb {
  width: 100%;
  height: 140px;
  object-fit: cover;
}

/* CONTENT */
.blog-content {
  padding: 0.8rem;
}

/* CATEGORY */
.blog-category {
  font-size: 0.65rem;
  font-weight: 700;
  background: #ff7300;
  color: #000;
  padding: 3px 6px;
  border-radius: 5px;
  display: inline-block;
  margin-bottom: 6px;
}

/* TITLE */
.blog-content h2 {
  font-size: 1rem;
  line-height: 1.3;
  margin-bottom: 0.6rem;
  color: #ff7300;
}

/* AUTHOR */
.blog-author-block {
  display: flex;
  align-items: center;
  gap: 0.5rem;
}

.blog-author-name {
  font-size: 0.8rem;
  font-weight: 600;
}

.blog-author-date {
  font-size: 0.7rem;
  opacity: 0.7;
}

/* Tablet */
@media (max-width: 1024px) {
  .blogs-list {
    grid-template-columns: repeat(3, 1fr);
  }
}

/* Mobile */
@media (max-width: 768px) {
  .blogs-list {
    grid-template-columns: repeat(2, 1fr);
  }
}

/* Very small devices */
@media (max-width: 480px) {
  .blogs-list {
    grid-template-columns: repeat(2, 1fr);
    gap: 0.8rem;
  }
}

.journal-intro {
  text-align: left;
  margin-top: 1rem;
}

.journal-intro p {
  color: #333;
}

.blog-categories {
  padding: 1rem;
}

.categories-grid {
  display: flex;
  gap: 0.6rem;
  flex-wrap: wrap;
  padding: 1rem 1rem;
}

.category-btn {
  padding: 8px 14px;
  border-radius: 20px;
  border: 2px solid #ff7300;
  background: transparent;
  color: #ff7300;
  font-weight: 600;
  cursor: pointer;
  background: rgba(0, 0, 0, 0.75);
backdrop-filter: blur(15px);
-webkit-backdrop-filter: blur(15px);


  box-shadow:
    inset 0 1px 1px rgba(255,255,255,0.35),
    0 6px 14px rgba(0,0,0,0.35),
    0 0 10px rgba(255,115,0,0.3);

  transition: all 0.25s ease;
  position: relative;
}

.category-btn::before {
  content: "";
  position: absolute;
  inset: 0;
  border-radius: inherit;
  background: linear-gradient(
    135deg,
    rgba(255,255,255,0.45),
    rgba(255,255,255,0.05)
  );
  opacity: 0.35;
  pointer-events: none;
}

.category-btn:hover,
.category-btn.active {
  background: #ff7300;
  color: #000;
  box-shadow:
    inset 0 1px 1px rgba(255,255,255,0.45),
    0 10px 24px rgba(0,0,0,0.4),
    0 0 18px rgba(255,115,0,1),
    0 0 36px rgba(255,115,0,0.7);
}

.blog-category {
  display: inline-block;
  font-size: 0.75rem;
  font-weight: 700;
  color: #000;
  background: #ff7300;
  padding: 4px 8px;
  border-radius: 6px;
  margin-bottom: 6px;
}

.categories-title {
  font-size: 2.5rem;
  font-family: 'Helvetica', sans-serif;
  color: black;
}

.categories-title span,
.faq-preview span {
  color: #ff7300;
  border-bottom: 4px solid #ff7300;
  padding-bottom: 2px;
  display: inline-block;
}

.faq-preview {
  text-align: left;
  margin-bottom: 1rem;
}

.faq-preview h2 {
  font-size: 2.5rem;
  font-family: 'Helvetica', sans-serif;
  color: black;
  margin-bottom: 0.5rem;
}

.faq-preview p {
  color: #333;
}

.faq-btn {
  display: inline-block;
  padding: 10px 18px;
  color: #ff7300;
  border-radius: 8px;
  font-weight: bold;
  text-decoration: none;

  background: rgba(0, 0, 0, 0.75);
backdrop-filter: blur(15px);
-webkit-backdrop-filter: blur(15px);


  box-shadow:
    inset 0 1px 1px rgba(255,255,255,0.35),
    0 6px 14px rgba(0,0,0,0.35),
    0 0 10px rgba(255,115,0,0.3);

  transition: all 0.25s ease;
  position: relative;
}

.faq-btn::before {
  content: "";
  position: absolute;
  inset: 0;
  border-radius: inherit;
  background: linear-gradient(
    135deg,
    rgba(255,255,255,0.45),
    rgba(255,255,255,0.05)
  );
  opacity: 0.35;
  pointer-events: none;
}

.faq-btn:hover {
  background: #ff7300;
  color: #000;
  transform: scale(1.05);

  box-shadow:
    inset 0 1px 1px rgba(255,255,255,0.45),
    0 12px 28px rgba(0,0,0,0.45),
    0 0 22px rgba(255,115,0,1),
    0 0 42px rgba(255,115,0,0.7);
}

#blog-search {
  transition: opacity 0.2s ease;
}

  </style>
</Layout>

<script>
  const searchInput = document.getElementById("blog-search");
  const blogCards = document.querySelectorAll(".blog-card");

  searchInput.addEventListener("input", () => {
    const value = searchInput.value.toLowerCase();

    blogCards.forEach(card => {
      // Read visible text
      const text = card.textContent.toLowerCase();

      // Read extra search data (slug, tags, content)
      const extra = card.getAttribute("data-search")?.toLowerCase() || "";

      // Match against both visible text + hidden data
      const haystack = text + " " + extra;

      card.style.display = haystack.includes(value) ? "flex" : "none";
    });
  });

  // Parallax effect (kept same)
  const heroTitle = document.querySelector(".faq-hero-title");
  window.addEventListener("scroll", () => {
    const scrollY = window.scrollY;
    heroTitle.style.transform = `translateY(${scrollY * 0.3}px)`;
  });
</script>

<script>
const categoryButtons = document.querySelectorAll(".category-btn");

categoryButtons.forEach(btn => {
  btn.addEventListener("click", () => {

    // Active state
    categoryButtons.forEach(b => b.classList.remove("active"));
    btn.classList.add("active");

    const selected = btn.getAttribute("data-category");

    document.querySelectorAll(".blog-card").forEach(card => {
      const category = card.getAttribute("data-category");

      if (selected === "all" || category === selected) {
        card.style.display = "flex";
      } else {
        card.style.display = "none";
      }
    });

  });
});
</script>

<script>
const blogSearchInput = document.getElementById("blog-search");

const blogPlaceholders = [
  "Search articles, guides...",
  "Explore fitness, packing, altitude...",
  "Looking for beginner trekking tips?",
  "Find stories from the Himalayas..."
];

let blogIndex = 0;
let blogInterval;

// Start rotating on focus
blogSearchInput.addEventListener("focus", () => {
  blogInterval = setInterval(() => {

    setTimeout(() => {
      blogIndex = (blogIndex + 1) % blogPlaceholders.length;
      blogSearchInput.setAttribute("placeholder", blogPlaceholders[blogIndex]);
      blogSearchInput.style.opacity = 1;
    }, 200);

  }, 2000);
});

// Stop when user leaves
blogSearchInput.addEventListener("blur", () => {
  clearInterval(blogInterval);
});
</script>

<script>
const urlParams = new URLSearchParams(window.location.search);
const activeCategory = urlParams.get("category");

if (activeCategory) {
  const buttons = document.querySelectorAll(".category-btn");

  buttons.forEach(btn => {
    const btnCategory = btn.getAttribute("data-category");

    if (btnCategory === activeCategory) {
      btn.classList.add("active");
    } else {
      btn.classList.remove("active");
    }
  });

  document.querySelectorAll(".blog-card").forEach(card => {
    const cardCategory = card.getAttribute("data-category");

    if (cardCategory === activeCategory) {
      card.style.display = "flex";
    } else {
      card.style.display = "none";
    }
  });
}
</script>