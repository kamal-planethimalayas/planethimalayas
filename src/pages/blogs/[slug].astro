---
import Layout from "../../layouts/Layout.astro";
import { blogs } from "../../data/blogsData.js";
import { treks } from '../../data/treksData.js';
import { supabase } from "../../lib/supabaseClient.js";
import BlogInteractions from "../../components/BlogInteractions.jsx";
import ShareButtons from "../../components/ShareButtons.jsx";

// -------------------
// DYNAMIC ROUTING
// -------------------

export async function getStaticPaths() {
  return blogs.map(blog => ({
    params: { slug: blog.slug }
  }));
}

// -------------------
// GET SLUG & BLOG
// -------------------
const { slug } = Astro.params;
const blog = blogs.find(b => b.slug === slug);
if (!blog) throw new Error("Blog not found");

// -------------------
// FETCH INITIAL INTERACTIONS
// -------------------
let likes = 0;
let dislikes = 0;
let comments = [];

const { data } = await supabase
  .from("blog_interactions")
  .select("*")
  .eq("blog_slug", slug)
  .single();

if (data) {
  likes = data.likes;
  dislikes = data.dislikes;
  comments = data.comments || [];
}

const currentSlug = Astro.params.slug;

// find current blog
const currentBlog = blogs.find(b => b.slug === currentSlug);

// filter similar category blogs (excluding current)
const relatedBlogs = blogs.filter(
  b => b.category === currentBlog.category && b.slug !== currentSlug
);

const seasonOfBlog = currentBlog.season || "spring"; // adjust if needed

const upcomingTrekCards = treks
  .filter(t => t.season?.includes(seasonOfBlog)) // make sure 'season' exists
  .slice(0, 5); 
---

<Layout>
  {blog.thumbnail && (
    <div class="blog-hero reveal">
      <img src={blog.thumbnail} alt={blog.title} />
      <h1 class="hero-title">{blog.title}</h1>
    </div>
  )}

<div class="blog-layout">

  <!-- LEFT: MAIN CONTENT -->
  <div class="blog-main">

    <!-- Share Buttons -->
    <div class="blog-share">
      <ShareButtons pageUrl={Astro.request.url} pageTitle={blog.title} />
    </div>

    <article class="blog-content">
      <div set:html={blog.content}></div>
    </article>

    <!-- AUTHOR BLOCK -->
    <div class="meta">
      <img 
        src={(blog.author && blog.author.thumbnail) || "/images/main/brand-logo.png"} 
        alt={(blog.author && blog.author.name) || "PH In-House Team"} 
      />

      <div class="author-info">
        <div class="author-name">
          {(blog.author && blog.author.name) || "PH In-House Team"}
        </div>

        <div class="author-designation">
          {(blog.author && blog.author.designation) || "Editorial Team, Planethimalayas"}
        </div>

        <p class="author-bio">
          {(blog.author && blog.author.bio) || "The PH In-House Team is the core editorial and operations group at Planethimalayas—made up of trek leaders, route planners, and on-ground experts with deep experience across the Himalayas."}
        </p>

        {(blog.author && blog.author.socials && blog.author.socials.linkedin) && (
          <a 
            href={blog.author.socials.linkedin} 
            target="_blank"
            rel="noopener noreferrer"
            class="author-linkedin"
          >
            LinkedIn Profile →
          </a>
        )}
      </div>
    </div>

    <!-- INTERACTIONS -->
    <BlogInteractions
      client:load
      slug={slug}
      initialLikes={likes}
      initialDislikes={dislikes}
      initialComments={comments}
    />

  </div> <!-- end .blog-main -->

  <!-- RIGHT: SIDEBAR (30%) -->
  <aside class="blog-sidebar">
    
    <!-- 🏔️ Upcoming Treks -->
    <div class="sidebar-upcoming-treks">
      <h3>Trending Treks</h3>
      {treks
        .filter(
          trek => Array.isArray(trek.season) && trek.season.map(s => s.toLowerCase()).includes('spring')
        )
        .slice(0, 5)
        .map(trek => {
          const duration = trek.overview?.facts?.find(f => f.label === "Trek Duration")?.value || trek.duration;
          const difficultyStr = Array.isArray(trek.difficulty) ? trek.difficulty.join(', ') : trek.difficulty;

          const capitalize = str => {
            if (!str) return '';
            if (Array.isArray(str)) return str.map(capitalize).join(', ');
            return str
              .split(' ')
              .map(word => word.charAt(0).toUpperCase() + word.slice(1))
              .join(' ');
          };

          return (
            <div class="sidebar-trek-card" key={trek.id}>
              <a href={`/trek/${trek.id}#trek-hero`}>
                <img src={trek.heroImage} alt={`View of ${trek.name} trek`} />
              </a>
              <h4 class="trek-name">{trek.name}</h4>
              <div class="trek-info">
                <span>{capitalize(difficultyStr)}</span>
                <span>{duration}</span>
              </div>
              <a href={`/trek/${trek.id}#pricing-snippet-wrapper`} class="btn btn-dates">
                View Dates
              </a>
            </div>
          );
        })}
      <a href={`/upcoming-treks?season=spring`} class="more-treks-cta">
        More Upcoming Treks →
      </a>
    </div>

    <!-- 📚 Related Blogs -->
    <section class="sidebar-related-blogs">
      <h3>Related Blogs</h3>
      <div class="sidebar-blogs">
        {relatedBlogs.slice(0,5).map((b, i) => (
          <a href={`/blogs/${b.slug}`} class="sidebar-blog-card" key={i}>
            <img src={b.thumbnail} alt={b.title} />
            <div class="blog-title">{b.title}</div>
          </a>
        ))}
      </div>
      <a href={`/blogs?category=${encodeURIComponent(currentBlog.category)}`} class="sidebar-cta">
        More Related Blogs →
      </a>
    </section>

  </aside>

</div> <!-- end .blog-layout -->

</Layout>

<style>
/* Reuse your hero & content CSS... */
  /* 🔥 Hero Section */
  .blog-hero {
  position: relative;
  width: 100%;

  /* 🔥 KEY CHANGE */
  height: 60vh;
  overflow: hidden;
  margin: 0;
  padding: 0;

  display: flex;
  justify-content: center;
  align-items: flex-end; /* pushes content down naturally */

  background-color: #000;
  background-size: cover;
  background-position: center;
}

/* IMAGE */
.blog-hero img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center;
  display: block;
}

  /* ✅ Title overlay */
.hero-title {
  position: absolute;
  bottom: 20%;
  left: 50%;
  transform: translateX(-50%);
  color: white;
  font-size: clamp(1.8rem, 4vw, 2.8rem);
  font-weight: bold;
  text-align: center;
  width: 100%;         /* ✅ full width inside hero */
  padding: 0 2rem;     /* ✅ keeps safe margin */
  line-height: 1.3;    /* ✅ more breathing space */
  white-space: normal;
  word-wrap: break-word;
  text-shadow: 3px 3px 8px rgba(0,0,0,0.95);
}

/* 📱 Mobile */
@media (max-width: 768px) {
  .hero-title {
    bottom: 15%;
    font-size: 1.9rem;   /* ✅ slightly bigger */
    padding: 0 1.5rem;  /* ✅ margin from sides */
    line-height: 1.4;   /* ✅ relaxed spacing */
  }
}

/* ============================
   MAIN BLOG LAYOUT
============================ */
.blog-layout {
  display: flex;
  gap: 2rem;
  max-width: 1200px;
  box-sizing: border-box;
  flex-wrap: nowrap;
}

.blog-main {
  flex: 0 0 70%;
  min-width: 700px;
}

/* =========================
   SIDEBAR SECTIONS
========================= */
.blog-sidebar {
  flex: 0 0 30%;
  min-width: 500px;
  display: flex;
  flex-direction: column;
  gap: 2rem;
  position: sticky;
  top: 120px;
  align-items: center;
}

/* ------------------------
   HEADINGS
------------------------- */
.sidebar-upcoming-treks h3,
.sidebar-related-blogs h3 {
  font-family: 'Helvetica', sans-serif;
  font-weight: bold;
  font-size: 1.5rem;
  margin-bottom: 1rem;
  color: #333;
  border-bottom: 3px solid #ff7300; /* brand underline */
  padding-bottom: 0.25rem;
}

/* =========================
   TREK CARDS
========================= */
.sidebar-upcoming-treks {
  display: flex;
  flex-direction: column;
  gap: 0.5rem;       /* breathing space between trek cards */
  padding-top: 2rem;
}

.sidebar-trek-card {
  display: flex;
  flex-direction: column;
  align-items: stretch;
  width: 100%;
  max-width: 220px;          /* uniform width */
  height: 260px;             /* uniform height */
  background: #fff;
  border-radius: 10px;
  overflow: hidden;
  box-shadow: 0 4px 16px rgba(0,0,0,0.08);
  transition: transform 0.25s ease, box-shadow 0.25s ease;
  padding: 0.5rem;
}

.sidebar-trek-card img {
  width: 100%;
  height: 120px;
  object-fit: cover;
  border-radius: 8px;
  margin-bottom: 0.5rem;
}

.sidebar-trek-card h4.trek-name {
  font-size: 0.95rem;
  font-weight: 600;
  color: #333;
  margin-bottom: 0.25rem;
  text-align: center;
}

.sidebar-trek-card .trek-info {
  display: flex;
  justify-content: center;
  gap: 1rem;
  font-size: 0.85rem;
  color: #555;
  margin-bottom: 0.5rem;
}

.sidebar-trek-card .btn-dates {
  display: inline-block;
  font-size: 0.825rem;
  font-weight: 600;
  color: #fff;
  background-color: #ff7300;
  padding: 0.3rem 0.6rem;
  border-radius: 6px;
  text-align: center;
  text-decoration: none;
  transition: opacity 0.2s ease;
}

.sidebar-trek-card .btn-dates:hover {
  opacity: 0.85;
}

.sidebar-upcoming-treks .more-treks-cta {
  font-size: 0.9rem;
  font-weight: 700;
  color: #ff7300;
  text-decoration: none;
  text-align: center;
}

.sidebar-upcoming-treks .more-treks-cta:hover {
  text-decoration: underline;
}

/* =========================
   RELATED BLOG CARDS
========================= */
.sidebar-related-blogs {
  display: flex;
  flex-direction: column;
  padding-top: 2rem;
  align-items: stretch;
}

.sidebar-blogs {
  display: flex;
  flex-direction: column;
  gap: 0.5rem;   /* THIS is the real spacing */
}

.sidebar-blog-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 100%;
  max-width: 220px;       /* uniform width */
  height: 220px;          /* uniform height */
  background: #fff;
  border-radius: 10px;
  overflow: hidden;
  box-shadow: 0 4px 16px rgba(0,0,0,0.08);
  transition: transform 0.25s ease, box-shadow 0.25s ease;
  text-decoration: none;
  padding: 0.4rem;
}

.sidebar-blog-card img {
  width: 100%;
  height: 120px;
  object-fit: cover;
  border-radius: 8px;
  margin-bottom: 0.5rem;
}

.sidebar-blog-card .blog-title {
  font-size: 0.95rem;
  font-weight: 600;
  color: #333;
  text-align: center;
  line-height: 1.3;
}

.sidebar-related-blogs .sidebar-cta {
  font-size: 0.9rem;
  font-weight: 700;
  color: #ff7300;
  text-decoration: none;
  text-align: center;
  margin-top: 0.75rem;
}

.sidebar-related-blogs .sidebar-cta:hover {
  text-decoration: underline;
}

/* =========================
   HOVER EFFECTS
========================= */
@media (hover: hover) {
  .sidebar-trek-card:hover,
  .sidebar-blog-card:hover {
    transform: scale(1.02);
    box-shadow: 0 8px 28px rgba(0,0,0,0.12);
  }
}

/* =========================
   RESPONSIVE MOBILE FIX
========================= */
@media (max-width: 1024px) {
  .blog-layout {  
    flex-direction: column;
    padding: 0 1rem;       /* padding on both sides */
  }

  .blog-main,
  .blog-sidebar {
    flex: 1 1 100%;
    min-width: 0;          /* prevent overflow */
  }

  .blog-sidebar {
    margin-top: 2rem;
    align-items: stretch;   /* center the cards */
  }

  .sidebar-trek-card,
  .sidebar-blog-card {
    max-width: 100%;       /* stretch full width */
    width: 100%;
    align-items: stretch;
  }
}

/* 🔥 STICKY SHARE (THE MAGIC) */
.blog-share {
  position: sticky;
  top: -15px; /* adjust to your navbar height */

  z-index: 10;

  /* layout */
  display: flex;
  justify-content: flex-start;
    height: fit-content;
  margin-bottom: 1rem;

  /* Subtle overlay */
  background: white;
  backdrop-filter: blur(2px);             /* slight blur for soft separation */
  -webkit-backdrop-filter: blur(2px);     /* Safari support */
  border-radius: 8px;                     /* rounded corners for smooth feel */
  padding: 0.25rem 0.5rem;                /* tiny padding inside wrapper */
}

  /* 🔥 Blog Content */
  .blog-content {
    padding: 0 2rem;
    text-align: left;
    font-size: 1.125rem;
    line-height: 1.7;
    margin-bottom: 2rem;
  }

  /* ============================
   🖼️ BLOG INLINE IMAGE CONTROL
============================ */
:global(.blog-content img) {
  max-width: 720px;        /* 👈 controls visual width */
  width: 100%;
  max-height: 420px;       /* 👈 prevents tall images */
  object-fit: cover;

  display: block;
  margin: 2rem auto;       /* centers + spacing */

  border-radius: 12px;
  box-shadow: 0 10px 30px rgba(0,0,0,0.08);
}

  .meta {
    color: gray;
    font-size: 0.95rem;
    margin-bottom: 2rem;
  }

  @media (max-width: 768px) {
  .blog-hero {
    height: 45vh; /* taller hero for mobile */
    margin-top: -55px;
  }

  .hero-title {
    bottom: 15%;
    font-size: clamp(1.6rem, 5vw, 2.8rem); /* ✅ no cramp */
    line-height: 1.3;
    max-width: 95%; /* ✅ use more space */
    padding: 0 1rem;
  }

  .blog-content {
    font-size: 1rem;
    padding: 0 1rem;
  }

  :global(.blog-content img) {
    max-width: 100%;
    max-height: 300px;
    margin: 1.5rem auto;
  }
}

/* ============================
   🏔️ TREK CARD LAYOUT
============================ */
.blog-content .trek-card {
  display: flex;
  align-items: flex-start;
  gap: 1.5rem;

  margin: 1.5rem 0;
}

.blog-content .trek-card img {
  width: 240px;          /* 👈 controls size */
  height: 160px;
  object-fit: cover;

  border-radius: 12px;
  flex-shrink: 0;

  margin: 0;             /* 👈 override blog image margin */
  box-shadow: 0 8px 24px rgba(0,0,0,0.08);
}

.blog-content .trek-card ul {
  margin: 0;
  padding-left: 1rem;
  font-size: 0.95rem;
  line-height: 1.6;
}

.blog-content .trek-card li {
  margin-bottom: 0.35rem;
}

@media (max-width: 768px) {
  .blog-content .trek-card {
    flex-direction: column;
  }

  .blog-content .trek-card img {
    width: 100%;
    height: 200px;
  }
}

/* ============================
   🔥 AUTHOR BLOCK ONLY
============================ */
.meta {
  display: flex;
  align-items: flex-start;
  gap: 1rem;

  background: #fff7f0;
  padding: 1.25rem;
  border-radius: 12px;

  margin-bottom: 2rem;
  color: #333;
}

.meta img {
  width: 64px;
  height: 64px;
  object-fit: cover;
  flex-shrink: 0;
  padding: 6px;
}

.author-info {
  display: flex;
  flex-direction: column;
  gap: 0.25rem;
}

.author-name {
  font-size: 1.15rem;
  font-weight: 700;
  color: #000;
}

.author-designation {
  font-size: 0.95rem;
    font-weight: 700;

  color: #555;
}

.author-bio {
  margin-top: 0.35rem;
  font-size: 0.95rem;
  color: #444;
  line-height: 1.5;
}

.author-linkedin {
  margin-top: 0.4rem;
  font-size: 0.9rem;
  font-weight: 600;
  color: #ff7300;
  text-decoration: none;
}

.author-linkedin:hover {
  text-decoration: underline;
  opacity: 0.9;
}

.author-date {
  margin-top: 0.4rem;
  font-size: 0.9rem;
  color: #666;
}

/* Mobile */
@media (max-width: 768px) {
  .meta {
    padding: 1rem;
    gap: 0.75rem;
  }

  .meta img {
    width: 56px;
    height: 56px;
  }

  .author-bio {
    font-size: 0.9rem;
  }
}


</style>
