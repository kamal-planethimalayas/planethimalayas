---
import Layout from "../../layouts/Layout.astro";
import { blogs } from "../../data/blogsData.js";
import { supabase } from "../../lib/supabaseClient.js";
import BlogInteractions from "../../components/BlogInteractions.jsx";
import ShareButtons from "../../components/ShareButtons.jsx";

// -------------------
// DYNAMIC ROUTING
// -------------------
export async function getStaticPaths() {
  return blogs.map(blog => ({
    params: { slug: blog.slug }
  }));
}

// -------------------
// GET SLUG & BLOG
// -------------------
const { slug } = Astro.params;
const blog = blogs.find(b => b.slug === slug);
if (!blog) throw new Error("Blog not found");

// -------------------
// FETCH INITIAL INTERACTIONS
// -------------------
let likes = 0;
let dislikes = 0;
let comments = [];

const { data } = await supabase
  .from("blog_interactions")
  .select("*")
  .eq("blog_slug", slug)
  .single();

if (data) {
  likes = data.likes;
  dislikes = data.dislikes;
  comments = data.comments || [];
}
---

<Layout>
  {blog.thumbnail && (
    <div class="blog-hero reveal">
      <img src={blog.thumbnail} alt={blog.title} />
      <h1 class="hero-title">{blog.title}</h1>
    </div>
  )}

  <!-- Top Share Buttons -->
  <ShareButtons pageUrl={Astro.request.url} pageTitle={blog.title} />

  <article class="blog-content">

    <!-- 🔥 BLOG MAIN CONTENT -->
    <div set:html={blog.content}></div>
  </article>

  <!-- 🔥 AUTHOR BLOCK (new) -->
    <div class="meta">
      <img src={blog.author.thumbnail} alt={blog.author.name} />

      <div class="author-info">
        <div class="author-name">{blog.author.name}</div>
        <div class="author-designation">{blog.author.designation}</div>
        <p class="author-bio">{blog.author.bio}</p>

        {blog.author.socials?.linkedin && (
          <a 
            href={blog.author.socials.linkedin} 
            target="_blank"
            rel="noopener noreferrer"
            class="author-linkedin"
          >
            LinkedIn Profile →
          </a>
        )}
      </div>
    </div>
    <!-- END AUTHOR BLOCK -->

  <!-- Blog Interactions -->
  <BlogInteractions
    client:load
    slug={slug}
    initialLikes={likes}
    initialDislikes={dislikes}
    initialComments={comments}
  />

  <!-- Bottom Share Buttons -->
  <ShareButtons pageUrl={Astro.request.url} pageTitle={blog.title} />
</Layout>

<style>
/* Reuse your hero & content CSS... */
  /* 🔥 Hero Section */
  .blog-hero {
    position: relative;
  width: 100%;
  height: 100vh; 
  overflow: hidden;
  margin: 0;
  padding: 0;
  display: flex;
  justify-content: center;
  align-items: center;
  background-color: white;
  background-size: cover;
  background-position: center;
  }

  .blog-hero img {
    width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center;
  display: block;
  }

  /* ✅ Title overlay */
.hero-title {
  position: absolute;
  bottom: 20%;
  left: 50%;
  transform: translateX(-50%);
  color: white;
  font-size: clamp(1.8rem, 4vw, 2.8rem);
  font-weight: bold;
  text-align: center;
  width: 100%;         /* ✅ full width inside hero */
  padding: 0 2rem;     /* ✅ keeps safe margin */
  line-height: 1.3;    /* ✅ more breathing space */
  white-space: normal;
  word-wrap: break-word;
  text-shadow: 3px 3px 8px rgba(0,0,0,0.95);
}

/* 📱 Mobile */
@media (max-width: 768px) {
  .hero-title {
    bottom: 15%;
    font-size: 1.9rem;   /* ✅ slightly bigger */
    padding: 0 1.5rem;  /* ✅ margin from sides */
    line-height: 1.4;   /* ✅ relaxed spacing */
  }
}


  /* 🔥 Blog Content */
  .blog-content {
    padding: 0 2rem;
    text-align: left;
    font-size: 1.125rem;
    line-height: 1.7;
    margin-bottom: 2rem;
  }

  .meta {
    color: gray;
    font-size: 0.95rem;
    margin-bottom: 2rem;
  }

  @media (max-width: 768px) {
  .blog-hero {
    height: 70vh; /* taller hero for mobile */
    margin-top: -55px;
  }

  .hero-title {
    bottom: 15%;
    font-size: clamp(1.6rem, 5vw, 2.8rem); /* ✅ no cramp */
    line-height: 1.3;
    max-width: 95%; /* ✅ use more space */
    padding: 0 1rem;
  }

  .blog-content {
    font-size: 1rem;
    padding: 0 1rem;
  }
}

/* ============================
   🔥 AUTHOR BLOCK ONLY
============================ */
.meta {
  display: flex;
  align-items: flex-start;
  gap: 1rem;

  background: #fff7f0;
  padding: 1.25rem;
  border-radius: 12px;

  margin-bottom: 2rem;
  color: #333;
}

.meta img {
  width: 64px;
  height: 64px;
  border-radius: 50%;
  object-fit: cover;
  flex-shrink: 0;
  border: 2px solid #ff7300;
}

.author-info {
  display: flex;
  flex-direction: column;
  gap: 0.25rem;
}

.author-name {
  font-size: 1.15rem;
  font-weight: 700;
  color: #000;
}

.author-designation {
  font-size: 0.95rem;
  color: #555;
}

.author-bio {
  margin-top: 0.35rem;
  font-size: 0.95rem;
  color: #444;
  line-height: 1.5;
}

.author-linkedin {
  margin-top: 0.4rem;
  font-size: 0.9rem;
  font-weight: 600;
  color: #ff7300;
  text-decoration: none;
}

.author-linkedin:hover {
  text-decoration: underline;
  opacity: 0.9;
}

.author-date {
  margin-top: 0.4rem;
  font-size: 0.9rem;
  color: #666;
}

/* Mobile */
@media (max-width: 768px) {
  .meta {
    padding: 1rem;
    gap: 0.75rem;
  }

  .meta img {
    width: 56px;
    height: 56px;
  }

  .author-bio {
    font-size: 0.9rem;
  }
}


/* 🔹 Interaction Bar */
.interaction-bar {
  display: flex;
  flex-direction: column; /* stack for mobile first */
  background: transparent; 
}

/* 🔹 Button Group */
.interaction-group {
  display: flex;
  align-items: center;
  gap: 0.75rem;
  position: relative;
  flex-wrap: wrap;
}

/* 🔹 Buttons - uniform size */
.interaction-btn {
  background: transparent;
  border: 2px solid #ff7300;
  color: #ff7300;
  padding: 10px 18px;
  border-radius: 8px;
  cursor: pointer;
  font-size: 14px;
  font-weight: 500;
  text-align: center;
  min-width: 100px;
  transition: background 0.2s ease, transform 0.1s ease;
  box-shadow: 0 4px 10px rgba(0,0,0,0.2);
}

.interaction-btn:hover {
  background: #ff7300;
  color: black;
  transform: translateY(-1px);
  box-shadow: 0 8px 20px #ff7300, 0 6px 15px rgba(0, 0, 0, 0.4);
}

/* 🔹 Comments Section */
.comments-section {
  margin-top: 1rem;
  width: 100%;
}

/* 🔹 Comment Box */
.comment-box {
  display: flex;
  flex-direction: column;
  gap: 8px;
  margin-top: 0.5rem;

  opacity: 0;
  max-height: 0;
  overflow: hidden;
  transform: translateY(-5px);
  transition: opacity 0.25s ease, transform 0.25s ease, max-height 0.25s ease;
}

.comment-box.show {
  opacity: 1;
  max-height: 400px; /* enough for textarea + button */
  transform: translateY(0);
}

.comment-box textarea {
  padding: 10px;
  border-radius: 8px;
  border: 1px solid #ccc;
  resize: vertical;
  font-size: 14px;
  width: 100%;
  min-height: 80px;
}

.comment-box .interaction-btn {
  align-self: flex-start;
  min-width: 80px;
  margin-top: 4px;
}

/* 🔹 Comments List */
.comments-list {
  margin-top: 12px;
  display: flex;
  flex-direction: column;
  gap: 10px;

  opacity: 0;
  max-height: 0;
  overflow: hidden;
  transition: opacity 0.25s ease, max-height 0.25s ease;
}

.comments-list.show {
  opacity: 1;
  max-height: 1000px; /* adjust depending on comment count */
}

.comment {
  padding: 10px 12px;
  background: #fff;
  border-radius: 8px;
  border: 1px solid #eee;
  font-size: 14px;
  color: #333;
  word-break: break-word;
}

.comment strong {
  display: block;
  margin-bottom: 4px;
  color: #ff7300;
}

/* 🔹 Desktop layout: keep buttons in a row, comment box below */
@media (min-width: 769px) {
  .interaction-bar {
    flex-direction: row;
    justify-content: space-between;
    align-items: flex-start;
    flex-wrap: wrap;
  }
  .comments-section {
    flex: 1 1 100%;
  }
}

/* 🔹 Mobile tweaks */
@media (max-width: 768px) {
  .interaction-bar {
    flex-direction: column;
    align-items: flex-start;
  }
  .interaction-group {
    width: 100%;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .interaction-btn {
    flex: 1 1 48%;
  }
}

/* 🔹 Desktop: add left margin to align buttons with content */
@media (min-width: 769px) {
  .interaction-bar {
    margin-left: 2rem;
  }
}
</style>