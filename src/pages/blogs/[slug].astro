/* 🔥 STICKY SHARE (THE MAGIC) */
.blog-share {
  position: sticky;
  top: -15px; /* adjust to your navbar height */

  z-index: 10;

  /* layout */
  display: flex;
  justify-content: flex-start;
    height: fit-content;
  margin-bottom: 1rem;

  /* Subtle overlay */
  background: white;
  backdrop-filter: blur(2px);             /* slight blur for soft separation */
  -webkit-backdrop-filter: blur(2px);     /* Safari support */
  border-radius: 8px;                     /* rounded corners for smooth feel */
  padding: 0.25rem 0.5rem;                /* tiny padding inside wrapper */
}

  /* 🔥 Blog Content */
