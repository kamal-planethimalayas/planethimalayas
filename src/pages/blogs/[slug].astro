<script>
document.addEventListener("DOMContentLoaded", () => {

  function shuffle(array) {
    return [...array].sort(() => Math.random() - 0.5);
  }

  function setupRotator(selector, visibleCount = 5) {
    const container = document.querySelector(selector);
    if (!container) return;

    let items = Array.from(container.children);

    function showRandomSet() {
      items = shuffle(items);

      // fade out
      items.forEach(el => {
        el.style.opacity = "0";
        el.style.transform = "translateY(10px)";
      });

      setTimeout(() => {
        // 🔥 IMPORTANT: reorder DOM
        items.forEach(el => container.appendChild(el));

        // show only first N
        items.forEach((el, i) => {
          el.style.display = i < visibleCount ? "" : "none";
        });

        // fade in visible ones
        setTimeout(() => {
          items.slice(0, visibleCount).forEach(el => {
            el.style.opacity = "1";
            el.style.transform = "translateY(0)";
          });
        }, 50);

      }, 300);
    }

    // initial setup
    items.forEach((el, i) => {
      el.style.transition = "all 0.4s ease";
      if (i >= visibleCount) el.style.display = "none";
    });

    // 🔥 RUN ONCE IMMEDIATELY (IMPORTANT FIX)
    showRandomSet();

    // rotate every 5 sec
    setInterval(showRandomSet, 5000);
  }

  // Apply correctly to INNER containers
  setupRotator(".sidebar-upcoming-treks");
  setupRotator(".sidebar-blogs");

});
</script>