---
import Layout from "../../layouts/Layout.astro";
import { blogs } from "../../data/blogsData.js";
import { supabase } from "../../lib/supabaseClient.js";
import BlogInteractions from "../../components/BlogInteractions.jsx";
import ShareButtons from "../../components/ShareButtons.jsx";

// -------------------
// DYNAMIC ROUTING
// -------------------
export async function getStaticPaths() {
  return blogs.map(blog => ({
    params: { slug: blog.slug }
  }));
}

// -------------------
// GET SLUG & BLOG
// -------------------
const { slug } = Astro.params;
const blog = blogs.find(b => b.slug === slug);
if (!blog) throw new Error("Blog not found");

// -------------------
// FETCH INITIAL INTERACTIONS
// -------------------
let likes = 0;
let dislikes = 0;
let comments = [];

const { data } = await supabase
  .from("blog_interactions")
  .select("*")
  .eq("blog_slug", slug)
  .single();

if (data) {
  likes = data.likes;
  dislikes = data.dislikes;
  comments = data.comments || [];
}

const currentSlug = Astro.params.slug;

// find current blog
const currentBlog = blogs.find(b => b.slug === currentSlug);

// filter similar category blogs (excluding current)
const relatedBlogs = blogs.filter(
  b => b.category === currentBlog.category && b.slug !== currentSlug
);
---

<Layout>
  {blog.thumbnail && (
    <div class="blog-hero reveal">
      <img src={blog.thumbnail} alt={blog.title} />
      <h1 class="hero-title">{blog.title}</h1>
    </div>
  )}

  <!-- Top Share Buttons -->
  <ShareButtons pageUrl={Astro.request.url} pageTitle={blog.title} />

  <article class="blog-content">

    <!-- 🔥 BLOG MAIN CONTENT -->
    <div set:html={blog.content}></div>
  </article>

  <!-- 🔥 AUTHOR BLOCK (new) -->
    <div class="meta">
  <img 
    src={(blog.author && blog.author.thumbnail) || "/images/main/brand-logo.png"} 
    alt={(blog.author && blog.author.name) || "PH In-House Team"} 
  />

  <div class="author-info">
    <div class="author-name">
      {(blog.author && blog.author.name) || "PH In-House Team"}
    </div>

    <div class="author-designation">
      {(blog.author && blog.author.designation) || "Editorial Team, Planethimalayas"}
    </div>

    <p class="author-bio">
      {(blog.author && blog.author.bio) || "The PH In-House Team is the core editorial and operations group at Planethimalayas—made up of trek leaders, route planners, and on-ground experts with deep experience across the Himalayas."}
    </p>

    {(blog.author && blog.author.socials && blog.author.socials.linkedin) && (
      <a 
        href={blog.author.socials.linkedin} 
        target="_blank"
        rel="noopener noreferrer"
        class="author-linkedin"
      >
        LinkedIn Profile →
      </a>
    )}
  </div>
</div>
    <!-- END AUTHOR BLOCK -->

  <!-- Blog Interactions -->
  <BlogInteractions
    client:load
    slug={slug}
    initialLikes={likes}
    initialDislikes={dislikes}
    initialComments={comments}
  />

  <!-- Bottom Share Buttons -->
  <ShareButtons pageUrl={Astro.request.url} pageTitle={blog.title} />

<section class="related-blogs">
  <div class="container">

    <h2 class="related-title">
      More <span>Suggested Blogs to Read</span>
    </h2>

    <div class="related-slider">
      {relatedBlogs.map((blog, index) => (
        <a 
          href={`/blogs/${blog.slug}`} 
          class="blog-card related-card"
          key={index}
        >
          <img src={blog.thumbnail} alt={blog.title} class="blog-thumb" />
          <div class="blog-content">
            <span class="blog-category">{blog.category}</span>
            <h2>{blog.title}</h2>
          </div>
        </a>
      ))}
    </div>

  </div>
</section>
</Layout>

<style>
/* Reuse your hero & content CSS... */
  /* 🔥 Hero Section */
  .blog-hero {
    position: relative;
  width: 100%;
  height: 100vh; 
  overflow: hidden;
  margin: 0;
  padding: 0;
  display: flex;
  justify-content: center;
  align-items: center;
  background-color: white;
  background-size: cover;
  background-position: center;
  }

  .blog-hero img {
    width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center;
  display: block;
  }

  /* ✅ Title overlay */
.hero-title {
  position: absolute;
  bottom: 20%;
  left: 50%;
  transform: translateX(-50%);
  color: white;
  font-size: clamp(1.8rem, 4vw, 2.8rem);
  font-weight: bold;
  text-align: center;
  width: 100%;         /* ✅ full width inside hero */
  padding: 0 2rem;     /* ✅ keeps safe margin */
  line-height: 1.3;    /* ✅ more breathing space */
  white-space: normal;
  word-wrap: break-word;
  text-shadow: 3px 3px 8px rgba(0,0,0,0.95);
}

/* 📱 Mobile */
@media (max-width: 768px) {
  .hero-title {
    bottom: 15%;
    font-size: 1.9rem;   /* ✅ slightly bigger */
    padding: 0 1.5rem;  /* ✅ margin from sides */
    line-height: 1.4;   /* ✅ relaxed spacing */
  }
}


  /* 🔥 Blog Content */
  .blog-content {
    padding: 0 2rem;
    text-align: left;
    font-size: 1.125rem;
    line-height: 1.7;
    margin-bottom: 2rem;
  }

  /* ============================
   🖼️ BLOG INLINE IMAGE CONTROL
============================ */
:global(.blog-content img) {
  max-width: 720px;        /* 👈 controls visual width */
  width: 100%;
  max-height: 420px;       /* 👈 prevents tall images */
  object-fit: cover;

  display: block;
  margin: 2rem auto;       /* centers + spacing */

  border-radius: 12px;
  box-shadow: 0 10px 30px rgba(0,0,0,0.08);
}

  .meta {
    color: gray;
    font-size: 0.95rem;
    margin-bottom: 2rem;
  }

  @media (max-width: 768px) {
  .blog-hero {
    height: 70vh; /* taller hero for mobile */
    margin-top: -55px;
  }

  .hero-title {
    bottom: 15%;
    font-size: clamp(1.6rem, 5vw, 2.8rem); /* ✅ no cramp */
    line-height: 1.3;
    max-width: 95%; /* ✅ use more space */
    padding: 0 1rem;
  }

  .blog-content {
    font-size: 1rem;
    padding: 0 1rem;
  }

  :global(.blog-content img) {
    max-width: 100%;
    max-height: 300px;
    margin: 1.5rem auto;
  }
}

/* ============================
   🏔️ TREK CARD LAYOUT
============================ */
.blog-content .trek-card {
  display: flex;
  align-items: flex-start;
  gap: 1.5rem;

  margin: 1.5rem 0;
}

.blog-content .trek-card img {
  width: 240px;          /* 👈 controls size */
  height: 160px;
  object-fit: cover;

  border-radius: 12px;
  flex-shrink: 0;

  margin: 0;             /* 👈 override blog image margin */
  box-shadow: 0 8px 24px rgba(0,0,0,0.08);
}

.blog-content .trek-card ul {
  margin: 0;
  padding-left: 1rem;
  font-size: 0.95rem;
  line-height: 1.6;
}

.blog-content .trek-card li {
  margin-bottom: 0.35rem;
}

@media (max-width: 768px) {
  .blog-content .trek-card {
    flex-direction: column;
  }

  .blog-content .trek-card img {
    width: 100%;
    height: 200px;
  }
}

/* ============================
   🔥 AUTHOR BLOCK ONLY
============================ */
.meta {
  display: flex;
  align-items: flex-start;
  gap: 1rem;

  background: #fff7f0;
  padding: 1.25rem;
  border-radius: 12px;

  margin-bottom: 2rem;
  color: #333;
}

.meta img {
  width: 64px;
  height: 64px;
  object-fit: cover;
  flex-shrink: 0;
  padding: 6px;
}

.author-info {
  display: flex;
  flex-direction: column;
  gap: 0.25rem;
}

.author-name {
  font-size: 1.15rem;
  font-weight: 700;
  color: #000;
}

.author-designation {
  font-size: 0.95rem;
    font-weight: 700;

  color: #555;
}

.author-bio {
  margin-top: 0.35rem;
  font-size: 0.95rem;
  color: #444;
  line-height: 1.5;
}

.author-linkedin {
  margin-top: 0.4rem;
  font-size: 0.9rem;
  font-weight: 600;
  color: #ff7300;
  text-decoration: none;
}

.author-linkedin:hover {
  text-decoration: underline;
  opacity: 0.9;
}

.author-date {
  margin-top: 0.4rem;
  font-size: 0.9rem;
  color: #666;
}

/* Mobile */
@media (max-width: 768px) {
  .meta {
    padding: 1rem;
    gap: 0.75rem;
  }

  .meta img {
    width: 56px;
    height: 56px;
  }

  .author-bio {
    font-size: 0.9rem;
  }
}

/* ===== RELATED BLOGS SECTION ===== */

.related-blogs {
  position: relative;
  padding: 2rem 1rem;
}

/* Title */
.related-title {
  font-size: 2rem;
  font-family: 'Helvetica', sans-serif;
  margin-bottom: 1rem;
}

.related-title span {
  color: #ff7300;
  border-bottom: 3px solid #ff7300;
}

/* ===== SLIDER ===== */

.related-slider {
  display: flex;
  gap: 0.8rem;
  overflow-x: auto;
  padding-bottom: 0.5rem;
  padding-right: 2rem; /* peek next card */

  scroll-snap-type: x mandatory;
  scroll-padding-left: 1rem;

  -webkit-overflow-scrolling: touch;
  scroll-behavior: smooth;
}

/* Scrollbar (desktop only) */
.related-slider::-webkit-scrollbar {
  height: 6px;
}

.related-slider::-webkit-scrollbar-thumb {
  background: rgba(255,115,0,0.6);
  border-radius: 10px;
}

/* ===== CARDS ===== */

.related-card {
  min-width: 220px;
  max-width: 220px;
  flex-shrink: 0;

  border-radius: 10px;
  overflow: hidden;

  scroll-snap-align: start;
  scroll-snap-stop: always;

  transform: scale(0.98);
  transition: transform 0.25s ease, box-shadow 0.25s ease;
}

/* Hover (desktop) */
@media (hover: hover) {
  .related-card:hover {
    transform: scale(1.02);
  }
}

/* Touch feedback (mobile) */
.related-card:active {
  transform: scale(0.96);
}

/* Image */
.related-card .blog-thumb {
  height: 120px;
  object-fit: cover;
}

/* Content */
.related-card .blog-content {
  padding: 0.6rem;
}

/* Title */
.related-card h2 {
  font-size: 0.95rem;
  line-height: 1.3;
  margin: 0.3rem 0;
}

/* Category badge */
.related-card .blog-category {
  font-size: 0.65rem;
  padding: 3px 6px;
}

/* ===== SCROLL HINT (fade effect) ===== */

.related-blogs::after {
  content: "";
  position: absolute;
  right: 0;
  top: 50px;
  bottom: 0;
  width: 60px;

  background: linear-gradient(
    to right,
    rgba(255,255,255,0),
    #fff
  );

  pointer-events: none;
}

/* ===== MOBILE OPTIMIZATION ===== */

@media (max-width: 768px) {
  .related-slider::-webkit-scrollbar {
    display: none;
  }

  .related-slider {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
}

</style>