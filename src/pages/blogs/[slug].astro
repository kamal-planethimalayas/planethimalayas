  margin-top: auto;

  margin-bottom: 0.7rem;
}


/* =========================
   LATEST VIDEOS
========================= */

.sidebar-videos {
  display: flex;

  flex-direction: column;

  gap: 0.5rem;

  margin-bottom: 1rem;
}

.sidebar-video-card {
  display: flex;

  flex-direction: column;

  width: 100%;

  max-width: 220px;

  height: 280px;

  background: #121316;

  border-radius: 10px;

  overflow: hidden;

  border: 2px solid #ff7300;

  position: relative;

  transform-style: preserve-3d;

  transition:
    transform 0.4s cubic-bezier(0.22, 1, 0.36, 1),
    box-shadow 0.4s cubic-bezier(0.22, 1, 0.36, 1);

  box-shadow:
    0 4px 12px rgba(255,115,0,0.45),
    0 0 10px rgba(255,115,0,0.3);
}

.sidebar-video-card:hover {
  transform:
    translateY(-4px)
    rotateX(2deg)
    rotateY(1deg);

  box-shadow:
    0 6px 20px rgba(255,115,0,0.95),
    inset 0 0 8px rgba(255,115,0,0.1);

  z-index: 10;
}

.video-thumbnail-wrapper {
  width: 100%;

  height: 140px;

  position: relative;

  overflow: hidden;
}

.video-thumbnail-wrapper img {
  width: 100%;

  height: 100%;

  object-fit: cover;

  display: block;
}

.video-play-button {
  position: absolute;

  left: 50%;
  top: 50%;

  transform: translate(-50%, -50%);

  width: 48px;
  height: 48px;

  border-radius: 50%;

  background: rgba(0,0,0,0.75);

  color: white;

  display: flex;

  align-items: center;
  justify-content: center;

  font-size: 1.2rem;

  padding-left: 3px;

  pointer-events: none;
}

.sidebar-video-card .video-title {
  font-size: 0.95rem;

  line-height: 1.3;

  text-align: center;

  padding: 0 0.6rem;

  margin-top: 0.8rem;
}

.sidebar-video-card .video-title a {
  color: #ff7300;

  text-decoration: none;
}

.sidebar-video-card .video-title a:hover {
  text-decoration: none;
}


