---
import Layout from "../../layouts/Layout.astro";
import { blogs } from "../../data/blogsData.js";
import { treks } from '../../data/treksData.js';
import { supabase } from "../../lib/supabaseClient.js";
import BlogInteractions from "../../components/BlogInteractions.jsx";
import ShareButtons from "../../components/ShareButtons.jsx";

// -------------------
// DYNAMIC ROUTING
// -------------------

export async function getStaticPaths() {
  return blogs.map(blog => ({
    params: { slug: blog.slug }
  }));
}

// -------------------
// GET SLUG & BLOG
// -------------------
const { slug } = Astro.params;
const blog = blogs.find(b => b.slug === slug);
if (!blog) throw new Error("Blog not found");

// -------------------
// FETCH INITIAL INTERACTIONS
// -------------------
let likes = 0;
let dislikes = 0;
let comments = [];

const { data } = await supabase
  .from("blog_interactions")
  .select("*")
  .eq("blog_slug", slug)
  .single();

if (data) {
  likes = data.likes;
  dislikes = data.dislikes;
  comments = data.comments || [];
}

const currentSlug = Astro.params.slug;

// find current blog
const currentBlog = blogs.find(b => b.slug === currentSlug);

// filter similar category blogs (excluding current)
const relatedBlogs = blogs.filter(
  b => b.category === currentBlog.category && b.slug !== currentSlug
);

const seasonOfBlog = currentBlog.season || "summer"; // adjust if needed

const upcomingTrekCards = treks
  .filter(t => t.season?.includes(seasonOfBlog)) // make sure 'season' exists
  .slice(0, 5); 
---

<Layout
  title={blog.seoTitle || blog.title}
  description={blog.description}
  image={blog.thumbnail}
  url={`https://www.planethimalayas.com/blogs/${blog.slug}`}
  type="article"
  publishedTime={blog.date}
>
  {blog.thumbnail && (
    <div class="blog-hero reveal">
      <img src={blog.thumbnail} alt={blog.title} />
      <h1 class="hero-title">{blog.title}</h1>
    </div>
  )}

<div class="blog-layout">

  <!-- LEFT: MAIN CONTENT -->
  <div class="blog-main">

    <!-- Share Buttons -->
    <div class="blog-share">
      <ShareButtons pageUrl={Astro.request.url} pageTitle={blog.title} />
    </div>

    <article class="blog-content">
      <div set:html={blog.content}></div>
    </article>

    <!-- AUTHOR BLOCK -->
    <div class="meta">
      <img 
        src={(blog.author && blog.author.thumbnail) || "/images/main/brand-logo.png"} 
        alt={(blog.author && blog.author.name) || "PH In-House Team"} 
      />

      <div class="author-info">
        <div class="author-name">
          {(blog.author && blog.author.name) || "PH In-House Team"}
        </div>

        <div class="author-designation">
          {(blog.author && blog.author.designation) || "Editorial Team, Planethimalayas"}
        </div>

        <p class="author-bio">
          {(blog.author && blog.author.bio) || "The PH In-House Team is the core editorial and operations group at Planethimalayas—made up of trek leaders, route planners, and on-ground experts with deep experience across the Himalayas."}
        </p>

        {(blog.author && blog.author.socials && blog.author.socials.linkedin) && (
          <a 
            href={blog.author.socials.linkedin} 
            target="_blank"
            rel="noopener noreferrer"
            class="author-linkedin"
          >
            LinkedIn Profile →
          </a>
        )}
      </div>
    </div>

    <!-- INTERACTIONS -->
    <BlogInteractions
      client:load
      slug={slug}
      initialLikes={likes}
      initialDislikes={dislikes}
      initialComments={comments}
    />

  </div> <!-- end .blog-main -->

  <!-- RIGHT: SIDEBAR (30%) -->
  <aside class="blog-sidebar">
    
    <!-- 🏔️ Upcoming Treks -->
    <div class="sidebar-treks">
      <h3>Trending Treks</h3>
    <div class="sidebar-upcoming-treks">
      {treks
        .filter(
          trek => Array.isArray(trek.season) && trek.season.map(s => s.toLowerCase()).includes('summer')
        )
        .map(trek => {
          const duration = trek.overview?.facts?.find(f => f.label === "Trek Duration")?.value || trek.duration;
          const difficultyStr = Array.isArray(trek.difficulty) ? trek.difficulty.join(', ') : trek.difficulty;

          const capitalize = str => {
            if (!str) return '';
            if (Array.isArray(str)) return str.map(capitalize).join(', ');
            return str
              .split(' ')
              .map(word => word.charAt(0).toUpperCase() + word.slice(1))
              .join(' ');
          };

          return (
            <div class="sidebar-trek-card" data-trek key={trek.id}>
              <a href={`/trek/${trek.id}#trek-hero`}>
                <img src={trek.heroImage} alt={`View of ${trek.name} trek`} />
              </a>
              <h4 class="trek-name">{trek.name}</h4>
              <div class="trek-info">
                <span class="trek-difficulty">{capitalize(difficultyStr)}</span>
                <span class="trek-duration">{duration}</span>
              </div>
              <a href={`/trek/${trek.id}#pricing-snippet-wrapper`} class="btn btn-dates">
                View Dates
              </a>
            </div>
          );
        })}
      </a>
    </div>
      <a href={`/upcoming-treks?season=summer`} class="more-treks-cta">
        More Upcoming Treks →
      </a>
    </div>

    <!-- 📚 Related Blogs -->
    <div class="sidebar-related-blogs">
      <h3>Related Blogs</h3>
      <div class="sidebar-blogs">
        {relatedBlogs.map((b, i) => (
          <div class="sidebar-blog-card" data-blog key={i}>
        
            <a href={`/blogs/${b.slug}`} class="blog-image-link">
              <img src={b.thumbnail} alt={b.title} />
            </a>

            <h4 class="blog-title">
              <a href={`/blogs/${b.slug}`} class="blog-title-link">
                {b.title}
              </a>
            </h4>

          </div>
        ))}
      </div>
      <a href={`/blogs?category=${encodeURIComponent(currentBlog.category)}`} class="sidebar-cta">
        More Related Blogs →
      <a>
    </div>

  </aside>

</div> <!-- end .blog-layout -->

</Layout>

