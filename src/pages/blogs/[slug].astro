</style>

<script>
document.addEventListener("DOMContentLoaded", () => {

  function shuffle(array) {
    return [...array].sort(() => Math.random() - 0.5);
  }


  function setupRotator(
    selector,
    visibleCount = 5
  ) {

    const container =
      document.querySelector(selector);

    if (!container) return;

    let items =
      Array.from(container.children);

    // Nothing to rotate
    if (items.length <= visibleCount) {

      items.forEach(el => {
        el.style.opacity = "1";
        el.style.transform = "translateY(0)";
      });

      return;
    }


    function showRandomSet() {

      items = shuffle(items);

      // Fade out
      items.forEach(el => {

        el.style.opacity = "0";

        el.style.transform =
          "translateY(10px)";

      });


      setTimeout(() => {

        // Reorder DOM
        items.forEach(el =>
          container.appendChild(el)
        );


        // Show only first 5
        items.forEach((el, i) => {

          el.style.display =
            i < visibleCount
              ? ""
              : "none";

        });


        // Fade in
        setTimeout(() => {

          items
            .slice(0, visibleCount)
            .forEach(el => {

              el.style.opacity = "1";

              el.style.transform =
                "translateY(0)";

            });

        }, 50);

      }, 300);

    }


    // Initial styles
    items.forEach((el, i) => {

      el.style.transition =
        "all 0.4s ease";

      el.style.opacity = "0";

      if (i >= visibleCount) {

        el.style.display = "none";

      }

    });


    // Initial random selection
    showRandomSet();


    // Rotate every 5 seconds
    setInterval(
      showRandomSet,
      5000
    );

  }


  // ==========================================
  // TRENDING TREKS
  // ==========================================

  setupRotator(
    ".sidebar-trek-list",
    5
  );


  // ==========================================
  // UPCOMING TREKS
  // ==========================================

  setupRotator(
    ".sidebar-upcoming-treks",
    5
  );


  // ==========================================
  // RELATED BLOGS
  // ==========================================

  setupRotator(
    ".sidebar-blogs",
    5
  );


  // ==========================================
  // LATEST ARTICLES
  // ==========================================

  setupRotator(
    ".sidebar-latest-articles-list",
    5
  );


  // ==========================================
  // LATEST VIDEOS
  // ==========================================

  setupRotator(
    ".sidebar-videos",
    5
  );

});
</script>