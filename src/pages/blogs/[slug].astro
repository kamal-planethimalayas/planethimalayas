---
import Layout from "../../layouts/Layout.astro";
import { blogs } from "../../data/blogsData.js";
import { treks } from "../../data/treksData.js";
import { supabase } from "../../lib/supabaseClient.js";
import BlogInteractions from "../../components/BlogInteractions.jsx";
import ShareButtons from "../../components/ShareButtons.jsx";
import BlogImageLightbox from "../../components/BlogImageLightbox.jsx";

// -------------------
// DYNAMIC ROUTING
// -------------------

export async function getStaticPaths() {
  return blogs.map(blog => ({
    params: { slug: blog.slug }
  }));
}

// -------------------
// GET SLUG & BLOG
// -------------------

const { slug } = Astro.params;

const blog = blogs.find(b => b.slug === slug);

if (!blog) {
  throw new Error("Blog not found");
}

// Replace normal blog images with BlogImageLightbox components
const blogContentParts = blog.content.split(/(<img\b[^>]*>)/gi);

// -------------------
// FETCH INITIAL INTERACTIONS
// -------------------

let likes = 0;
let dislikes = 0;
let comments = [];

const { data } = await supabase
  .from("blog_interactions")
  .select("*")
  .eq("blog_slug", slug)
  .single();

if (data) {
  likes = data.likes;
  dislikes = data.dislikes;
  comments = data.comments || [];
}

const currentSlug = Astro.params.slug;

// -------------------
// CURRENT BLOG
// -------------------

const currentBlog = blogs.find(b => b.slug === currentSlug);

// -------------------
// RELATED BLOGS
// -------------------

const relatedBlogs = blogs.filter(
  b =>
    b.category === currentBlog.category &&
    b.slug !== currentSlug
);

// =====================================================
// SEASON LOGIC
// =====================================================

// Your trek data uses:
// spring / summer / monsoon / autumn / winter

const getCurrentSeason = () => {
  const month = new Date().getMonth() + 1;

  if (month >= 3 && month <= 5) {
    return "spring";
  }

  if (month >= 6 && month <= 7) {
    return "summer";
  }

  if (month >= 8 && month <= 9) {
    return "monsoon";
  }

  if (month >= 10 && month <= 11) {
    return "autumn";
  }

  return "winter";
};

const seasonOrder = [
  "spring",
  "summer",
  "monsoon",
  "autumn",
  "winter"
];

const currentSeason = getCurrentSeason();

const currentSeasonIndex = seasonOrder.indexOf(currentSeason);

const nextSeason =
  seasonOrder[(currentSeasonIndex + 1) % seasonOrder.length];

// -------------------
// TRENDING TREKS
// -------------------

const trendingTreks = treks
  .filter(trek =>
    Array.isArray(trek.season) &&
    trek.season.some(
      season => season.toLowerCase() === currentSeason
    )
  );

// -------------------
// UPCOMING TREKS
// -------------------

const upcomingTreks = treks
  .filter(trek =>
    Array.isArray(trek.season) &&
    trek.season.some(
      season => season.toLowerCase() === nextSeason
    )
  );

// -------------------
// LATEST ARTICLES
// -------------------

// Newest articles first.
// Current article is excluded because the visitor
// is already reading it.

const latestArticles = [...blogs]
  .filter(b => b.slug !== currentSlug)
  .sort(
    (a, b) =>
      new Date(b.date).getTime() -
      new Date(a.date).getTime()
  )
  .slice(0, 5);

// =====================================================
// LATEST YOUTUBE VIDEOS
// =====================================================

const youtubeChannelId = "UCodKoReFYEiS_g3zmNXvefQ";

let latestVideos = [];

try {
  const youtubeFeedUrl =
    `https://www.youtube.com/feeds/videos.xml?channel_id=${youtubeChannelId}`;

  const response = await fetch(youtubeFeedUrl);

  if (response.ok) {
    const xml = await response.text();

    const entries = [...xml.matchAll(/<entry>([\s\S]*?)<\/entry>/g)];

    latestVideos = entries
      .slice(0, 5)
      .map(match => {
        const entry = match[1];

        const videoId =
          entry.match(
            /<yt:videoId>(.*?)<\/yt:videoId>/
          )?.[1] || "";

        const title =
          entry.match(
            /<title>([\s\S]*?)<\/title>/
          )?.[1]
            ?.replace(/<!\[CDATA\[(.*?)\]\]>/g, "$1")
            .trim() || "Planethimalayas Video";

        const published =
          entry.match(
            /<published>(.*?)<\/published>/
          )?.[1] || "";

        return {
          videoId,
          title,
          published
        };
      })
      .filter(video => video.videoId);
  }
} catch (error) {
  console.warn(
    "Could not fetch latest Planethimalayas YouTube videos:",
    error
  );
}

// -------------------
// HELPER
// -------------------

const capitalize = str => {
  if (!str) return "";

  if (Array.isArray(str)) {
    return str.map(capitalize).join(", ");
  }

  return str
    .split(" ")
    .map(
      word =>
        word.charAt(0).toUpperCase() +
        word.slice(1)
    )
    .join(" ");
};
---

<Layout
  title={blog.seoTitle || blog.title}
  description={blog.description}
  image={blog.thumbnail}
  url={`https://www.planethimalayas.com/blogs/${blog.slug}`}
  type="article"
  publishedTime={blog.date}
>
  {blog.thumbnail && (
    <div class="blog-hero reveal">
      <img src={blog.thumbnail} alt={blog.title} />
      <h1 class="hero-title">{blog.title}</h1>
    </div>
  )}

<div class="blog-layout">

  <!-- LEFT: MAIN CONTENT -->
  <div class="blog-main">

    <!-- Share Buttons -->
    <div class="blog-share">
      <ShareButtons pageUrl={Astro.request.url} pageTitle={blog.title} />
    </div>

    <article class="blog-content">
  {blogContentParts.map((part) => {
    if (!part.trim().toLowerCase().startsWith("<img")) {
      return <Fragment set:html={part} />;
    }

    const srcMatch = part.match(/src=["']([^"']+)["']/i);
    const altMatch = part.match(/alt=["']([^"']*)["']/i);

    if (!srcMatch) {
      return <Fragment set:html={part} />;
    }

    return (
      <BlogImageLightbox
        client:load
        src={srcMatch[1]}
        alt={altMatch ? altMatch[1] : "Planethimalayas blog image"}
      />
    );
  })}
</article>

    <!-- AUTHOR BLOCK -->
    <div class="meta">
      <img 
        src={(blog.author && blog.author.thumbnail) || "/images/main/brand-logo.png"} 
        alt={(blog.author && blog.author.name) || "PH In-House Team"} 
      />

      <div class="author-info">
        <div class="author-name">
          {(blog.author && blog.author.name) || "PH In-House Team"}
        </div>

        <div class="author-designation">
          {(blog.author && blog.author.designation) || "Editorial Team, Planethimalayas"}
        </div>

        <p class="author-bio">
          {(blog.author && blog.author.bio) || "The PH In-House Team is the core editorial and operations group at Planethimalayas—made up of trek leaders, route planners, and on-ground experts with deep experience across the Himalayas."}
        </p>

        {(blog.author && blog.author.socials && blog.author.socials.linkedin) && (
          <a 
            href={blog.author.socials.linkedin} 
            target="_blank"
            rel="noopener noreferrer"
            class="author-linkedin"
          >
            LinkedIn Profile →
          </a>
        )}
      </div>
    </div>

    <!-- INTERACTIONS -->
    <BlogInteractions
      client:load
      slug={slug}
      initialLikes={likes}
      initialDislikes={dislikes}
      initialComments={comments}
    />

  </div> <!-- end .blog-main -->

  <!-- RIGHT: SIDEBAR -->
<aside class="blog-sidebar">

  <!-- ==========================================
       TRENDING TREKS
  =========================================== -->
  <div class="sidebar-section sidebar-treks">

    <h3>Trending Treks</h3>

    <div class="sidebar-trek-list">

      {trendingTreks.map(trek => {

        const duration =
          trek.overview?.facts?.find(
            f => f.label === "Trek Duration"
          )?.value || trek.duration;

        const difficultyStr =
          Array.isArray(trek.difficulty)
            ? trek.difficulty.join(", ")
            : trek.difficulty;

        return (
          <div
            class="sidebar-trek-card"
            data-trek
          >

            <a href={`/trek/${trek.id}#trek-hero`}>
              <img
                src={trek.heroImage}
                alt={`View of ${trek.name} trek`}
              />
            </a>

            <h4 class="trek-name">
              {trek.name}
            </h4>

            <div class="trek-info">

              <span class="trek-difficulty">
                {capitalize(difficultyStr)}
              </span>

              <span class="trek-duration">
                {duration}
              </span>

            </div>

            <a
              href={`/trek/${trek.id}#pricing-snippet-wrapper`}
              class="btn btn-dates"
            >
              View Dates
            </a>

          </div>
        );
      })}

    </div>

    <a
      href={`/upcoming-treks?season=${currentSeason}`}
      class="more-treks-cta"
    >
      Explore {capitalize(currentSeason)} Treks →
    </a>

  </div>


  <!-- ==========================================
       UPCOMING TREKS
  =========================================== -->
  <div class="sidebar-section sidebar-treks">

    <h3>Upcoming Treks</h3>

    <div class="sidebar-upcoming-treks">

      {upcomingTreks.map(trek => {

        const duration =
          trek.overview?.facts?.find(
            f => f.label === "Trek Duration"
          )?.value || trek.duration;

        const difficultyStr =
          Array.isArray(trek.difficulty)
            ? trek.difficulty.join(", ")
            : trek.difficulty;

        return (
          <div
            class="sidebar-trek-card"
            data-trek
          >

            <a href={`/trek/${trek.id}#trek-hero`}>
              <img
                src={trek.heroImage}
                alt={`View of ${trek.name} trek`}
              />
            </a>

            <h4 class="trek-name">
              {trek.name}
            </h4>

            <div class="trek-info">

              <span class="trek-difficulty">
                {capitalize(difficultyStr)}
              </span>

              <span class="trek-duration">
                {duration}
              </span>

            </div>

            <a
              href={`/trek/${trek.id}#pricing-snippet-wrapper`}
              class="btn btn-dates"
            >
              View Dates
            </a>

          </div>
        );
      })}

    </div>

    <a
      href={`/upcoming-treks?season=${nextSeason}`}
      class="more-treks-cta"
    >
      Explore {capitalize(nextSeason)} Treks →
    </a>

  </div>


  <!-- ==========================================
       RELATED BLOGS
  =========================================== -->
  <div class="sidebar-section sidebar-related-blogs">

    <h3>Related Blogs</h3>

    <div class="sidebar-blogs">

      {relatedBlogs.map((b, i) => (

        <div
          class="sidebar-blog-card"
          data-blog
          key={i}
        >

          <a
            href={`/blogs/${b.slug}`}
            class="blog-image-link"
          >
            <img
              src={b.thumbnail}
              alt={b.title}
            />
          </a>

          <h4 class="blog-title">

            <a
              href={`/blogs/${b.slug}`}
              class="blog-title-link"
            >
              {b.title}
            </a>

          </h4>

        </div>

      ))}

    </div>

    <a
      href={`/blogs?category=${encodeURIComponent(currentBlog.category)}`}
      class="sidebar-cta"
    >
      More Related Blogs →
    </a>

  </div>


  <!-- ==========================================
       LATEST ARTICLES
  =========================================== -->
  <div class="sidebar-section sidebar-latest-articles">

    <h3>Latest Articles</h3>

    <div class="sidebar-latest-articles-list">

      {latestArticles.map((article, i) => (

        <div
          class="sidebar-article-card"
          data-article
          key={i}
        >

          <a
            href={`/blogs/${article.slug}`}
            class="article-image-link"
          >
            <img
              src={article.thumbnail}
              alt={article.title}
            />
          </a>

          <h4 class="article-title">

            <a
              href={`/blogs/${article.slug}`}
              class="article-title-link"
            >
              {article.title}
            </a>

          </h4>

          {article.date && (
            <span class="article-date">
              {new Date(article.date).toLocaleDateString(
                "en-IN",
                {
                  day: "numeric",
                  month: "short",
                  year: "numeric"
                }
              )}
            </span>
          )}

        </div>

      ))}

    </div>

    <a
      href="/blogs"
      class="sidebar-cta"
    >
      Explore All Articles →
    </a>

  </div>


  <!-- ==========================================
       LATEST VIDEOS
  =========================================== -->
  <div class="sidebar-section sidebar-latest-videos">

    <h3>Latest Videos</h3>

    <div class="sidebar-videos">

      {latestVideos.map((video, i) => (

        <div
          class="sidebar-video-card"
          data-video
          key={i}
        >

          <a
            href={`https://www.youtube.com/watch?v=${video.videoId}`}
            target="_blank"
            rel="noopener noreferrer"
            class="video-thumbnail-link"
          >

            <div class="video-thumbnail-wrapper">

              <img
                src={`https://i.ytimg.com/vi/${video.videoId}/hqdefault.jpg`}
                alt={video.title}
              />

              <span class="video-play-button">
                ▶
              </span>

            </div>

          </a>

          <h4 class="video-title">

            <a
              href={`https://www.youtube.com/watch?v=${video.videoId}`}
              target="_blank"
              rel="noopener noreferrer"
            >
              {video.title}
            </a>

          </h4>

        </div>

      ))}

    </div>

    <a
      href="https://www.youtube.com/@Planethimalayas"
      target="_blank"
      rel="noopener noreferrer"
      class="sidebar-cta"
    >
      Visit Our YouTube Channel →
    </a>

  </div>

</aside>

</div> <!-- end .blog-layout -->

</Layout>

<style>
/* Reuse your hero & content CSS... */
  /* 🔥 Hero Section */
  .blog-hero {
  position: relative;
  width: 100%;

  /* 🔥 KEY CHANGE */
  height: 65vh;
  overflow: hidden;
  margin: 0;
  padding: 0;

  display: flex;
  justify-content: center;
  align-items: flex-end; /* pushes content down naturally */

  background-color: #000;
  background-size: cover;
  background-position: center;
}

/* IMAGE */
.blog-hero img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center;
  display: block;
}

  /* ✅ Title overlay */
.hero-title {
  position: absolute;
  bottom: 20%;
  left: 50%;
  transform: translateX(-50%);
  color: white;
  font-size: clamp(1.8rem, 4vw, 2.8rem);
  font-weight: bold;
  text-align: center;
  width: 100%;         /* ✅ full width inside hero */
  padding: 0 2rem;     /* ✅ keeps safe margin */
  line-height: 1.3;    /* ✅ more breathing space */
  white-space: normal;
  word-wrap: break-word;
  text-shadow: 3px 3px 8px rgba(0,0,0,0.95);
}

/* 📱 Mobile */
@media (max-width: 768px) {
  .hero-title {
    bottom: 15%;
    font-size: 1.9rem;   /* ✅ slightly bigger */
    padding: 0 1.5rem;  /* ✅ margin from sides */
    line-height: 1.4;   /* ✅ relaxed spacing */
  }
}

/* ============================
   MAIN BLOG LAYOUT
============================ */
.blog-layout {
  display: flex;
  gap: 2rem;
  max-width: 1200px;
  box-sizing: border-box;
  flex-wrap: nowrap;
}

.blog-main {
  flex: 0 0 75%;
  min-width: 900px;
}

/* =========================
   SIDEBAR
========================= */

.blog-sidebar {
  flex: 0 0 25%;
  min-width: 300px;

  display: flex;
  flex-direction: column;
  gap: 2rem;

  position: sticky;
  top: 120px;

  align-items: center;
}


/* =========================
   SIDEBAR SECTIONS
========================= */

.sidebar-section {
  width: 100%;
  padding-top: 1rem;
}

.sidebar-section h3 {
  font-family: 'Helvetica', sans-serif;
  font-weight: bold;
  font-size: 1.5rem;

  margin-bottom: 2rem;

  color: #000;

  border-bottom: 2px solid #ff7300;

  padding-bottom: 0.25rem;
}


/* =========================
   TREK SECTIONS
========================= */

.sidebar-trek-list,
.sidebar-upcoming-treks {
  display: flex;
  flex-direction: column;
  gap: 0.5rem;
}


/* =========================
   TREK CARD
========================= */

.sidebar-trek-card {
  display: flex;
  flex-direction: column;

  width: 100%;
  max-width: 220px;
  height: 280px;

  background: #121316;

  border-radius: 10px;
  overflow: hidden;

  margin-bottom: 1rem;

  border: 2px solid #ff7300;

  position: relative;

  transform-style: preserve-3d;

  transition:
    transform 0.4s cubic-bezier(0.22, 1, 0.36, 1),
    box-shadow 0.4s cubic-bezier(0.22, 1, 0.36, 1),
    border 0.3s ease;

  box-shadow:
    0 4px 12px rgba(255, 115, 0, 0.45),
    0 0 10px rgba(255, 115, 0, 0.3);
}

.sidebar-trek-card:hover {
  transform:
    translateY(-4px)
    rotateX(2deg)
    rotateY(1deg);

  box-shadow:
    0 -4px 10px rgba(0, 0, 0, 0.1),
    0 6px 20px rgba(255, 115, 0, 0.95),
    inset 0 0 8px rgba(255, 115, 0, 0.1);

  z-index: 10;
}

.sidebar-trek-card img {
  width: 100%;
  height: 120px;

  object-fit: cover;

  display: block;

  margin-bottom: 0.5rem;
}

.sidebar-trek-card h4.trek-name {
  font-size: 0.95rem;
  font-weight: 600;

  color: #ff7300;

  margin-bottom: 0.25rem;

  text-align: center;
}

.sidebar-trek-card .trek-info {
  display: flex;
  flex-direction: column;

  align-items: center;

  gap: 0.2rem;

  font-size: 0.85rem;

  color: #fff;

  margin-bottom: 0.5rem;
}

.sidebar-trek-card .btn-dates {
  display: flex;

  justify-content: center;

  margin: 0 1rem;

  padding: 0.5rem 1rem;

  text-decoration: none;

  font-weight: 600;

  font-size: 0.9rem;

  border-radius: 6px;

  border: 2px solid #ff7300;

  color: #ff7300;

  background: rgba(0, 0, 0, 0.75);

  backdrop-filter: blur(15px);

  -webkit-backdrop-filter: blur(15px);

