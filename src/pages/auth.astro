---
import AuthPage from '../components/AuthPage.jsx';
---

<style>

/* Container */
.auth-container {
  max-width: 400px;
  margin: auto;
  padding: 16px;
  font-family: "Roboto", sans-serif;
  display: flex;
  flex-direction: column;
  align-items: center;
  color: black;
}

/* Logo */
.auth-logo {
  text-decoration: none;
  margin-bottom: 1.5rem;
  display: flex;
  align-items: center;
}

.auth-logo img {
  height: 50px;
  margin-right: 10px;
}

.auth-logo h2 {
  font-family: Helvetica, sans-serif;
  font-size: 1.8rem;
  margin: 0;
}

.auth-logo .brand {
  color: #ff7300;
}

/* Title */
.auth-title {
  font-size: 1.6rem;
  font-weight: bold;
  color: #ff7300;
  margin-bottom: 20px;
  text-align: center;
}

/* Form */
.auth-form {
  width: 100%;
}

.auth-field {
  margin-bottom: 16px;
}

.auth-field label {
  display: block;
  margin-bottom: 6px;
  font-size: 0.95rem;
  font-weight: 500;
}

.auth-field input {
  width: 100%;
  padding: 10px 12px;
  font-size: 16px;
  border-radius: 6px;
  border: 1px solid #ccc;
  transition: 0.25s ease;
  box-sizing: border-box;
}

/* Glowing Brand Focus */
.auth-field input:focus {
  outline: none;
  border-color: #ff7300;
  box-shadow: 0 0 8px #ff7300;
}

/* Password Wrapper */
.password-wrapper {
  position: relative;
}

.toggle-password {
  position: absolute;
  right: 12px;
  top: 50%;
  transform: translateY(-50%);
  background: none;
  border: none;
  cursor: pointer;
  font-size: 18px;
}

/* Errors / Info */
.auth-error {
  color: red;
  margin: 10px 0;
}

.auth-success {
  color: green;
  margin: 10px 0;
}

/* Submit Button */
.auth-submit {
  width: 100%;
  padding: 12px;
  background: black;
  color: #ff7300;
  border: 2px solid #ff7300;
  border-radius: 6px;
  font-size: 16px;
  font-weight: bold;
  cursor: pointer;
  transition: 0.25s ease;
}

/* Hover Effect */
.auth-submit:hover {
  background: #ff7300;
  color: black;
  border-color: #ff7300;
  transform: translateY(-2px);
  box-shadow: 0 0 12px #ff7300;
  border: 2px solid #000;
}

/* Click Effect */
.auth-submit:active {
  transform: scale(0.97);
  box-shadow: 0 0 16px #ff7300;
}

/* Disabled */
.auth-submit:disabled {
  opacity: 0.7;
  cursor: not-allowed;
}

/* Switch */
.switch-auth {
  margin-top: 20px;
  text-align: center;
}

.switch-btn {
  margin-left: 6px;
  background: none;
  border: none;
  color: #ff7300;
  cursor: pointer;
  font-weight: bold;
}

/* Stop visited/purple link color */
.auth-logo:visited,
.auth-logo:link,
.auth-logo:hover,
.auth-logo:active {
  color: inherit !important;
  text-decoration: none;
}

/* Force only "Planet" (the first span) to stay black */
.auth-logo h2 span:first-child {
  color: #000 !important;
}

</style>

<AuthPage client:only="react" />