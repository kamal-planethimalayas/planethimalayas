<pre id="treks-data-json" style="display:none;">{JSON.stringify(treks)}</pre>

<script>
document.addEventListener("DOMContentLoaded", () => {

  /* =========================
     DATA & ELEMENTS
  ========================= */

  const trekDataElement =
    document.getElementById("treks-data-json");

  if (!trekDataElement) return;

  const trekData =
    JSON.parse(trekDataElement.textContent);


  const desktopCheckboxes = [
    ...document.querySelectorAll(
      '.filter-navbar input[type="checkbox"]'
    )
  ];


  const modalCheckboxes = [
    ...document.querySelectorAll(
      '.filter-modal input[type="checkbox"]'
    )
  ];


  const trekCards = [
    ...document.querySelectorAll(".trek-card")
  ];


  const mainContent =
    document.querySelector(".main-content");


  const trekResults =
    document.getElementById("trek-results");


  const trekResultsTitle =
    document.getElementById(
      "trek-results-title"
    );


  const trekResultsBack =
    document.getElementById(
      "trekResultsBack"
    );


  /* =========================
     HELPERS
  ========================= */

  function getDays(durationStr) {

    if (!durationStr) return null;

    const match =
      String(durationStr).match(
        /(\d+)\s*days?/i
      );

    return match
      ? Number(match[1])
      : null;
  }


  function getSelectedFilters() {

    const filters = {};

    desktopCheckboxes.forEach(cb => {

      if (!cb.checked) return;

      if (!filters[cb.name]) {
        filters[cb.name] = new Set();
      }

      filters[cb.name].add(
        cb.value.toLowerCase()
      );

    });

    return filters;
  }


  function getTrekValues(value) {

    if (Array.isArray(value)) {

      return value.map(item =>
        String(item).toLowerCase()
      );

    }

    return [
      String(value ?? "").toLowerCase()
    ];
  }


  /* =========================
     TREK FILTER MATCHING
  ========================= */

  function trekMatchesFilters(
    trek,
    filters
  ) {

    for (const category in filters) {

      const selectedOptions =
        filters[category];


      /* =========================
         EXPERIENCE
      ========================= */

      if (category === "experience") {

        const trekTags =
          Array.isArray(trek.tags)
            ? trek.tags.map(tag =>
                String(tag).toLowerCase()
              )
            : [];


        const matches =
          [...selectedOptions].some(
            option =>
              trekTags.includes(option)
          );


        if (!matches) {
          return false;
        }
      }


      /* =========================
         TREK DURATION
      ========================= */

      else if (category === "days") {

        const durationStr =
          trek.overview?.facts?.find(
            fact =>
              fact.label === "Trek Duration"
          )?.value ||
          trek.duration;


        const days =
          getDays(durationStr);


        if (
          !days ||
          !selectedOptions.has(
            days.toString()
          )
        ) {
          return false;
        }
      }


      /* =========================
         DIFFICULTY
      ========================= */

      else if (category === "difficulty") {

        const trekDifficulties =
          getTrekValues(
            trek.difficulty
          );


        const matches =
          [...selectedOptions].some(
            option =>
              trekDifficulties.includes(
                option
              )
          );


        if (!matches) {
          return false;
        }
      }


      /* =========================
         MONTH
      ========================= */

      else if (category === "month") {

        const trekMonths =
          getTrekValues(
            trek.month
          );


        const matches =
          [...selectedOptions].some(
            option =>
              trekMonths.includes(
                option
              )
          );


        if (!matches) {
          return false;
        }
      }


      /* =========================
         SEASON
      ========================= */

      else if (category === "season") {

        const trekSeasons =
          getTrekValues(
            trek.season
          );


        const matches =
          [...selectedOptions].some(
            option =>
              trekSeasons.includes(
                option
              )
          );


        if (!matches) {
          return false;
        }
      }


      /* =========================
         REGION
      ========================= */

      else if (category === "region") {

        const trekRegions =
          getTrekValues(
            trek.region
          );


        const matches =
          [...selectedOptions].some(
            option =>
              trekRegions.includes(
                option
              )
          );


        if (!matches) {
          return false;
        }
      }


      /* =========================
         OTHER FILTERS
      ========================= */

      else {

        const trekValue =
          String(
            trek[category] ?? ""
          ).toLowerCase();


        if (
          !selectedOptions.has(
            trekValue
          )
        ) {
          return false;
        }
      }

    }


    return true;
  }


  /* =========================
     URL PARAMETERS
  ========================= */

  const urlParams =
    new URLSearchParams(
      window.location.search
    );


  /* =========================
     APPLY URL FILTERS
  ========================= */

  function applyUrlFilters() {

    const allCheckboxes = [
      ...desktopCheckboxes,
      ...modalCheckboxes
    ];


    allCheckboxes.forEach(cb => {

      let urlValue =
        urlParams.get(cb.name);


      /*
       * Backwards compatibility:
       *
       * Old experience links used:
       * ?tag=beginner
       *
       * New filter uses:
       * ?experience=beginner
       *
       * We support both.
       */

      if (
        cb.name === "experience" &&
        !urlValue
      ) {

        urlValue =
          urlParams.get("tag");
      }


      if (!urlValue) return;


      /*
       * Also allow comma-separated
       * URL values in the future.
       */

      const values =
        urlValue
          .split(",")
          .map(value =>
            value.trim().toLowerCase()
          );


      if (
        values.includes(
          cb.value.toLowerCase()
        )
      ) {

        cb.checked = true;
      }

    });
  }


  /* =========================
     FILTER TREK CARDS
  ========================= */

  function filterTrekCards(shouldScroll = false) {

  const filters =
    getSelectedFilters();

  const hasActiveFilters =
    Object.keys(filters).length > 0;


  /* =========================
     SHOW / HIDE TREK CARDS
  ========================= */

  trekCards.forEach(card => {

    const trekId =
      card.getAttribute("data-trek-id");

    const trek =
      trekData.find(
        item => item.id === trekId
      );

    if (!trek) return;

    const shouldShow =
      !hasActiveFilters ||
      trekMatchesFilters(
        trek,
        filters
      );

    card.classList.toggle(
      "show",
      shouldShow
    );

    card.classList.toggle(
      "hide",
      !shouldShow
    );

  });


  /* =========================
     PAGE STATE
  ========================= */

  if (mainContent) {

    mainContent.classList.toggle(
      "filter-active",
      hasActiveFilters
    );

  }


 /* =========================
   RESULTS HEADING
========================= */

if (trekResultsTitle) {

  let resultsTitle = "Explore All Treks";

  if (hasActiveFilters) {

    const activeCategories = Object.keys(filters);

    const totalSelectedOptions = activeCategories.reduce(
      (total, category) => total + filters[category].size,
      0
    );

    /*
     * Show a specific title when exactly
     * ONE filter option is selected.
     */
    if (
      activeCategories.length === 1 &&
      totalSelectedOptions === 1
    ) {

      const category = activeCategories[0];
      const value = [...filters[category]][0];

      /* EXPERIENCE */
      if (category === "experience") {

        const experienceNames = {
          beginner: "Beginner Treks",
          intermediate: "Intermediate Treks",
          pro: "Pro Treks"
        };

        resultsTitle =
          experienceNames[value] ||
          `${toTitleCase(value)} Treks`;
      }

      /* DIFFICULTY */
      else if (category === "difficulty") {

        const difficultyNames = {
          easy: "Easy Treks",
          moderate: "Moderate Treks",
          difficult: "Difficult Treks"
        };

        resultsTitle =
          difficultyNames[value] ||
          `${toTitleCase(value)} Treks`;
      }

      /* REGION */
      else if (category === "region") {

        const regionNames = {
          "kashmir": "Kashmir Treks",
          "ladakh": "Ladakh Treks",
          "uttarakhand-garhwal": "Uttarakhand Garhwal Treks",
          "uttarakhand-kumaon": "Uttarakhand Kumaon Treks",
          "himachal pradesh": "Himachal Pradesh Treks",
          "sikkim": "Sikkim Treks",
          "west bengal": "West Bengal Treks"
        };

        resultsTitle =
          regionNames[value] ||
          `${toTitleCase(value)} Treks`;
      }

      /* SEASON */
      else if (category === "season") {

        const seasonNames = {
          spring: "Spring Treks",
          summer: "Summer Treks",
          monsoon: "Monsoon Treks",
          autumn: "Autumn Treks",
          winter: "Winter Treks"
        };

        resultsTitle =
          seasonNames[value] ||
          `${toTitleCase(value)} Treks`;
      }

      /* MONTH */
      else if (category === "month") {

        const monthNames = {
          january: "January Treks",
          february: "February Treks",
          march: "March Treks",
          april: "April Treks",
          may: "May Treks",
          june: "June Treks",
          july: "July Treks",
          august: "August Treks",
          september: "September Treks",
          october: "October Treks",
          november: "November Treks",
          december: "December Treks"
        };

        resultsTitle =
          monthNames[value] ||
          `${toTitleCase(value)} Treks`;
      }

      /* DAYS */
      else if (category === "days") {

        resultsTitle = `${value}-Day Treks`;
      }

    } else {

      /*
       * More than one filter option/category selected
       */
      resultsTitle = "Selected Treks";
    }
  }

  trekResultsTitle.textContent = resultsTitle;
}


  /* =========================
     SCROLL TO TOP ONLY WHEN
     FILTER IS ACTIVELY APPLIED
  ========================= */

  if (
    shouldScroll &&
    hasActiveFilters &&
    mainContent
  ) {

    mainContent.scrollTo({
      top: 0,
      behavior: "instant"
    });

  }

}


  /* =========================
     CHECKBOX SYNC
  ========================= */

  function syncCheckboxes(
    sourceList,
    targetList
  ) {

    sourceList.forEach(sourceCb => {

      sourceCb.addEventListener(
        "change",
        () => {

          const matchingCheckbox =
            targetList.find(
              targetCb =>
                targetCb.name ===
                  sourceCb.name &&
                targetCb.value ===
                  sourceCb.value
            );


          if (matchingCheckbox) {

            matchingCheckbox.checked =
              sourceCb.checked;

          }


          /*
           * If the user manually selects
           * a filter, update the URL so
           * the current state is preserved.
           */

          updateFilterUrl();


          /*
           * If selecting a filter on
           * desktop/mobile, reveal the
           * filtered trek catalogue.
           */

          filterTrekCards(true);

        }
      );

    });

  }


  /* =========================
     UPDATE FILTER URL
  ========================= */

  function updateFilterUrl() {

    const filters =
      getSelectedFilters();


    const params =
      new URLSearchParams();


    Object.entries(filters).forEach(
      ([category, values]) => {

        params.set(
          category,
          [...values].join(",")
        );

      }
    );


    const newUrl =
      params.toString()
        ? `${window.location.pathname}?${params.toString()}`
        : window.location.pathname;


    window.history.replaceState(
      null,
      "",
      newUrl
    );

  }


  /* =========================
     DESKTOP / MOBILE SYNC
  ========================= */

  syncCheckboxes(
    desktopCheckboxes,
    modalCheckboxes
  );


  syncCheckboxes(
    modalCheckboxes,
    desktopCheckboxes
  );


  /* =========================
     BACK TO ALL TREKS
  ========================= */

  if (trekResultsBack) {

    trekResultsBack.addEventListener(
      "click",
      () => {

        /*
         * Uncheck every filter on
         * both desktop and mobile.
         */

        [
          ...desktopCheckboxes,
          ...modalCheckboxes
        ].forEach(cb => {

          cb.checked = false;

        });


        /*
         * Remove filter parameters
         * from the URL.
         */

        window.history.replaceState(
          null,
          "",
          window.location.pathname
        );


        /*
         * Restore every trek card
         * and every section above it.
         */

        filterTrekCards(false);


        /*
         * Return the right content
         * pane to its normal top.
         */

        if (mainContent) {

          setTimeout(() => {

            mainContent.scrollTo({
              top: 0,
              behavior: "smooth"
            });

          }, 50);

        }

      }
    );

  }


  /* =========================
     MOBILE FILTER MODAL
  ========================= */

  const openBtn =
    document.getElementById(
      "openFilterBtn"
    );


  const closeBtn =
    document.getElementById(
      "closeFilterBtn"
    );


  const filterModal =
    document.getElementById(
      "filterModal"
    );


  if (
    openBtn &&
    closeBtn &&
    filterModal
  ) {

    openBtn.addEventListener(
      "click",
      () => {

        filterModal.classList.add(
          "open"
        );


        document.body.style.overflow =
          "hidden";

      }
    );


    closeBtn.addEventListener(
      "click",
      () => {

        filterModal.classList.remove(
          "open"
        );


        document.body.style.overflow =
          "";

      }
    );


    filterModal.addEventListener(
      "click",
      event => {

        if (
          event.target ===
          filterModal
        ) {

          filterModal.classList.remove(
            "open"
          );


          document.body.style.overflow =
            "";

        }

      }
    );

  }


  /* =========================
     INITIALISE
  ========================= */

  applyUrlFilters();


  /*
   * Do NOT smooth-scroll on initial
   * page load.
   *
   * If somebody opens a filtered URL,
   * the filtered catalogue is simply
   * shown.
   */

  filterTrekCards(false);

});
</script>
</Layout>
