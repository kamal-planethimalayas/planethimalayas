  color: #ff7300;
  font-family: Helvetica, Arial, sans-serif;
  font-size: 1.8rem;
  font-weight: 700;
  line-height: 1.3;
}

/* Seven compact thumbnails on desktop */
.trek-guides-grid {
  display: grid;
  grid-template-columns: repeat(7, minmax(0, 1fr));
  gap: 0.65rem;
  width: 100%;
  min-width: 0;
  align-items: start;
}

/* Entire thumbnail and title are clickable */
.trek-guide-link {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-start;
  gap: 0.45rem;

  width: 100%;
  min-width: 0;
  max-width: 100%;

