---
import Layout from "../layouts/Layout.astro";
---

<Layout>

  <!-- Hero Section -->
  <section class="contact-hero reveal">
  <div class="contact-hero-overlay"></div>
    <div class="container">
      <h1>Let's Talk Treks</h1>
      <p>We'd love to hear from you! Whether you're planning your next trek or just have a question, feel free to reach out — we respond within 48 hours.</p>
    </div>
  </section>

  <!-- Contact Info Cards -->
  <section class="contact-cards reveal">
    <div class="container">
      <div class="card">
        <h3>Call Us</h3>
        <p><a href="tel:+919007210399">+91 9007210399</a></p>
        <p><a href="tel:+919027481187">+91 9027481187</a></p>
      </div>
      <div class="card">
        <h3>Email</h3>
        <p><a href="info@planethimalayas.com">info@planethimalayas.com</a></p>
      </div>
    </div>
  </section>

  <!-- Contact Form -->
  <section class="contact-form-section reveal">
  <div class="container">
    <h2>Leave a message</h2>
    <form class="contact-form" id="contactForm" action="https://formspree.io/f/xrbldkrb" method="POST">
      <div class="form-group">
        <label for="name">Name</label>
        <input type="text" id="name" name="name" placeholder="Your Name here..." required />
      </div>
      <div class="form-group">
        <label for="email">Email</label>
        <input type="email" id="email" name="email" placeholder="Your Email here..." required />
      </div>
      <div class="form-group">
        <label for="message">Message</label>
        <textarea id="message" name="message" placeholder="Type your message here..." rows="5" required></textarea>
      </div>
      <button type="submit" class="btn-submit">Send Message</button>
    </form>
  </div>
</section>

<!-- Modal -->
<div id="thankYouModal" class="modal">
  <div class="modal-content">
    <span class="modal-close">&times;</span>
    <h3>Thank You!</h3>
    <p>Thank you for taking the time to fill this form. We will get back to you within 48 hours. Meanwhile, you might like to:</p>
    <div class="modal-buttons">
      <a href="/upcoming-treks" class="modal-btn">Explore Our Treks</a>
      <a href="/faqs-and-articles" class="modal-btn">Read Our FAQs</a>
    </div>
  </div>
</div>


<style>

    /* Hero */
.contact-hero {
  width: 100%;
  height: 100vh;
  background: url('/images/main/about-hero1.jpg') center 60% no-repeat;
  background-size: cover; /* stretches to full width, crops if needed */
  display: flex;
  flex-direction: column;
  justify-content: flex-start;   /* content starts from left */
  align-items: center;           /* vertical center */
  padding: 2rem 2rem;
  color: #fff;
  position: relative; 
}

.contact-hero-overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(
    rgba(0, 0, 0, 0.45),
    rgba(0, 0, 0, 0.45)
  );
}

.contact-hero .container {
  display: flex;
  flex-direction: column;
  justify-content: center;
  will-change: transform;
  transition: transform 0.1s linear;
}

.contact-hero h1 {
  font-family: Helvetica, Arial, sans-serif;
  color: white;
  font-size: 3rem;
  margin-bottom: 1rem;
  text-shadow:  3px 3px 6px rgba(0, 0, 0, 0.7),
    6px 6px 12px rgba(0, 0, 0, 0.5),
    0 0 10px rgba(0, 0, 0, 0.3);
}

.contact-hero p {
  font-family: Roboto, sans-serif;
  font-size: 1.5rem;
  text-shadow: 2px 2px 5px rgba(0, 0, 0, 0.7),
    4px 4px 10px rgba(0, 0, 0, 0.5),
    0 0 8px rgba(0, 0, 0, 0.3);
  max-width: 1200px;
}

    /* Contact Info Cards */
/* Container for contact cards */
.contact-cards .container {
  display: flex;
  flex-wrap: wrap; /* Allows wrapping on very small screens */
  gap: 16px; /* Space between cards */
  width: 100%;
  padding: 1.5rem;
  box-sizing: border-box;
}

/* Individual cards */
.contact-cards .card {
  flex: 1 1 45%;
  min-width: 250px;
  background-color: #111; /* as before */
  border-radius: 10px;
  padding: 1rem;
  text-align: center;
  box-shadow: 
    0 4px 12px rgba(255, 115, 0, 0.45),
    0 0 8px rgba(255, 115, 0, 0.3); /* brand glow restored */
  box-sizing: border-box;
  transition: transform 0.3s ease, box-shadow 0.3s ease;
}

/* Hover → lift + stronger brand glow */
.contact-cards .card:hover {
  transform: translateY(-8px);
  box-shadow: 
    0 8px 25px rgba(255, 115, 0, 0.75),
    0 0 20px rgba(255, 115, 0, 0.8); /* bright brand glow */
}

/* Card headings */
.contact-cards .card h3 {
  font-family: Helvetica, Arial, sans-serif;
  font-size: 1.5rem;
  margin-bottom: 15px;
  color: #ff7300; /* brand color */
}

/* Card links */
.contact-cards .card a {
  text-decoration: none;
  color: #fff; /* original */
  font-weight: bold;
  display: block;
  margin-bottom: 8px;
  transition: color 0.3s ease;
}

/* Hover – brand color (original behavior) */
.contact-cards .card a:hover {
  color: #ff7300;
}

    /* Form Section */
/* Contact Form Section */
.contact-form-section {
  padding: 16px;
  background-color: #f9f9f9;
  width: 100%;
  box-sizing: border-box;
}

/* Container to hold form */
.contact-form-section .container {
  width: 100%;
  margin-top: 16px;
  margin-bottom: 16px;
}

/* Form Heading */
.contact-form-section h2 {
  font-family: Helvetica, Arial, sans-serif;
  font-size: 2rem;
  color: #ff7300;
  margin-bottom: 30px;
  text-align: left;
}

/* Form Styling */
.contact-form {
  width: 100%;
  text-align: left;
}

.contact-form .form-group {
  margin-bottom: 16px;
}

.contact-form label {
  display: block;
  font-weight: bold;
  margin-bottom: 8px;
  font-family: Roboto, sans-serif;
}

.contact-form input,
.contact-form textarea {
  width: 100%;
  padding: 12px 15px;
  border: 1px solid #ccc;
  border-radius: 6px;
  font-size: 1rem;
  font-family: Roboto, sans-serif;
  box-sizing: border-box;
  transition: border 0.3s ease;
}

.contact-form input:focus,
.contact-form textarea:focus {
  outline: none;
  border-color: #ff7300;
}

/* Submit Button */
.contact-form .btn-submit {
  padding: 12px 25px;
  background-color: #ff7300;
  color: #fff;
  border: none;
  border-radius: 6px;
  font-size: 1rem;
  font-family: Roboto, sans-serif;
  cursor: pointer;
  transition: background 0.3s ease;
}

.contact-form .btn-submit:hover {
  background-color: #e66000;
}

/* Modal */
/* Modal - hidden by default */
#thankYouModal {
  display: none; /* HIDDEN initially */
  position: fixed; 
  z-index: 9999; 
  left: 0;
  top: 0;
  width: 100%; 
  height: 100%; 
  overflow: auto; 
  background-color: rgba(0,0,0,0.5);
}

#thankYouModal .modal-content {
  background-color: #fff;
  margin: 10% auto; 
  padding: 30px;
  border-radius: 10px;
  max-width: 500px;
  text-align: center;
  position: relative;
  box-shadow: 0 5px 20px rgba(0,0,0,0.3);
}

#thankYouModal .modal-close {
  position: absolute;
  right: 20px;
  top: 15px;
  font-size: 1rem;
  cursor: pointer;
  color: #ff7300;
}

#thankYouModal .modal-buttons {
  margin-top: 20px;
  display: flex;
  justify-content: center;
  gap: 15px;
  flex-wrap: wrap;
}

#thankYouModal .modal-btn {
  padding: 10px 20px;
  background-color: #ff7300;
  color: #fff;
  border-radius: 6px;
  text-decoration: none;
  font-weight: bold;
  transition: background 0.3s ease;
}

#thankYouModal .modal-btn:hover {
  background-color: #e66000;
}

@media (max-width: 768px) {

  /* Hero Section */
  .contact-hero {
    height: 70vh;
    padding: 1rem 1rem;
    margin-top: -55px;
  }

  .contact-hero h1 {
    font-size: 2rem; 
  }


   .contact-hero p {
    font-size: 1rem;
  }

  /* Contact Info Cards */
  .contact-cards .container {
    flex-direction: column;
    gap: 1rem;
    max-width: 100%;
    padding: 1.5rem;
  }

  .contact-cards .card {
    flex: 1 1 100%; /* full width on mobile */
    min-width: auto;
    padding: 1rem;
  }

  /* Contact Form Section */
  .contact-form-section .container {
    max-width: 100%;
    padding: 0.5rem 0.5rem;
    
  }

  .contact-form-section h2 {
    font-size: 1.75rem;
    text-align: center;
  }

  .contact-form .form-group {
    margin-bottom: 15px;
  }

  .contact-form input,
  .contact-form textarea {
    font-size: 0.95rem;
  }

  .contact-form .btn-submit {
    width: 100%;
    padding: 12px;
  }

  /* Modal adjustments */
  #thankYouModal .modal-content {
    margin: 15% auto;
    padding: 20px;
    max-width: 90%;
  }

  #thankYouModal .modal-buttons {
    flex-direction: column;
    gap: 10px;
  }

  #thankYouModal .modal-btn {
    width: 100%;
    padding: 12px;
  }
}

 </style>


<script>
const form = document.getElementById('contactForm');
const modal = document.getElementById('thankYouModal');
const closeBtn = document.querySelector('.modal-close');

form.addEventListener('submit', function(e) {
  e.preventDefault(); // Prevent default page reload

  const action = form.action;
  const formData = new FormData(form);

  // Submit the form using fetch
  fetch(action, {
    method: "POST",
    body: formData,
    headers: { 'Accept': 'application/json' }
  }).then(response => {
    if (response.ok) {
      // Show modal
      modal.style.display = 'block';
      form.reset(); // Clear fields
    } else {
      alert("Oops! There was a problem submitting your form.");
    }
  }).catch(err => {
    alert("Oops! There was a problem submitting your form.");
  });
});

// Close modal
closeBtn.addEventListener('click', () => { modal.style.display = 'none'; });
window.addEventListener('click', (e) => { if (e.target === modal) modal.style.display = 'none'; });

</script>

<script>
const heroContainer = document.querySelector(".contact-hero .container");
const hero = document.querySelector(".contact-hero");

window.addEventListener("scroll", () => {
  const heroRect = hero.getBoundingClientRect();
  const scrollY = window.scrollY;

  if (heroRect.bottom > 0) {
    let move = scrollY * 0.5;                
    const maxMove = hero.offsetHeight / 2;

    heroContainer.style.transform = `translateY(${move}px)`;
  }
});
</script>

</Layout>
