  .trek-overview-card ul {
    grid-template-columns: repeat(3, 1fr);
  }
}

/* =========================
   PRICING + SNIPPET WRAPPER
========================= */
.pricing-and-snippet {
  display: flex;
  flex-direction: row;
  align-items: flex-start; /* align top of boxes */
  gap: 2rem; /* spacing between pricing & snippet */
  margin-top: 2rem;       /* spacing from above section */
  margin-bottom: 2rem;
}

/* ===== PRICE BOX ===== */
.price-box {
  flex: 0 0 40%;          /* 30% width on desktop */
  border: 2px solid #222;
  border-left: 8px solid #ff7300;
  padding: 24px;
  border-radius: 8px;
  box-shadow: 2px 6px 15px rgba(0, 0, 0, 0.8);
  box-sizing: border-box;
}

/* ===== SNIPPET ===== */
.trek-overview-snippet {
  flex: 1 1 60%;           /* 70% width on desktop */
  position: relative;
  overflow: hidden;
  max-height: 420px;       /* collapsed height */
  transition: max-height 0.4s ease;
  font-size: 1rem;
  line-height: 1.6;
  margin: 0;               /* remove previous margins */
  padding-left: 0;         /* optional, adjust if needed */
  padding-right: 0;        /* optional, adjust if needed */
}

/* Expanded snippet state */
.trek-overview-snippet.expanded {
  max-height: none;
}
.trek-overview-snippet.expanded::after {
  opacity: 0;
}

/* Read More text link */
.read-more-link {
  display: block;             /* ensures it sits below snippet */
  margin-top: 0.5rem;
  font-weight: bold;
  color: #ff7300;             /* brand color */
  cursor: pointer;
  text-decoration: underline;
  font-size: 1rem;
}

.read-more-link:hover {
  opacity: 0.8;
}

/* =========================
   MOBILE VIEW
========================= */
@media (max-width: 768px) {
  .pricing-and-snippet {
    flex-direction: column;
    gap: 1.5rem;             /* smaller gap on mobile */
  }

  .price-box,
  .trek-overview-snippet {
    flex: 1 1 100%;          /* full width on mobile */
  }
}

