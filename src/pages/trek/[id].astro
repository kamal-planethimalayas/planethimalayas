
---
import Layout from '../../layouts/Layout.astro';
import { treks } from '../../data/treksData.js';
import { trekFAQs } from '../../data/faqsData.js';
import TrekMap from "../../components/TrekMap.jsx";
import TrekDateSlots from "../../components/TrekDateSlots.jsx";

export async function getStaticPaths() {
  return treks.map((trek) => ({
    params: { id: trek.id }
  }));
}

const { id } = Astro.params;
const trek = treks.find(t => t.id === id);

const trekNotFound = !trek;

// Serialize only the needed parts for JS
const trekForScript = {
  id: trek.id,
  name: trek.name,
  price: trek.price,
  dates: trek.dates,
};

const groupedDates = trek.dates.reduce((acc, d) => {
  const dateObj = new Date(d.start);
  const monthYear = dateObj.toLocaleString("default", {
    month: "long",
    year: "numeric",
  });

  if (!acc[monthYear]) acc[monthYear] = [];
  acc[monthYear].push(d);

  return acc;
}, {});

