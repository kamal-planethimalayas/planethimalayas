<section id="similar-treks" class="similar-treks-section reveal">
  <h2 class="similar-treks-heading">
    Similar <span>Treks</span>
  </h2>

  <div class="similar-treks-wrapper">
    <button class="scroll-btn left" aria-label="Scroll left">❮</button>

    <div class="trek-cards-container similar-treks-row" id="similarTreksRow">
      {treks
        .filter(t => t.id !== trek.id)
        .map(t => {
          let score = 0;

          // Tags
          const tagMatches =
            t.tags?.filter(tag => trek.tags?.includes(tag)).length || 0;
          score += tagMatches * 2;

          // Season
          const seasonMatches =
            t.season?.filter(s => trek.season?.includes(s)).length || 0;
          score += seasonMatches;

          // Difficulty
          if (t.difficulty?.some(d => trek.difficulty?.includes(d))) {
            score += 1;
          }

          // Region
          if (t.region === trek.region) score += 2;

          return { ...t, score };
        })
        .filter(t => t.score >= 3)
        .sort((a, b) => b.score - a.score)
        .slice(0, 8)
        .map(similarTrek => (
          <div class="trek-card show" data-trek-id={similarTrek.id}>
            <a href={`/trek/${similarTrek.id}#trek-hero`}>
              <img
                src={similarTrek.heroImage}
                alt={`View of ${similarTrek.name} trek`}
                loading="lazy"
              />
              <span class="trek-difficulty">
                {Array.isArray(similarTrek.difficulty)
                  ? similarTrek.difficulty.join(", ")
                  : similarTrek.difficulty}
              </span>
            </a>

            <h3 class="trek-name">{similarTrek.name}</h3>

            <div class="trek-info">
              <div class="trek-duration">
                <i class="fa fa-clock"></i> {similarTrek.duration}
              </div>

              <div class="trek-region">
                <i class="fa fa-map-marker-alt"></i>{" "}
                {similarTrek.region}
              </div>
            </div>

            <div class="trek-buttons">
              <a
                href={`/trek/${similarTrek.id}#trek-overview-section`}
                class="btn btn-details"
              >
                View Details
              </a>
              <a
                href={`/trek/${similarTrek.id}#pricing-snippet-wrapper`}
                class="btn btn-dates"
              >
                View Dates
              </a>
            </div>
          </div>
        ))}
    </div>

