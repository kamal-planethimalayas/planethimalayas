<script>
document.addEventListener("DOMContentLoaded", () => {
  const section = document.querySelector(".trek-hero-3d");
  if (!section) return;

  const cube = section.querySelector(".cube");
  const slides = section.querySelectorAll(".carousel-3d-slide");
  const dotsContainer = section.querySelector(".carousel-dots");
  const prevBtn = section.querySelector(".carousel-arrow.prev");
  const nextBtn = section.querySelector(".carousel-arrow.next");

  const total = slides.length;
  let index = 0;
  let autoTimer;
  const delay = 4000;

  /* -------------------------
        BUILD DOTS
  ------------------------- */
  dotsContainer.innerHTML = "";
  for (let i = 0; i < total; i++) {
    const dot = document.createElement("button");
    if (i === 0) dot.classList.add("active");
    dotsContainer.appendChild(dot);
  }
  const dots = dotsContainer.querySelectorAll("button");

  /* -------------------------
       ROTATE CUBE FUNCTION
  ------------------------- */
  function rotateCube(i) {
    index = (i + total) % total;
    cube.style.transform = `rotateY(${index * -90}deg)`;

    dots.forEach((dot, d) => {
      dot.classList.toggle("active", d === index);
    });
  }

  /* -------------------------
         AUTOPLAY
  ------------------------- */
  function startAuto() {
    clearTimeout(autoTimer);
    autoTimer = setTimeout(() => {
      rotateCube(index + 1);
      startAuto();
    }, delay);
  }

  /* -------------------------
         BUTTONS
  ------------------------- */
  nextBtn.addEventListener("click", () => {
    rotateCube(index + 1);
    startAuto();
  });

  prevBtn.addEventListener("click", () => {
    rotateCube(index - 1);
    startAuto();
  });

  /* -------------------------
         DOTS CLICK
  ------------------------- */
  dots.forEach((dot, i) => {
    dot.addEventListener("click", () => {
      rotateCube(i);
      startAuto();
    });
  });

  /* -------------------------
         SWIPE SUPPORT
  ------------------------- */
  let startX = 0;
  let startY = 0;
  let isMoving = false;

  section.addEventListener("touchstart", (e) => {
    if (!e.touches[0]) return;
    startX = e.touches[0].clientX;
    startY = e.touches[0].clientY;
    isMoving = true;
  });

  section.addEventListener("touchmove", (e) => {
    if (!isMoving) return;
    let diffX = e.touches[0].clientX - startX;
    let diffY = e.touches[0].clientY - startY;

    // if vertical scroll, ignore
    if (Math.abs(diffY) > Math.abs(diffX)) return;

    e.preventDefault(); // smooth swipe
  }, { passive: false });

  section.addEventListener("touchend", (e) => {
    if (!isMoving) return;
    isMoving = false;

    let diffX = e.changedTouches[0].clientX - startX;

    if (Math.abs(diffX) > 50) {
      if (diffX < 0) nextBtn.click();  // swipe left
      else prevBtn.click();           // swipe right
    }
  });

  /* -------------------------
         INIT
  ------------------------- */
  rotateCube(0);
  startAuto();
});
</script>

<script>
function initReadMore() {
  const snippet = document.querySelector('.trek-overview-snippet');
  const priceBox = document.querySelector('.price-box');
  const readMore = document.querySelector('.read-more-link');

  if (!snippet || !readMore || !priceBox) return;

  // Measure after layout is fully applied
  requestAnimationFrame(() => {
    const snippetHeight = Math.ceil(snippet.scrollHeight);
    const priceHeight = Math.ceil(priceBox.clientHeight);

    if (snippetHeight <= priceHeight) {
      readMore.style.display = 'none';
      snippet.style.maxHeight = 'none';
    } else {
      readMore.style.display = 'inline-block';
      snippet.style.maxHeight = priceHeight + 'px';
      snippet.style.overflow = 'hidden';
    }
  });

  readMore.addEventListener('click', () => {
    const isExpanded = snippet.classList.toggle('expanded');
    if (isExpanded) {
      snippet.style.maxHeight = 'none';
      readMore.textContent = 'Read Less';
    } else {
      snippet.style.maxHeight = priceBox.clientHeight + 'px';
      readMore.textContent = 'Read More';
    }
  });
}

// Use DOMContentLoaded and a small timeout to ensure dynamic HTML has rendered
window.addEventListener('DOMContentLoaded', () => {
  setTimeout(initReadMore, 50); // 50ms delay ensures HTML is rendered
});
</script>

