/* Trek Overview – underline only the <span> */
.trek-overview-title {
  font-family: 'Helvetica', sans-serif;
  font-size: 2.5rem;
  font-weight: 700;
  color: #000;
  position: relative;
  margin-bottom: 2rem;
}

.trek-overview-title span {
  position: relative;
  color: #ff7300; /* brand color */
}

.trek-overview-title span::after {
  content: "";
  position: absolute;
  left: 0;
  bottom: -6px;
  width: 100%;
  height: 4px;
  background-color: #ff7300;
  border-radius: 2px;
}

/* Facts cards */
.trek-overview-card {
  background: none;
  border: none;
  border-radius: 0;
  padding: 0;
  margin: 0 0 0.5rem 0; /* small vertical spacing between blocks */
  box-shadow: none;
}

.trek-overview-section.reveal h2 span {
  color: #ff7300;
}

.trek-overview-card ul {
  list-style: none;
  margin: 0;
  padding: 0;
  display: grid;
  grid-template-columns: 1fr; /* stacked on mobile */
  gap: 0.5rem; /* spacing between li cards */
}

.trek-overview-card li {
  position: relative;
  background: #ff7300;
  border-radius: 8px;
  border: 2px solid #ff7300;
  display: flex;
  align-items: flex-start;
  gap: 8px;

  font-size: 1rem;
  line-height: 1.6;
  padding: 1rem;

  /* Physical elevation (controlled, readable) */
  box-shadow:
  inset 0 1px 1px rgba(255, 255, 255, 0.35),   /* softer inner highlight */
  0 8px 22px rgba(0, 0, 0, 0.28),              /* main lift (reduced depth) */
  0 0 18px rgba(255, 115, 0, 0.55),            /* controlled glow */
  0 0 36px rgba(255, 115, 0, 0.35);            /* soft ambient spread */

}

/* Desktop: 3 items per row */
@media screen and (min-width: 1024px) {
  .trek-overview-card ul {
    grid-template-columns: repeat(3, 1fr);
  }
}

/* =========================
   PRICING + SNIPPET WRAPPER
========================= */
.pricing-and-snippet {
  display: flex;
  flex-direction: row;
  align-items: flex-start; /* align top of boxes */
  gap: 2rem; /* spacing between pricing & snippet */
  margin-top: 2rem;       /* spacing from above section */
}

/* ===== PRICE BOX ===== */
.price-box {
  flex: 0 0 40%;          /* 30% width on desktop */
  border: 2px solid #222;
  border-left: 8px solid #ff7300;
  padding: 24px;
  border-radius: 8px;
  box-shadow: 2px 6px 15px rgba(0, 0, 0, 0.8);
  box-sizing: border-box;
}

/* ===== SNIPPET ===== */
.trek-overview-snippet {
  flex: 1 1 60%;           /* 70% width on desktop */
  position: relative;
  overflow: hidden;
  max-height: 420px;       /* collapsed height */
  transition: max-height 0.4s ease;
  font-size: 1rem;
  line-height: 1.6;
  margin: 0;               /* remove previous margins */
  padding-left: 0;         /* optional, adjust if needed */
  padding-right: 0;        /* optional, adjust if needed */
}

/* Expanded snippet state */
.trek-overview-snippet.expanded {
  max-height: none;
}
.trek-overview-snippet.expanded::after {
  opacity: 0;
}

/* Read More text link */
.read-more-link {
  display: block;             /* ensures it sits below snippet */
  margin-top: 0.5rem;
  font-weight: bold;
  color: #ff7300;             /* brand color */
  cursor: pointer;
  text-decoration: underline;
  font-size: 1rem;
}

.read-more-link:hover {
  opacity: 0.8;
}

/* =========================
   MOBILE VIEW
========================= */
@media (max-width: 768px) {
  .pricing-and-snippet {
    flex-direction: column;
    gap: 1.5rem;             /* smaller gap on mobile */
  }

  .price-box,
  .trek-overview-snippet {
    flex: 1 1 100%;          /* full width on mobile */
  }
}

/* ==================================================
   SIMILAR TREKS SECTION
================================================== */

.similar-treks-section {
  padding: 2rem 0;
  position: relative;
}

/* Heading */
.similar-treks-heading {
  font-family: Helvetica, Arial, sans-serif;
  font-size: 2.5rem;
  font-weight: 700;
  color: #000;
}

.similar-treks-heading span {
  color: #ff7300;
  position: relative;
}

.similar-treks-heading span::after {
  content: "";
  position: absolute;
  left: 0;
  bottom: -6px;
  width: 100%;
  height: 4px;
  background: #ff7300;
  border-radius: 2px;
}

/* ==================================================
   WRAPPER + SCROLL
================================================== */

.similar-treks-wrapper {
  position: relative;
  display: flex;
  align-items: center;
}

/* Horizontal scroll row */
.similar-treks-row {
  display: flex;
  gap: 1.6rem;
  overflow-x: auto;
  scroll-behavior: smooth;
  padding: 2rem 0;
  scrollbar-width: none;
}

.similar-treks-row::-webkit-scrollbar {
  display: none;
}

/* ==================================================
   TREK CARD (SIMILAR VARIANT)
   Uses SAME markup as main trek cards
================================================== */

.similar-treks-row .trek-card {
  flex: 0 0 280px;
  max-width: 280px;
  min-height: 320px;

  background: #121316;
  border-radius: 12px;
  border: 2px solid #ff7300;
  overflow: hidden;

  box-shadow:
    0 4px 12px rgba(255, 115, 0, 0.45),
    0 0 10px rgba(255, 115, 0, 0.3);
  text-align: center;
  transition: transform 0.3s ease, box-shadow 0.3s ease;
}

/* Hover – subtle lift (no aggressive 3D) */
.similar-treks-row .trek-card:hover {
  transform: translateY(-6px);
  box-shadow:
    0 8px 25px rgba(255, 115, 0, 0.8),
    0 0 22px rgba(255, 115, 0, 1); /* bright brand orange glow */
}

/* ==================================================
   IMAGE
================================================== */

.similar-treks-row .trek-card a {
  position: relative;
  display: block;
}

.similar-treks-row .trek-card img {
  width: 100%;
  height: 180px;
  object-fit: cover;
  transform: scale(1.03);
  transition: transform 1.1s cubic-bezier(0.22, 1, 0.36, 1);
}

.similar-treks-row .trek-card:hover img {
  transform: scale(1.12);
}

/* Difficulty badge */
.similar-treks-row .trek-difficulty {
  position: absolute;
  top: 10px;
  left: 10px;
  background: rgba(255,115,0,0.95);
  color: #000;
  padding: 4px 10px;
  font-size: 0.75rem;
  font-weight: 600;
  border-radius: 6px;
  backdrop-filter: blur(3px);
}

/* ==================================================
   TEXT CONTENT
================================================== */

.similar-treks-row .trek-name {
  font-size: 1.2rem;
  font-weight: 700;
  margin: 0.9rem 1rem 0.5rem;
  text-align: center;
  color: #ff7300;
}

.similar-treks-row .trek-info {
  text-align: center;
  font-size: 0.9rem;
  color: #fff;
  opacity: 0.9;
  margin-bottom: 0.8rem;
}

.similar-treks-row .trek-info div {
  margin-bottom: 4px;
}

/* ==================================================
   CTA BUTTONS (COMPACT)
================================================== */

.similar-treks-row .trek-buttons {
  margin-top: auto;
  padding-bottom: 1rem;
  display: flex;
  justify-content: center;
  gap: 0.7rem;
}

.similar-treks-row .trek-buttons a.btn {
  position: relative;

  font-size: 0.75rem;
  padding: 0.45rem 1rem;
  border-radius: 6px;
  border: 1.5px solid #ff7300;

  color: #ff7300;
  background: rgba(0, 0, 0, 0.75);
backdrop-filter: blur(15px);
-webkit-backdrop-filter: blur(15px);

  text-decoration: none;

  /* Calm resting elevation */
  box-shadow:
    inset 0 1px 1px rgba(255, 255, 255, 0.25),
    0 4px 10px rgba(0, 0, 0, 0.25),
    0 0 6px rgba(255, 115, 0, 0.25);

  transition:
    background 0.25s ease,
    color 0.25s ease,
    box-shadow 0.25s ease,
    transform 0.25s ease;
}

/* Subtle glass surface */
.similar-treks-row .trek-buttons a.btn::before {
  content: "";
  position: absolute;
  inset: 0;
  border-radius: inherit;

  background: linear-gradient(
    135deg,
    rgba(255, 255, 255, 0.35),
    rgba(255, 255, 255, 0.05)
  );

  opacity: 0.35;
  pointer-events: none;
}

.similar-treks-row .trek-buttons a.btn:hover {
  background: #ff7300;
  color: #000;

  /* “Powered on” state — tighter + brighter */
  box-shadow:
    inset 0 1px 1px rgba(255, 255, 255, 0.45),
    0 6px 14px rgba(0, 0, 0, 0.35),
    0 0 14px rgba(255, 115, 0, 0.85);

  transform: translateY(-2px);
}

/* ---------------------------------------
   SCROLL BUTTONS
----------------------------------------- */

.scroll-btn {
  position: absolute;
  top: 50%;
  transform: translateY(-50%);
  width: 40px;
  height: 40px;
  border: none;
  border-radius: 50%;
  cursor: pointer;
  border: 2px solid #ff7300;
  display: flex;
  align-items: center;
  justify-content: center;

  color: #ff7300;
  font-size: 20px;
  font-weight: bold;
  z-index: 20;

  /* glass base */
  background: rgba(0, 0, 0, 0.75);
backdrop-filter: blur(15px);
-webkit-backdrop-filter: blur(15px);


  box-shadow:
    inset 0 1px 1px rgba(255,255,255,0.3),
    0 6px 14px rgba(0,0,0,0.35),
    0 0 10px rgba(255,115,0,0.3);

  transition: transform 0.3s ease, background 0.3s ease, box-shadow 0.3s ease;
}

/* glass sheen */
.scroll-btn::before {
  content: "";
  position: absolute;
  inset: 0;
  border-radius: 50%;
  background: linear-gradient(
    135deg,
    rgba(255,255,255,0.45),
    rgba(255,255,255,0.05)
  );
  opacity: 0.35;
  pointer-events: none;
}

/* Hover — brighter glass, same logic */
.scroll-btn:hover {
  background: #ff7300;
  color: #000;
  box-shadow:
    inset 0 1px 1px rgba(255,255,255,0.45),
    0 8px 20px rgba(0,0,0,0.4),
    0 0 18px rgba(255,115,0,0.9);
}

.scroll-btn.left { left: -15px; }
.scroll-btn.right { right: -15px; }

/* Inactive state — frosted but disabled */
.scroll-btn.at-start,
.scroll-btn.at-end {
  opacity: 0.4;
  cursor: not-allowed;
  box-shadow:
    inset 0 2px 6px rgba(255,115,0,0.35),
    0 4px 10px rgba(0,0,0,0.3);
}

/* Hover does NOT re-enable inactive buttons */
.scroll-btn.at-start:hover,
.scroll-btn.at-end:hover {
  background: rgba(255, 255, 255, 0.14);
  box-shadow:
    inset 0 2px 6px rgba(255,115,0,0.35),
    0 4px 10px rgba(0,0,0,0.3);
}

/* ===============================
   MOBILE – 1 CARD PER VIEW (STABLE)
================================ */
@media (max-width: 768px) {
  .similar-treks-row {
    display: flex;
    gap: 2rem;
    overflow-x: auto;
    scroll-behavior: smooth;
    scroll-snap-type: x mandatory;
  }

  .similar-treks-row::-webkit-scrollbar {
    display: none;
  }

  /* ONE CARD PER SLIDE */
  .similar-treks-row .trek-card {
    flex: 0 0 100%;
    max-width: 100%;
    scroll-snap-align: center;

    /* center card */
    justify-content: center;
  }

  /* IMPORTANT: size the CARD itself, not children */
  .similar-treks-row .trek-card {
    padding: 0;
  }

  .similar-treks-row .trek-card > a,
  .similar-treks-row .trek-card > h3,
  .similar-treks-row .trek-card > .trek-info,
  .similar-treks-row .trek-card > .trek-buttons {
    width: 100%;
