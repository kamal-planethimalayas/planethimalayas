.itinerary-toggle {
  width: 100%;
  background-color: #f7f7f7;
  padding: 0.75rem 1rem;
  display: flex;
  justify-content: space-between;
  align-items: center;
  cursor: pointer;
  border: none;
  outline: none;
  font-weight: 700;
  font-size: 1rem;
  transition: background-color 0.2s;
}

.itinerary-toggle:hover {
  background-color: #e2e2e2;
}

.itinerary-details {
  max-height: 0;
  overflow: hidden;
  transition: max-height 0.4s ease, padding 0.4s ease;
  padding: 0 1rem; /* horizontal padding always visible */
}

.itinerary-details.open {
  max-height: 2000px; /* enough for content */
  padding: 1rem;       /* top + bottom padding only when open */
}

/* Arrow rotation */
.arrow {
  width: 1.25rem;
  height: 1.25rem;
  transition: transform 0.3s ease;
}

.arrow.rotate {
  transform: rotate(180deg);
}

/* Gap between days, including last day */
.itinerary-container {
  display: flex;
  flex-direction: column;
  gap: 1rem; /* ensures last day also has space */
}

/* Remove extra border after last day */
.itinerary-container .itinerary-day:last-child {
  border-bottom: none;
}

.itinerary-info-icon {
  display: inline-flex;
  justify-content: center;
  align-items: center;
  width: 20px;
  height: 20px;
  background: rgba(0, 0, 0, 0.75);
backdrop-filter: blur(15px);
-webkit-backdrop-filter: blur(15px);
 
  color: #ff7300;
  border-radius: 50%;
  border: 1px solid #ff7300;
  font-size: 0.75rem;
  font-weight: bold;
  margin-left: 6px;
  cursor: pointer;
  box-shadow:
    inset 0 1px 1px rgba(255, 255, 255, 0.35),
    0 10px 28px rgba(0, 0, 0, 0.35),
    0 0 12px rgba(255, 115, 0, 0.35);

  transition:
    transform 0.3s ease,
    box-shadow 0.3s ease,
    background 0.3s ease;
}

.itinerary-info-icon:hover {
  background: #ff7300;
  color: black;
  transform: scale(1.05);
  /* Bottom glow effect only */
  box-shadow:
    inset 0 1px 1px rgba(255, 255, 255, 0.45),
    0 14px 35px rgba(0, 0, 0, 0.45),
    0 0 30px rgba(255, 115, 0, 1),
    0 0 60px rgba(255, 115, 0, 0.75); 
}

/* Itinerary Modal styling */
.itinerary-modal {
  display: none;
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(0,0,0,0.6);
  backdrop-filter: blur(3px);
  justify-content: center;
  align-items: center;
  z-index: 10000;
}

.itinerary-modal-content {
  background-color: #fff;
  margin: 5% auto;
  padding: 2rem;
  border-radius: 12px;
  width: 90%;
  max-width: 850px;
  box-shadow: 0 8px 25px rgba(0, 0, 0, 0.25);
  font-family: 'Roboto', sans-serif;
  line-height: 1.6;
  color: #222;
  animation: modalFadeIn 0.3s ease;
}


.close-itinerary-modal {
  float: right;
  top: 18px;
  right: 18px;
  width: 30px;
  height: 30px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24px;
  line-height: 1;
  color: red;
  cursor: pointer;
  cursor: pointer;
  border: 2px solid red;
  border-radius: 50%;
  /* glass base */
  background: rgba(0, 0, 0, 0.75);
backdrop-filter: blur(15px);
-webkit-backdrop-filter: blur(15px);

  /* elevation + soft brand glow */
  box-shadow:
  inset 0 1px 1px rgba(255,255,255,0.35),
  0 8px 18px rgba(0,0,0,0.35),
  0 0 12px rgba(211, 47, 47, 0.45);

  transition: all 0.3s ease;
}

.close-itinerary-modal::before {
  content: "";
  position: absolute;
  inset: 0;
  border-radius: inherit;
  background: linear-gradient(
    135deg,
    rgba(255, 255, 255, 0.35),
    rgba(255, 255, 255, 0.05)
  );
  opacity: 0.35;
  pointer-events: none;
}

.close-itinerary-modal:hover{
  transform: translateY(-6px);
  color: #000;
  background: red;
  box-shadow:
  inset 0 1px 1px rgba(255,255,255,0.45),
  0 12px 28px rgba(0,0,0,0.45),
  0 0 22px rgba(211, 47, 47, 1),
  0 0 42px rgba(211, 47, 47, 0.7);
}

@keyframes modalFadeIn {
