<script>
  document.addEventListener("DOMContentLoaded", () => {
    document.querySelectorAll(".collapsible-header").forEach(header => {
      header.addEventListener("click", () => {
        header.classList.toggle("active");
        const content = header.nextElementSibling;
        content.classList.toggle("open");
      });
    });
  });
</script>

<script>
const heroText = document.querySelector(".trek-hero .hero-text");
const hero = document.querySelector(".trek-hero");

window.addEventListener("scroll", () => {
  const heroRect = hero.getBoundingClientRect();
  const scrollY = window.scrollY;

  if (heroRect.bottom > 0) {
    let move = scrollY * 0.5; // speed factor
    const maxMove = hero.offsetHeight / 2;

    heroText.style.transform = `translateY(${Math.min(move, maxMove)}px)`;
  }
});
</script>


