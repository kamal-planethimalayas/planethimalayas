<script is:client>
  window.addEventListener('DOMContentLoaded', () => {
    const modal = document.getElementById('leadGenModal');
    const closeBtn = modal.querySelector('.modal-close');
    const form = document.getElementById('leadGenForm');
    const thankYou = document.getElementById('leadGenThankYou');
    const trekInput = document.getElementById('trekName');

    // Floating button
    const floatBtn = document.createElement('button');
    floatBtn.textContent = "Plan Your Trek";
    Object.assign(floatBtn.style, {
      position: "fixed",
      top: "50%",
      right: "12px",
      transform: "translateY(-50%) rotate(-90deg)",
      transformOrigin: "right center",
      background: "#ff7300",
      color: "#000",
      fontFamily: "Roboto, sans-serif",
      fontWeight: "bold",
      border: "none",
      borderRadius: "12px 12px 0 0",
      padding: "12px 20px",
      cursor: "pointer",
      boxShadow: "0 4px 10px rgba(0,0,0,0.2)",
      zIndex: "9999",
      transition: "all 0.4s ease",
      opacity: "0",
      right: "-120px",
    });
    document.body.appendChild(floatBtn);
    setTimeout(() => {
      floatBtn.style.right = "12px";
      floatBtn.style.opacity = "1";
    }, 1000);

    // Open/Close modal
    const openModal = (trekName = "") => {
      trekInput.value = trekName; // prefill trek name
      modal.style.display = 'block';
      floatBtn.style.display = 'none';
    };
    const closeModal = () => {
      modal.style.display = 'none';
      floatBtn.style.display = 'block';
    };

    if (!sessionStorage.getItem('leadGenShown')) {
      setTimeout(() => {
        openModal();
        sessionStorage.setItem('leadGenShown', 'true');
      }, 8000);
    }

    closeBtn.addEventListener('click', closeModal);
    window.addEventListener('click', (e) => { if (e.target === modal) closeModal(); });
    floatBtn.addEventListener('click', () => openModal());

    // Listen to all Enquire Now buttons
    document.querySelectorAll('.enquire-now-btn').forEach(btn => {
    btn.addEventListener('click', () => {
    const trekName = btn.dataset.trek; // fetch the trek name
    openModal(trekName); // prefill the modal
    });
  });

    // Contact method
    const contactMethod = document.getElementById('contactMethod');
    const phoneGroup = document.getElementById('phoneGroup');
    const whatsappGroup = document.getElementById('whatsappGroup');

    contactMethod.addEventListener('change', function() {
      phoneGroup.style.display = this.value === 'phone' ? 'block' : 'none';
      whatsappGroup.style.display = this.value === 'whatsapp' ? 'block' : 'none';
    });

    // intl-tel-input
    const phoneInput = intlTelInput(document.querySelector("#phone"), {
      initialCountry: "in",
      separateDialCode: true,
      utilsScript: "https://cdn.jsdelivr.net/npm/intl-tel-input@18.1.1/build/js/utils.js"
    });

    const whatsappInput = intlTelInput(document.querySelector("#whatsapp"), {
      initialCountry: "in",
      separateDialCode: true,
      utilsScript: "https://cdn.jsdelivr.net/npm/intl-tel-input@18.1.1/build/js/utils.js"
    });

    // Form submit
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const formData = new FormData(form);
      formData.set("phone", phoneInput.getNumber());
      formData.set("whatsapp", whatsappInput.getNumber());

      try {
        const res = await fetch(form.action, {
          method: 'POST',
          body: formData,
          headers: { 'Accept': 'application/json' }
        });
        if (res.ok) {
          form.style.display = 'none';
          thankYou.style.display = 'block';
        } else {
          alert('There was a problem submitting the form.');
        }
        } catch (err) {
          alert('There was a problem submitting the form.');
        }
      });

      // Example: Pre-fill modal when a "Plan Now" button is clicked
      document.querySelectorAll('.plan-now-btn').forEach(btn => {
        btn.addEventListener('click', () => openModal(btn.dataset.trek));
      });
    });
</script>

<script>
/* Vanilla JS carousel - works with the static mapping above.
   Place this script in the page (or init via client:load in Astro) so it runs in the browser.
*/
document.addEventListener('DOMContentLoaded', () => {
  const section = document.querySelector('.trek-hero.reveal');
  if (!section) return;

  // Select slides (images) inside this section
  const slides = Array.from(section.querySelectorAll('.carousel-slide'));
  if (slides.length === 0) return;

  const prevBtn = section.querySelector('.carousel-arrow.prev');
  const nextBtn = section.querySelector('.carousel-arrow.next');
  const dotsContainer = section.querySelector('.carousel-dots');

  let current = 0;
  let autoSlide;

  // Create dots only if more than 1 slide
  if (slides.length > 1) {
    slides.forEach((_, idx) => {
      const btn = document.createElement('button');
      if (idx === 0) btn.classList.add('active');
      btn.setAttribute('aria-label', 'Go to slide ' + (idx + 1));
      btn.addEventListener('click', () => goToSlide(idx));
      dotsContainer.appendChild(btn);
    });
  }

  const dots = Array.from(dotsContainer.querySelectorAll('button'));

  function updateUI() {
    slides.forEach((s, i) => s.classList.toggle('active', i === current));
    dots.forEach((d, i) => d.classList.toggle('active', i === current));
  }

  function goToSlide(n) {
    current = (n + slides.length) % slides.length;
    updateUI();
    resetAuto();
  }

  function nextSlide() { goToSlide(current + 1); }
  function prevSlide() { goToSlide(current - 1); }

  if (nextBtn) nextBtn.addEventListener('click', () => { nextSlide(); resetAuto(); });
  if (prevBtn) prevBtn.addEventListener('click', () => { prevSlide(); resetAuto(); });

  // Auto slide, only if more than 1 image
  function startAuto() {
    if (slides.length <= 1) return;
    stopAuto();
    autoSlide = setInterval(nextSlide, 5000);
  }
  function stopAuto() { if (autoSlide) clearInterval(autoSlide); }

  // Pause on hover (desktop)
  section.addEventListener('mouseenter', stopAuto);
  section.addEventListener('mouseleave', startAuto);

  // Touch swipe for mobile
  let startX = 0;
  section.addEventListener('touchstart', e => startX = e.touches[0].clientX);
  section.addEventListener('touchend', e => {
    const endX = e.changedTouches[0].clientX;
    const diff = endX - startX;
    if (Math.abs(diff) > 50) {
      if (diff > 0) prevSlide();
      else nextSlide();
      resetAuto();
    }
  });

  function resetAuto() {
    stopAuto();
    startAuto();
  }

  // init
  updateUI();
  startAuto();
});
</script>

<script>
function initReadMore() {
  const snippet = document.querySelector('.trek-overview-snippet');
  const priceBox = document.querySelector('.price-box');
  const readMore = document.querySelector('.read-more-link');

  if (!snippet || !readMore || !priceBox) return;

  // Measure after layout is fully applied
  requestAnimationFrame(() => {
    const snippetHeight = Math.ceil(snippet.scrollHeight);
    const priceHeight = Math.ceil(priceBox.clientHeight);

    if (snippetHeight <= priceHeight) {
      readMore.style.display = 'none';
      snippet.style.maxHeight = 'none';
    } else {
      readMore.style.display = 'inline-block';
      snippet.style.maxHeight = priceHeight + 'px';
      snippet.style.overflow = 'hidden';
    }
  });

  readMore.addEventListener('click', () => {
    const isExpanded = snippet.classList.toggle('expanded');
    if (isExpanded) {
      snippet.style.maxHeight = 'none';
      readMore.textContent = 'Read Less';
    } else {
      snippet.style.maxHeight = priceBox.clientHeight + 'px';
      readMore.textContent = 'Read More';
    }
  });
}

// Use DOMContentLoaded and a small timeout to ensure dynamic HTML has rendered
window.addEventListener('DOMContentLoaded', () => {
  setTimeout(initReadMore, 50); // 50ms delay ensures HTML is rendered
});
</script>

