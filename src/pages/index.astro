  text-align: center;
  font-family: 'Helvetica', sans-serif;
  text-align: left;
}

.testimonials-underline {
  width: 100%;
  height: 2px;
  background-color: #ff7300;
  margin: 0 auto 2rem;
  border-radius: 2px;;
}

/* Card wrapper */
.testimonials-card-wrapper {
  display: flex;
  gap: 1.5rem;
  overflow-x: hidden;
  scroll-behavior: smooth;
  padding-bottom: 10px;
  scroll-snap-type: x mandatory;
}

/* Individual cards */
.testimonial-card {
  flex: 0 0 50%; /* 2 cards per screen on desktop */
  max-width: 50%;
  scroll-snap-align: start;
  background: #fff;
  border-radius: 12px;
  box-shadow: 0 4px 8px rgba(0,0,0,0.1);
  padding: 1.5rem;
}

.testimonial-header {
  display: flex;
  align-items: center;
  margin-bottom: 1rem;
}

.testimonial-pic {
  width: 60px;
  height: 60px;
  border-radius: 50%;
  object-fit: cover;
  margin-right: 15px;
}

.testimonial-info {
