z-index: 2;

width: 50%;
max-width: 680px;

display: flex;
flex-direction: column;
align-items: flex-start;

text-align: left;
margin-left: 6rem;

color: #fff;
}

/* ===============================
TREK NAME
================================ */

.trek-content-name {
font-family: Helvetica, Arial, sans-serif;
font-weight: 700;

font-size: 2.5rem;
line-height: 1.15;

color: #fff;

margin: 0 0 1rem 0;

text-align: left;
}

.trek-content-name span {
font-weight: 400;
}

/* ===============================
TREK META
================================ */

.trek-meta {
display: flex;
flex-direction: column;

gap: 7px;

margin-bottom: 1rem;

font-family: Roboto, sans-serif;
font-weight: 500;
font-size: 0.95rem;
line-height: 1.45;

color: rgba(255, 255, 255, 0.88);

text-align: left;
}

/* ===============================
TEXT + READ MORE
================================ */

.trek-text-wrapper {
position: relative;
width: 100%;
}

/* ===============================
TREK DESCRIPTION
================================ */

.trek-snippet {
font-family: Roboto, sans-serif;

font-size: 1rem;
line-height: 1.65;

font-weight: 400;

color: rgba(255, 255, 255, 0.92);

margin: 0;

display: -webkit-box;
-webkit-box-orient: vertical;
-webkit-line-clamp: 5;

overflow: hidden;

position: relative;
}

/* ===============================
FADE EFFECT
================================ */

.trek-snippet::after {
content: "";

position: absolute;

left: 0;
bottom: 0;

width: 100%;
height: 2.4em;

background: linear-gradient(
to bottom,
rgba(0, 0, 0, 0),
rgba(0, 0, 0, 0.55)
);

pointer-events: none;
}

/* ===============================
EXPANDED STATE
================================ */

.trek-text-wrapper.expanded .trek-snippet {
-webkit-line-clamp: unset;
}

.trek-text-wrapper.expanded .trek-snippet::after {
display: none;
}

/* ===============================
READ MORE
================================ */

.read-more-btn {
margin-top: 8px;

padding: 0;

border: none;
background: none;

font-family: Roboto, sans-serif;
font-size: 0.9rem;
font-weight: 600;

color: #ff7300;

cursor: pointer;

text-align: left;
}

/* ===============================
CTA
================================ */

