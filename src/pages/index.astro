}

/* Scroll buttons */
.scroll-btn {
  position: absolute;
  top: 50%;
  transform: translateY(-50%);
  background: #ff7300;
  color: white;
  border: none;
  padding: 0.5rem 0.8rem;
  cursor: pointer;
  border-radius: 4px;
  z-index: 5;
}

.scroll-btn.left { left: 0; }
.scroll-btn.right { right: 0; }
</style>


</div>
</Layout>

<script>
document.addEventListener("DOMContentLoaded", function () {
  const row = document.getElementById("testimonialRow");
  const leftBtn = document.querySelector(".scroll-btn.left");
  const rightBtn = document.querySelector(".scroll-btn.right");

  // Scroll Function
  function scrollTestimonials(direction) {
    const card = row.querySelector(".testimonial-card");
    if (!card) return;

    const gap = parseInt(getComputedStyle(row).gap) || 0;
    const cardWidth = card.offsetWidth + gap;

    row.scrollBy({
      left: direction * cardWidth,
      behavior: "smooth"
    });

    setTimeout(updateArrowState, 400); // update after scroll animation
  }

  // Enable/Disable Arrows at edges
  function updateArrowState() {
    leftBtn.disabled = row.scrollLeft <= 0;
    rightBtn.disabled = row.scrollLeft + row.clientWidth >= row.scrollWidth;
  }

  // Attach Events to arrows
  leftBtn.addEventListener("click", () => scrollTestimonials(-1));
  rightBtn.addEventListener("click", () => scrollTestimonials(1));

  // Initial state
  updateArrowState();

  // Read More Toggle
  document.querySelectorAll('.read-more-btn').forEach(btn => {
    btn.addEventListener('click', function() {
      const card = btn.closest('.testimonial-card');
      card.classList.toggle('expanded');
      btn.textContent = card.classList.contains('expanded') ? 'Show Less' : 'Read More';
    });
  });
});
</script>


<script type="module">
function scrollCards(sectionId, direction) {
  const container = document.getElementById(sectionId);
  if (!container) return;

  // Calculate scroll by card width + gap
  const card = container.querySelector('.trek-card');
  if (!card) return;
  
  const style = window.getComputedStyle(container);
  const gap = parseInt(style.gap) || 16; // default 1rem if not set
  const scrollAmount = (card.offsetWidth + gap) * direction;

  container.scrollBy({
    left: scrollAmount,
    behavior: 'smooth'
  });
}

// Expose globally so onclick works
window.scrollCards = scrollCards;
</script>






