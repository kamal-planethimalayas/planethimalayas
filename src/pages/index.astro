---
import Layout from '../layouts/Layout.astro';
import { treks } from '../data/treksData.js';
import { generalFAQs } from "../data/faqsData.js";
import NewsBanner from "../components/NewsBanner.jsx";
import NewsSection from "../components/NewsSection.jsx";
import Testimonials from "../components/Testimonials.jsx";
import "../styles/global.css";
---

<Layout title="Planethimalayas">

<!-- Top banner -->
<div class="banner-wrapper">
  <NewsBanner client:load />
</div>

<section class="hero-carousel-3d">
  <div class="cube-wrapper">
    <div class="cube">

      <!-- Front Face -->
      <div class="cube-face front" style="background-image: url('https://res.cloudinary.com/dr44hob9b/image/upload/v1761810023/love-himalayas_zz3cyf.jpg');">
        <div class="overlay"></div>
        <div class="hero-content">
          <h1>More Than Just A Trek</h1>
          <a href="/upcoming-treks" class="cta-button">Explore Treks</a>
          <p class="hero-subheading">
            Join our treks, thoughtfully crafted for deeply personal mountain experiences with unwavering focus on individual care, safety, and a genuine love for the Himalayas.
          </p>
        </div>
      </div>

      <!-- Right Face -->
      <div class="cube-face right" style="background-image: url('https://res.cloudinary.com/dr44hob9b/image/upload/v1761810048/journey-1_w9t3zk.jpg');">
        <div class="overlay"></div>
        <div class="hero-content">
          <h1>Not Just a Trek — A Journey That Stays With You</h1>
          <a href="/upcoming-treks" class="cta-button">Explore Treks</a>
          <p class="hero-subheading">
            Every trail we walk is a carefully chosen path into the heart of the Himalayas — not just to witness their grandeur, but to feel them under your skin and soul.
          </p>
        </div>
      </div>

      <!-- Back Face -->
      <div class="cube-face back" style="background-image: url('https://res.cloudinary.com/dr44hob9b/image/upload/v1761809893/care_pzucvr.jpg');">
        <div class="overlay"></div>
        <div class="hero-content">
          <h1>Individual Care, Every Step of the Way</h1>
          <a href="/upcoming-treks" class="cta-button">Explore Treks</a>
          <p class="hero-subheading">
            We keep our groups small so we can focus on you — your pace, your concerns, your joy. Our leaders walk with intention, offering safety and attention without intrusion.
          </p>
        </div>
      </div>

      <!-- Left Face -->
      <div class="cube-face left" style="background-image: url('https://res.cloudinary.com/dr44hob9b/image/upload/v1761810048/love-himalayas-3_fpus1m.jpg');">
        <div class="overlay"></div>
        <div class="hero-content">
          <h1>Built on Genuine Love for the Himalayas</h1>
          <a href="/upcoming-treks" class="cta-button">Explore Treks</a>
          <p class="hero-subheading">
            We live and breathe these mountains. With Planethimalayas, your trek becomes a way of giving back to the Himalayas that give us so much.
          </p>
        </div>
      </div>

    </div>
  </div>

  <!-- Arrows (for desktop) -->
  <button class="carousel-arrow left">&#10094;</button>
  <button class="carousel-arrow right">&#10095;</button>

  <!-- Dots -->
  <div class="carousel-dots">
    <button class="active"></button>
    <button></button>
    <button></button>
    <button></button>
  </div>
</section>

<div class="container">
<!-- UPCOMING TREKS: Upcoming Season Treks -->
<section class="trek-section reveal">
  <h2>Trending <span>Treks</span></h2>
  <div class="trek-cards-wrapper">
    <button class="scroll-btn left" onclick="scrollCards('winter', -1)">&lt;</button>
    <div class="trek-cards-scroll" id="winter">
      {
        treks
          .filter(trek => Array.isArray(trek.season) && trek.season.map(s => s.toLowerCase()).includes('winter'))
          .map(trek => {
            const duration = trek.overview?.facts?.find(f => f.label === "Trek Duration")?.value || trek.duration;
            const difficultyStr = Array.isArray(trek.difficulty) ? trek.difficulty.join(', ') : trek.difficulty;
            // Capitalize function
      const capitalize = (str) => {
  if (!str) return '';

  // If it's an array (difficulty, tags etc.)
  if (Array.isArray(str)) {
    return str
      .map(item => capitalize(item))   // Recursively capitalize each item
      .join(', ');
  }

  // If it's a string
  return str
    .split(' ')
    .map(word =>
      word
        .split('-') // also split hyphens
        .map(part => part.charAt(0).toUpperCase() + part.slice(1))
        .join('-')  // join hyphens back
    )
    .join(' ');
};
            return (
              <div class="trek-card" key={trek.id}>
                <a href={`/trek/${trek.id}#trek-hero`}>
                  <img src={trek.heroImage} alt={`View of ${trek.name} trek`} loading="lazy" />
                </a>
                <h3 class="trek-name">{trek.name}</h3>
                <div class="trek-info">
                  <span>
                    <i class="fa fa-clock"></i> {duration}
                  </span>
                  <span>
                    <i class="fa fa-map-marker-alt"></i> {capitalize(trek.region)}
                  </span>
                </div>
                <div class="trek-difficulty">{capitalize(difficultyStr)}</div>
                <div class="trek-buttons">
                  <a href={`/trek/${trek.id}#trek-overview-section`} class="btn btn-details">View Details</a>
                  <a href={`/trek/${trek.id}#pricing-snippet-wrapper`} class="btn btn-dates">View Dates</a>
                </div>
              </div>
            );
          })
      }
    </div>
    <button class="scroll-btn right" onclick="scrollCards('winter', 1)">&gt;</button>
  </div>
</section>

<!-- DESTINATIONS SECTION -->
<section class="destination-section reveal">
  <h2>Popular <span>Destinations</span></h2>

  <div class="destination-grid">
    {
      (() => {
        /* -------- CONFIG -------- */

        // Regions you want to hide
         const excludedRegions = ["null"];

        // Background images per region
        const regionBackgrounds = {
          "uttarakhand-kumaon":
            "https://res.cloudinary.com/dr44hob9b/image/upload/v1765625881/panchachuli-view5_p834ac.webp",
          "uttarakhand-garhwal":
            "https://res.cloudinary.com/dr44hob9b/image/upload/v1755517996/gaumukh-tapovan-hero2_fsilpd.jpg",
          "himachal pradesh":
            "https://res.cloudinary.com/dr44hob9b/image/upload/v1762191003/pin-parvati-pass-view15_jz5ttl.jpg",
          "ladakh":
            "https://res.cloudinary.com/dr44hob9b/image/upload/v1755535606/markha-valley-view9_adspc2.jpg",
          "kashmir":
            "https://res.cloudinary.com/dr44hob9b/image/upload/v1755535529/kgl-view8_p6vtjz.jpg",
          "sikkim":
            "https://res.cloudinary.com/dr44hob9b/image/upload/v1766063288/khangchendzonga-peak_2_tmtjjo.jpg",
          "west bengal":
            "https://res.cloudinary.com/dr44hob9b/image/upload/v1766063333/sleeping-buddha-sandakpu1_khv34b.jpg",
          "nepal":
            "https://res.cloudinary.com/dr44hob9b/image/upload/v1766068757/everest_wdjvrw.jpg",
        };

        /* -------- BUILD REGION MAP -------- */

        const regionMap = {};

        treks.forEach(trek => {
          if (!trek.region) return;

          const regions = Array.isArray(trek.region)
            ? trek.region
            : [trek.region];

          regions.forEach(r => {
            if (!r) return;

            const region = r.toLowerCase();

            if (
              excludedRegions
                .map(er => er.toLowerCase())
                .includes(region)
            ) return;

            regionMap[region] = (regionMap[region] || 0) + 1;
          });
        });

        /* -------- UTIL -------- */

        const capitalize = (str) =>
          str
            .split(" ")
            .map(word =>
              word
                .split("-")
                .map(part => part.charAt(0).toUpperCase() + part.slice(1))
                .join("-")
            )
            .join(" ");

        /* -------- RENDER -------- */

        return Object.entries(regionMap).map(([region, count]) => (
          <div
            class="destination-card"
            key={region}
            style={{
              backgroundImage: `linear-gradient(
                rgba(0,0,0,0.45),
                rgba(0,0,0,0.85)
              ), url(${regionBackgrounds[region] || "/images/regions/default.jpg"})`
            }}
          >
            <h3>{capitalize(region)}</h3>
            <p>{count} Trek{count > 1 ? "s" : ""}</p>
            <a
              href={`/upcoming-treks?region=${region}`}
              class="btn"
            >
              View Treks
            </a>
          </div>
        ));
      })()
    }
  </div>
</section>

<!-- News Section -->
<section class="news-section reveal">
  <h2 class="news-section-heading">News <span>& Articles</span></h2>
  <NewsSection client:load />
</section>

<!-- Exclusive Section -->
<section class="home-trek-feature reveal">
  <div class="trek-image">
    <span class="trek-badge">Winter Exclusive</span>
    <img src="https://res.cloudinary.com/dr44hob9b/image/upload/v1766063281/khangchendzonga-peak_1_imnm5j.jpg" alt="Dzongri Winter Trek">
  </div>

  <div class="trek-content">
    <h2 class="trek-content-name">Dzongri <span>Winter Trek</span></h2>

    <div class="trek-meta">
      <span>📍 Sikkim - Khangchendzonga National Park</span>
      <span>🏔️ 13,670 ft</span>
      <span>❄️ Winter Exclusive</span>
      <span>⚡ Moderate</span>
      <span>⏳ 7 Nights / 7 Days</span>
    </div>

    <div class="trek-text-wrapper">
      <p class="trek-snippet" id="dzongriSnippet">
      Dzongri Winter Trek is a rare Himalayan journey meant for trekkers who crave
      raw winter landscapes, deep silence, and dramatic mountain views far away
      from crowded trails. Walking through snow-covered forests and frozen
      meadows, this trek offers a front-row seat to Kanchenjunga, Pandim, and Kabru
      glowing under crisp winter skies. With fewer trekkers on the trail, the
      experience feels deeply personal, immersive, and profoundly wild — a true
      winter Himalayan adventure.
      </p>

      <button class="read-more-btn" type="button">Read more →</button>
    </div>

    <a href="/trek/dzongri-winter-trek" class="btn-book">
      Register Now
    </a>
  </div>
</section>

<!-- Faqs Section -->
<section class="faqs-section reveal">
    <h2 class="faqs-section-heading">FA<span>Qs</span></h2>

    <!-- FAQ topics -->
<!-- FAQ topics -->
{generalFAQs.map((section, sectionIndex) => (
          <div class="faq-topic" id={`faq-topic-${sectionIndex}`}>
            <button class="faq-topic-header" aria-expanded="false">
              {section.topic}
              <span class="toggle">▶</span>
            </button>
            <div class="faq-topic-body" hidden>
              {section.sections
                ? section.sections.map((sub, subIndex) => (
                    <div class="faq-subtopic" id={`faq-${sectionIndex}-${subIndex}`}>
                      <button class="faq-subtopic-header" aria-expanded="false">
                        {sub.subtopic}
                        <span class="toggle">▶</span>
                      </button>
                      <div class="faq-subtopic-body" hidden>
                        {sub.faqs.map((faq, faqIndex) => (
                          <div class="faq-item" id={`faq-${sectionIndex}-${subIndex}-${faqIndex}`}>
                            <button class="faq-question" aria-expanded="false">
                              {faq.question}
                              <span class="toggle">+</span>
                            </button>
                            <div class="faq-answer" hidden>
                              <div set:html={faq.answer}></div>
                            </div>
                          </div>
                        ))}
                      </div>
                    </div>
                  ))
                : section.faqs.map((faq, faqIndex) => (
                    <div class="faq-item" id={`faq-${sectionIndex}-${faqIndex}`}>
                      <button class="faq-question" aria-expanded="false">
                        {faq.question}
                        <span class="toggle">+</span>
                      </button>
                      <div class="faq-answer" hidden>
                        <div set:html={faq.answer}></div>
                      </div>
                    </div>
              ))}
            </div>
          </div>
))}

    <!-- Link to full FAQs page -->
    <div class="faq-footer">
      <a href="/faqs" target='_blank' rel='noopener noreferrer'>Explore all FAQs →</a>
    </div>
</section>

<Testimonials client:load />
</div>

<section class="leadgen-section reveal">
  <div class="leadgen-overlay"></div>

  <div class="leadgen-content">
    <h2 class="section-heading">Plan Your <span>Himalayan Trek</span></h2>
    <p class="section-sub">
      Get a personalised itinerary, dates & expert guidance from Planethimalayas.
    </p>

    <form id="homepageLeadForm" action="https://formspree.io/f/xrbldkrb" method="POST">
      <div class="form-row">
        <input type="text" name="name" placeholder="Your Name" required />
        <input type="email" name="email" placeholder="Email Address" required />
      </div>

      <div class="form-row">
        <input type="text" id="phone-home" name="phone" placeholder="Phone Number" required />
        <input type="text" name="trek" placeholder="Interested Trek (optional)" />
      </div>

      <div class="custom-message-field">
        <textarea name="plan-details" placeholder="Tell us what you're planning…"></textarea>
      </div>

      <button type="submit" class="leadgen-btn">Get Details</button>
    </form>

    <!-- Error message -->
    <div id="leadgenError" style="display:none; color:red; margin-top:20px; text-align:center;"></div>

    <!-- Thank-you message -->
    <div id="leadgenThankYou" style="display:none; text-align:center; margin-top:30px;">
      <h3 style="color:#ff7300; text-shadow:0 0 8px #ff7300;">Thank You!</h3>
      <p style="color:white;">We’ve received your details. Our team will reach out shortly.</p>
      <a href="/upcoming-treks" class="leadgen-btn">Explore Treks</a>
    </div>
  </div>
</section>
</Layout>

<style>

.banner-wrapper {
  width: 100%;
  height: 30px;
  position: absolute;   /* pulls it out of flow */
  top: 110px;           /* two navbars stacked (55px each) */
  z-index: 90;          /* above hero but below navbars */
  background: transparent;
  overflow: hidden;
}

@media (max-width: 768px) {
  .banner-wrapper {
    top: 55px; /* only one navbar in mobile */
  }
}

.hero-carousel-3d {
  perspective: 30000px;
  width: 100%;
  height: 120vh;
  position: relative;
  overflow: hidden;
  color: white;
}

.cube-wrapper {
  width: 100%;
  height: 100%;
  position: relative;
  transform-style: preserve-3d;
}

.cube {
  width: 100%;
  height: 100%;
  position: absolute;
  transform-style: preserve-3d;
  transform: rotateY(0deg);
  transition: transform 1s linear;
}

/* Cube faces */
.cube-face {
  position: absolute;
  width: 100%;
  height: 100%;
  background-size: cover;
  background-position: center;
  backface-visibility: hidden;
}

/* Position each face */
.cube-face.front  { transform: rotateY(0deg) translateZ(50vw); }
.cube-face.right  { transform: rotateY(90deg) translateZ(50vw); }
.cube-face.back   { transform: rotateY(180deg) translateZ(50vw); }
.cube-face.left   { transform: rotateY(-90deg) translateZ(50vw); }

/* Optional overlay */
.cube-face .overlay {
  position: absolute;
  inset: 0;
  background: rgba(0,0,0,0.25);
  z-index: 1;
}

.hero-content {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  text-align: center;
  z-index: 2;
  width: 85%;
  max-width: 1000px;
}

.hero-content h1 {
  font-family: Helvetica, sans-serif;
  font-size: 4rem;
  font-weight: bold;
  margin-bottom: 3rem;
  color: white;
  text-shadow: 3px 3px 6px rgba(0, 0, 0, 0.6);
}

.hero-subheading {
  font-family: "Roboto", sans-serif;
  font-size: 1.5rem;
  margin-top: 1.5rem;
  color: white;
  text-shadow: 2px 2px 5px rgba(0, 0, 0, 0.7);
}

.cta-button {
  position: relative;
  display: inline-block;

  /* Glass base */
  background: rgba(0, 0, 0, 0.75);
backdrop-filter: blur(15px);
-webkit-backdrop-filter: blur(15px);

  color: #ff7300;
  font-family: "Roboto", sans-serif;
  font-weight: 700;
  font-size: 18px;

  padding: 1rem 2.5rem;
  border-radius: 10px;
  border: 2px solid #ff7300;
  text-decoration: none;

  /* Elevated glass feel */
  box-shadow:
    inset 0 1px 1px rgba(255, 255, 255, 0.35),
    0 10px 28px rgba(0, 0, 0, 0.35),
    0 0 12px rgba(255, 115, 0, 0.35);

  transition:
    transform 0.3s ease,
    box-shadow 0.3s ease,
    background 0.3s ease;
}

/* subtle glass highlight layer */
.cta-button::before {
  content: "";
  position: absolute;
  inset: 0;
  border-radius: inherit;
  background: linear-gradient(
    135deg,
    rgba(255, 255, 255, 0.35),
    rgba(255, 255, 255, 0.05)
  );
  opacity: 0.35;
  pointer-events: none;
}

.cta-button:hover {
  /* keep structure, just “turn it on” */
  background: #ff7300;
  color: #000;
  transform: translateY(-6px);

  box-shadow:
    inset 0 1px 1px rgba(255, 255, 255, 0.45),
    0 14px 35px rgba(0, 0, 0, 0.45),
    0 0 30px rgba(255, 115, 0, 1),
    0 0 60px rgba(255, 115, 0, 0.75);
}

.carousel-dots {
  position: absolute;
  bottom: 25px;
  left: 50%;
  transform: translateX(-50%);
  display: flex;
  gap: 10px;
  z-index: 3;
}

.carousel-dots button {
  appearance: none;
  -webkit-appearance: none;
  width: 12px;
  height: 12px;
  border-radius: 50%;

  background: rgba(0, 0, 0, 0.75);
backdrop-filter: blur(15px);
-webkit-backdrop-filter: blur(15px);

  border: 2px solid #ff7300;
  cursor: pointer;
  padding: 0;
  margin: 0;
  box-sizing: content-box;

  box-shadow:
    inset 0 1px 1px rgba(255,255,255,0.35),
    0 4px 10px rgba(0,0,0,0.25);

  transition:
    background 0.25s ease,
    transform 0.25s ease,
    box-shadow 0.25s ease;
}

.carousel-arrow.left { left: 50px; } 
.carousel-arrow.right { right: 50px; }

/* active / hover dot */
.carousel-dots button:hover,
.carousel-dots button.active {
  background: #ff7300;
  transform: scale(1.15);

  box-shadow:
    0 0 12px rgba(255,115,0,0.9),
    0 0 22px rgba(255,115,0,0.7);
}


.carousel-dots button.active {
  background-color: #ff7300;
  transform: scale(1.05);
  box-shadow: 0 8px 20px #ff7300, 0 6px 15px rgba(0, 0, 0, 0.4);
}

/* Responsive */
@media (max-width: 768px) {
  .hero-carousel-3d {
    height: 75vh;
    margin-top: -55px;
  }
  .carousel-slide {
    height: 75vh;
  }
  .hero-content h1 {
    font-size: 2rem;
  }
  .hero-subheading {
    font-size: 1rem;
  }
  .cta-button {
    padding: 0.6rem 2rem;
  }
  .carousel-arrow {
    display: none; /* hide arrows on mobile */
  }
}

/* Hide dots on desktop */
@media (min-width: 769px) {
  .carousel-dots {
    display: none;
  }
}

/* ---------------------------------------
   TREK SECTION
----------------------------------------- */

.trek-section {
  background-color: white; /* black background */
  color: #fff;            /* white text globally */
  position: relative;
}

.trek-section h2 {
  font-size: 2.5rem;
  font-family: 'Helvetica', sans-serif;
  color: black;
}

/* ---------------------------------------
   WRAPPER + SCROLL
----------------------------------------- */

.trek-cards-wrapper {
  display: flex;
  gap: 1.5rem;
  overflow-x: auto; /* still scrollable */
  scroll-behavior: smooth;  
  position: relative;
  scroll-snap-type: x mandatory;
  overflow: visible !important;
  /* Hide scrollbar for all browsers */
  -ms-overflow-style: none;  /* IE and Edge */
  scrollbar-width: none;     /* Firefox */
}

.trek-cards-scroll {
  display: flex;
  gap: 1.2rem;
  overflow-x: auto;
  scroll-snap-type: x mandatory;
  scroll-behavior: smooth;
  -webkit-overflow-scrolling: touch;
  padding-bottom: 2rem;;
  padding-top: 2rem;
}

/* Hide scrollbar */
.trek-cards-scroll::-webkit-scrollbar { display: none; }
.trek-cards-scroll { scrollbar-width: none; }


/* ---------------------------------------
   TREK CARD
----------------------------------------- */

.trek-card {
  flex: 0 0 32%;
  scroll-snap-align: start;
  background: #121316;

  border-radius: 12px;
  border: 2px solid #ff7300;
  overflow: hidden;
  position: relative;

  /* Increased height */
  min-height: 450px;

  /* 3D + smooth transitions */
  transform-style: preserve-3d;
  transition: 
    transform 0.4s cubic-bezier(0.22, 1, 0.36, 1),
    box-shadow 0.4s cubic-bezier(0.22, 1, 0.36, 1),
    border 0.3s ease;
  box-shadow:
    0 4px 12px rgba(255, 115, 0, 0.45),
    0 0 10px rgba(255, 115, 0, 0.3);
}

/* Hover: 3D pop + brand border + directional glow (light from above) */
.trek-card:hover {
  transform: translateY(-16px) rotateX(4deg) rotateY(2deg);

  /* Directional premium glow */
  box-shadow:
    0 -4px 10px rgba(0, 0, 0, 0.1),          /* soft shadow on top */
    0 12px 24px rgba(0, 0, 0, 0.25),         /* stronger shadow below */
    0 6px 20px rgba(255, 115, 0, 0.95),       /* main bottom glow */
    0 12px 40px rgba(255, 115, 0, 0.35),     /* diffused bottom glow */
    inset 0 0 8px rgba(255, 115, 0, 0.1);    /* subtle inner sheen */

  z-index: 10;
}

/* ---------------------------------------
   TREK IMAGE
----------------------------------------- */

.trek-card img {
  width: 100%;
  height: 260px;
  object-fit: cover;
  display: block;

  /* Smooth cinematic zoom */
  transform: scale(1);
  transition: transform 0.9s cubic-bezier(0.22, 1, 0.36, 1);
}

/* Soft, slow zoom — no tilt */
.trek-card:hover img {
  transform: scale(1.04);
}

/* ---------------------------------------
   TREK DIFFICULTY BADGE
----------------------------------------- */

.trek-difficulty {
  position: absolute;
  top: 12px;
  left: 12px;
  background: #ff7300;
  padding: 5px 12px;
  border-radius: 8px;
  font-size: 0.85rem;
  font-weight: 600;
  color: #000;
  border: 2px solid rgba(0,0,0,0.75);
  backdrop-filter: blur(3px);
}


/* ---------------------------------------
   TEXT CONTENT
----------------------------------------- */

.trek-name {
  font-weight: 700;
  font-size: 1.5rem;
  color: #ff7300;
  text-align: center;
  margin: 2rem 2rem 2rem;
}

.trek-info {
  display: flex;           /* align spans in a row */
  justify-content: center; /* center them horizontally */
  gap: 2rem;               /* space between spans */
