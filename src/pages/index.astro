}

/* 3. Social icons */
.testimonial-social a {
  margin-right: 0.5rem;
  color: #666;
  text-decoration: none;
  font-size: 1rem;
  display: inline-flex;
  align-items: center;
  gap: 0.3rem;
  transition: color 0.3s ease;
}

.testimonial-social a:hover {
  color: #ff7300;
}

/* Responsive adjustments */
@media (max-width: 768px) {
  .testimonial-card {
    flex: 0 0 100%;   /* 1 per view on mobile */
    max-width: 100%;
  }
}

