HOME TREK FEATURE
FULL-BLEED IMAGE + OVERLAY CONTENT
================================ */

.home-trek-feature {
position: relative;
width: 100vw;
min-height: 560px;

margin-left: calc(50% - 50vw);
margin-right: calc(50% - 50vw);

overflow: hidden;

display: flex;
align-items: center;

padding: 3rem 1rem;
box-sizing: border-box;
}

/* ===============================
BACKGROUND IMAGE
================================ */

.trek-background {
