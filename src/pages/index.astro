---
import Layout from '../layouts/Layout.astro';
import { treks } from '../data/treksData.js';

---


<Layout title="Planethimalayas">

  <style>

    .hero {
  position: relative;
  width: 100%;
  height: 100vh; /* standard hero height */
  background-image: url('/images/hero.jpg');
  background-size: cover;       /* fills full width & height, keeps aspect ratio */
  background-position: calc(50% ) calc(0% - 8rem); /* image starts from top */
  background-repeat: no-repeat;
  color: white;
  padding-top: 2rem;           /* space for text from top */
  padding-left: 2rem;
  padding-right: 2rem;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  margin-top: -55px;
}

    .hero h1 {
      font-family: Helvetica, sans-serif;
      font-size: 6rem;
      line-height: 1.2;
      font-weight: bold;
      color: white;
      margin-top: 3rem;
      margin-bottom: 3rem;
      text-shadow: 2px 4px 8px rgba(0, 0, 0, 0.8);
      padding-left: 8rem;
      
    }

    .hero p {
      font-family: 'Roboto', sans-serif;
      font-weight: 400;
      font-size: 1.25rem;
      max-width: 100%;
      margin-top: 0;
      color: white;
      text-shadow: 2px 4px 8px rgba(0, 0, 0, 0.8);
      padding-left: 8rem;
      padding-right: 36rem;
    }

    .cta-button {
      background-color: #ff7300;
      color: black;
      font-family: 'Roboto', sans-serif;
      font-weight: 700;
      padding: 0.5rem 0.5rem;
      padding-left: 8rem;
      padding-right: 8rem;
      font-size: 1rem;
      margin-bottom: 1.5rem;
      margin-left: 8rem;
      text-decoration: none;
      border-radius: 10px;
      width: fit-content;
      box-shadow: 2px 8px 15px rgba(0, 0, 0, 0.8);
      transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

    .underline-hover {
  position: relative;
  display: inline-block;
  text-decoration: none;
}

.underline-hover::after {
  content: '';
  position: absolute;
  bottom: -2px;
  left: 0;
  height: 2px;
  width: 0%;
  background-color: #ffffff; /* or #ff7300 for brand orange */
  transition: width 0.3s ease;
}

.underline-hover:hover::after {
  width: 100%;
}

.how-different {
  padding: 4rem 2rem;
}

    /* Container for about section */
    .container {
      max-width: 1200px;
      margin: 0 auto;
      padding: 0 1.5rem;
    }

    .about-section {
      width: 100%;
      margin: 0 auto;
      padding: 4rem 0;
      background: #fff;
      color: black;
      font-family: 'Roboto', sans-serif;
    }

    .about-heading {
      text-align: left;
      font-family: 'Helvetica', sans-serif;
      font-size: 2rem;
      
    }

    .about-underline {
      height: 2px;
      background-color: var(--brand-color, #ff7300);
      width: 100%;
      margin: 0 auto 2rem;
      border-radius: 2px;
    }

    .about-card {
      display: flex;
      flex-direction: row;
      gap: 2rem;
      background: white;
      padding: 2rem;
      border-radius: 12px;
      box-shadow: 2px 6px 15px rgba(0, 0, 0, 0.3);
      max-width: 100%;
      margin: 0 auto;
      
    }

    .about-column {
      flex: 1;
      display: flex;
      flex-direction: column;
    }

    .about-subheading {
      font-family: 'Helvetica', sans-serif;
      font-size: 1rem;
      font-weight: 700;
      margin-bottom: 0.75rem;
      text-align: left;
    }

    .about-text {
      font-family: 'Roboto', sans-serif;
      font-weight: 400;
      font-size: 1rem;
      line-height: 1.5;
      display: block;
      text-align: left;
    }

    .about-separator {
      width: 1px;
      background-color: #ddd;
    }

  
    /* ====== Responsive Mobile Styles ====== */
    @media (max-width: 767px) {
      .hero {
        height: 100vh;                 /* slightly smaller hero */
    background-size: 150%;      /* show full image */
    background-position: top center; /* image starts from top */
    background-repeat: no-repeat;
    padding-top: 2rem; 
      }

      .hero h1 {
        padding-left: 0;   /* less horizontal padding */
        padding-right: 0;
        font-size: 4rem !important;       /* smaller font for h1 */
        text-align: center;                 /* center align text */
        max-width: 90vw;                   /* limit width to viewport */
        margin-left: auto;
        margin-right: auto;
        margin-top: 0rem;
        text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.8);

      }

      .hero p {
        padding-left: 0;   /* less horizontal padding */
        padding-right: 0;
        font-size: 1rem ;       /* smaller font for h1 */
        text-align: center;                 /* center align text */
        max-width: 90vw;                   /* limit width to viewport */
        margin-left: auto;
        margin-right: auto;
        margin-top: 5rem;
        text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.8);
      }

      .cta-button {
        padding-left: 2rem;
        padding-right: 2rem;
        box-shadow: 2px 2px 4px rgba(0, 0, 0, 0.8);
        margin-top: 1rem;   /* moves it downward from the paragraph */
        margin-bottom: -5rem;
        
      }

      .underline-hover {
  position: relative;
  display: inline-block;
  text-decoration: none;
}

.underline-hover::after {
  content: '';
  position: absolute;
  bottom: -2px;
  left: 0;
  height: 2px;
  width: 0%;
  background-color: #ffffff; /* or #ff7300 for brand orange */
  transition: width 0.3s ease;
}

.underline-hover:hover::after {
  width: 100%;
}

.how-different {
  padding: 4rem 2rem;
}

      .about-section {
        padding: 2rem 1rem;
      }

      .about-heading {
        font-size: 2rem;
        text-align: center;
        margin-bottom: 1.5rem;
      }

      .about-card {
        flex-direction: column;
        padding: 1.5rem;
