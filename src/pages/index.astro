  -webkit-box-orient: vertical;
  overflow: hidden;
}

/* Fade-out gradient at bottom when clamped */
.testimonial-card:not(.expanded) .testimonial-text::after {
  content: "";
  position: absolute;
  bottom: 0;
  left: 0;
  width: 100%;
  height: 30px;
  background: linear-gradient(to bottom, rgba(0,0,0,0), rgba(0,0,0,1));
  pointer-events: none;
}

/* When expanded → remove clamp + remove fade */
.testimonial-card.expanded .testimonial-text {
  display: block;          /* remove clamp */
  max-height: none !important;
}

.testimonial-card.expanded .testimonial-text::after {
  display: none;
}

