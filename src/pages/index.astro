<script>
document.addEventListener("DOMContentLoaded", function () {

  /* ===== SCOPE EVERYTHING TO TESTIMONIALS SECTION ===== */
  const section = document.querySelector(".testimonials");
  if (!section) return;

  const row = section.querySelector("#testimonialRow");
  const leftBtn = section.querySelector(".scroll-btn.left");
  const rightBtn = section.querySelector(".scroll-btn.right");

  if (!row || !leftBtn || !rightBtn) return;

  /* ===== SCROLL FUNCTION ===== */
  function scrollTestimonials(direction) {
    const card = row.querySelector(".testimonial-card");
    if (!card) return;

    const gap = parseInt(getComputedStyle(row).gap) || 0;
    const cardWidth = card.offsetWidth + gap;

    row.scrollBy({
      left: direction * cardWidth,
      behavior: "smooth"
    });

    setTimeout(updateArrowState, 400);
  }

  /* ===== ENABLE / DISABLE ARROWS ===== */
  function updateArrowState() {
    const scrollLeft = Math.ceil(row.scrollLeft);
    const maxScrollLeft = row.scrollWidth - row.clientWidth;

    if (scrollLeft <= 0) {
      leftBtn.classList.add("at-start");
    } else {
      leftBtn.classList.remove("at-start");
    }

    if (scrollLeft >= maxScrollLeft - 1) {
      rightBtn.classList.add("at-end");
    } else {
      rightBtn.classList.remove("at-end");
    }
  }

  /* ===== ARROW CLICK EVENTS ===== */
  leftBtn.addEventListener("click", () => scrollTestimonials(-1));
  rightBtn.addEventListener("click", () => scrollTestimonials(1));

  /* ===== READ MORE TOGGLE ===== */
  section.querySelectorAll(".read-more-btn").forEach(btn => {
    btn.addEventListener("click", function () {
      const card = btn.closest(".testimonial-card");
      card.classList.toggle("expanded");
      btn.textContent = card.classList.contains("expanded")
        ? "Read Less"
        : "Read More";
    });
  });

  /* ===== DESKTOP DRAG SCROLL ===== */
  let isDown = false;
  let startX;
  let scrollLeftStart;

  row.addEventListener("mousedown", (e) => {
    isDown = true;
    row.classList.add("dragging");
    startX = e.pageX - row.offsetLeft;
    scrollLeftStart = row.scrollLeft;
  });

  row.addEventListener("mouseleave", () => {
    isDown = false;
    row.classList.remove("dragging");
  });

  row.addEventListener("mouseup", () => {
    isDown = false;
    row.classList.remove("dragging");
    updateArrowState();
  });

  row.addEventListener("mousemove", (e) => {
    if (!isDown) return;
    e.preventDefault();
    const x = e.pageX - row.offsetLeft;
    const walk = startX - x;
    row.scrollLeft = scrollLeftStart + walk;
  });

  /* ===== TOUCH SCROLL (MOBILE) ===== */
  row.addEventListener("touchstart", (e) => {
    startX = e.touches[0].pageX - row.offsetLeft;
    scrollLeftStart = row.scrollLeft;
  });

  row.addEventListener("touchmove", (e) => {
    const x = e.touches[0].pageX - row.offsetLeft;
    const walk = startX - x;
    row.scrollLeft = scrollLeftStart + walk;
  });

  row.addEventListener("touchend", updateArrowState);

  /* ===== INITIAL STATE ===== */
  updateArrowState();
});
</script>

<script>
document.addEventListener("DOMContentLoaded", () => {
  const sections = document.querySelectorAll(".trek-cards-wrapper");
  
  sections.forEach(wrapper => {
    const row = wrapper.querySelector(".trek-cards-scroll");
    const leftBtn = wrapper.querySelector(".scroll-btn.left");
    const rightBtn = wrapper.querySelector(".scroll-btn.right");

    let autoScrollInterval;
    let isUserInteracting = false;

    // Update button classes instead of disabled
    function updateButtons() {
      if (row.scrollLeft <= 0) {
        leftBtn.classList.add("at-start");
      } else {
        leftBtn.classList.remove("at-start");
      }

      if (row.scrollLeft + row.clientWidth >= row.scrollWidth - 1) {
        rightBtn.classList.add("at-end");
      } else {
        rightBtn.classList.remove("at-end");
      }
    }

    function scroll(direction) {
      const card = row.querySelector(".trek-card");
      if (!card) return;
      const gap = parseInt(getComputedStyle(row).gap) || 16;
      const scrollAmount = (card.offsetWidth + gap) * direction;
      row.scrollBy({ left: scrollAmount, behavior: "smooth" });

      setTimeout(updateButtons, 300);
    }

    // ✅ AUTO SCROLL FUNCTION
    function startAutoScroll() {
      autoScrollInterval = setInterval(() => {
        if (isUserInteracting) return;

        const maxScroll = row.scrollWidth - row.clientWidth;

        // If reached end → reset + reshuffle
        if (row.scrollLeft >= maxScroll - 5) {
          row.scrollTo({ left: 0, behavior: "smooth" });

          const cards = Array.from(row.children);
          const shuffled = cards.sort(() => Math.random() - 0.5);
          shuffled.forEach(card => row.appendChild(card));

        } else {
          scroll(1);
        }
      }, 2500);
    }

    // ✅ STOP ON USER INTERACTION
    function stopAutoScroll() {
      isUserInteracting = true;
      clearInterval(autoScrollInterval);

      setTimeout(() => {
        isUserInteracting = false;
        startAutoScroll();
      }, 4000);
    }

    // ✅ BUTTON EVENTS (manual override)
    leftBtn.addEventListener("click", () => {
      stopAutoScroll();
      scroll(-1);
    });

    rightBtn.addEventListener("click", () => {
      stopAutoScroll();
      scroll(1);
    });

    // ✅ USER INTERACTION EVENTS
    row.addEventListener("mouseenter", stopAutoScroll);
    row.addEventListener("touchstart", stopAutoScroll);

    row.addEventListener("scroll", updateButtons);
    updateButtons();

    // ✅ START AUTO SCROLL
    startAutoScroll();
  });
});
</script>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const faqTopics = document.querySelectorAll(".faq-topic");

    // --- Topic Toggle ---
    faqTopics.forEach(topic => {
      const header = topic.querySelector(".faq-topic-header");
      const body = topic.querySelector(".faq-topic-body");

      header.addEventListener("click", () => {
        const expanded = header.getAttribute("aria-expanded") === "true";
        header.setAttribute("aria-expanded", !expanded);
        body.hidden = expanded;
        body.style.display = expanded ? "none" : "block";
        header.querySelector(".topic-toggle").textContent = expanded ? "▶" : "▼";
      });
    });

    // --- Subtopic Toggle ---
    document.querySelectorAll(".faq-subtopic").forEach(sub => {
      const subHeader = sub.querySelector(".faq-subtopic-header");
      const subBody = sub.querySelector(".faq-subtopic-body");
      if (!subHeader || !subBody) return;

      subHeader.addEventListener("click", () => {
        const expanded = subHeader.getAttribute("aria-expanded") === "true";
        subHeader.setAttribute("aria-expanded", !expanded);
        subBody.hidden = expanded;
        subBody.style.display = expanded ? "none" : "block";
        subHeader.querySelector(".subtopic-toggle").textContent = expanded ? "▸" : "▾";
      });
    });

    // --- FAQ Question Toggle ---
    document.querySelectorAll(".faq-item").forEach(item => {
      const btn = item.querySelector(".faq-question");
      const answer = item.querySelector(".faq-answer");
      if (!btn || !answer) return;

      btn.addEventListener("click", () => {
        const expanded = btn.getAttribute("aria-expanded") === "true";
        btn.setAttribute("aria-expanded", !expanded);
        answer.hidden = expanded;
        btn.querySelector(".faq-toggle").textContent = expanded ? ">" : "v";
      });
    });
  });
</script>

<script>
document.addEventListener("DOMContentLoaded", () => {
  const cube = document.querySelector(".cube");
  const dots = document.querySelectorAll(".carousel-dots button");
  const leftArrow = document.querySelector(".carousel-arrow.left");
  const rightArrow = document.querySelector(".carousel-arrow.right");
  const totalFaces = 3;
  const rotateDelay = 15000;

  let currentIndex = 0;
  let autoRotateTimeout;

  // Smooth CSS transition
  cube.style.transition = "transform 1s ease-in-out";

  function rotateCube(index) {
    currentIndex = (index + totalFaces) % totalFaces; // wrap-around
    cube.style.transform = `rotateY(${-currentIndex * 90}deg)`;
    dots.forEach((dot, i) => dot.classList.toggle("active", i === currentIndex));
  }

  function showNext() { rotateCube(currentIndex + 1); }
  function showPrev() { rotateCube(currentIndex - 1); }

  function scheduleAutoRotate() {
    clearTimeout(autoRotateTimeout);
    autoRotateTimeout = setTimeout(() => {
      showNext();
      scheduleAutoRotate(); // loop
    }, rotateDelay);
  }

  // Arrow click
  leftArrow.addEventListener("click", () => { showPrev(); scheduleAutoRotate(); });
  rightArrow.addEventListener("click", () => { showNext(); scheduleAutoRotate(); });

  // Dots click
  dots.forEach((dot, i) => dot.addEventListener("click", () => { rotateCube(i); scheduleAutoRotate(); }));

  // Pause on hover
  const hero = document.querySelector(".hero-carousel-3d");
  hero.addEventListener("mouseenter", () => clearTimeout(autoRotateTimeout));
  hero.addEventListener("mouseleave", scheduleAutoRotate);

  // Mobile swipe
  let startX = 0;
  hero.addEventListener("touchstart", e => startX = e.touches[0].clientX);
  hero.addEventListener("touchend", e => {
    const endX = e.changedTouches[0].clientX;
    if (startX - endX > 50) showNext();
    if (endX - startX > 50) showPrev();
    scheduleAutoRotate();
  });

  // Initialize
  rotateCube(0);
  scheduleAutoRotate();
});
</script>

<script src="https://cdn.jsdelivr.net/npm/intl-tel-input@23.0.10/build/js/intlTelInput.min.js"></script>
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/intl-tel-input@23.0.10/build/css/intlTelInput.css" />

<script>
document.addEventListener("DOMContentLoaded", () => {
  const phoneHome = document.querySelector("#phone-home");

  // intl-tel-input for phone
  const phoneIti = intlTelInput(phoneHome, {
    initialCountry: "in",
    separateDialCode: true,
    utilsScript: "https://cdn.jsdelivr.net/npm/intl-tel-input@23.0.10/build/js/utils.js",
  });

  const form = document.querySelector("#homepageLeadForm");
  const thankYou = document.querySelector("#leadgenThankYou");
  const errorMsg = document.querySelector("#leadgenError");

  form.addEventListener("submit", async (e) => {
    e.preventDefault();
    phoneHome.value = phoneIti.getNumber(); // full intl number

    const formData = new FormData(form);

    try {
      const res = await fetch(form.action, {
        method: 'POST',
        body: formData,
        headers: { 'Accept': 'application/json' }
      });

      if (res.ok) {
        form.style.display = 'none';
        errorMsg.style.display = 'none';
        thankYou.style.display = 'block';
        thankYou.scrollIntoView({ behavior: 'smooth' });
      } else {
        errorMsg.textContent = 'There was a problem submitting the form. Please try again.';
        errorMsg.style.display = 'block';
      }
    } catch (err) {
      errorMsg.textContent = 'There was a problem submitting the form. Please try again.';
      errorMsg.style.display = 'block';
    }
  });
});
</script>

<script>
document.addEventListener("DOMContentLoaded", () => {
  const wrapper = document.querySelector(".trek-text-wrapper");
  const text = wrapper.querySelector(".trek-snippet");
  const btn = wrapper.querySelector(".read-more-btn");

  // Check if text actually exceeds 5 lines
  const lineHeight = parseFloat(getComputedStyle(text).lineHeight);
  const maxHeight = lineHeight * 5;

  if (text.scrollHeight <= maxHeight + 2) {
    btn.style.display = "none";
    text.style.webkitLineClamp = "unset";
    text.style.overflow = "visible";
    text.classList.add("no-fade");
    return;
  }

  btn.addEventListener("click", () => {
    wrapper.classList.toggle("expanded");
    btn.textContent = wrapper.classList.contains("expanded")
      ? "Read less ←"
      : "Read more →";
  });
});
</script>



