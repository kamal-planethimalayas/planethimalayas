  color: black;
  
}

/* Wrapper for scroll + buttons */
.trek-cards-wrapper {
  position: relative;
  width: 100%;
}

/* Horizontal scroll container */
.trek-cards-scroll {
  display: flex;
  gap: 1rem;
  overflow-x: auto;
  scroll-behavior: smooth;
  padding: 1rem 0;
  scroll-snap-type: x mandatory;
  -webkit-overflow-scrolling: touch;
}

/* Individual card */
.trek-card {
  flex: 0 0 33.333%;  /* 3 per row desktop */
  scroll-snap-align: start;
  background: #fff;
  border-radius: 8px;
  box-shadow: 
    0 4px 8px rgba(0, 0, 0, 0.1),        /* subtle base shadow */
    0 8px 20px rgba(0, 0, 0, 0.15);       /* deeper shadow for depth */
  display: flex;
  flex-direction: column;
  overflow: hidden;
  min-width: 0;
  transition: 
    transform 0.3s cubic-bezier(0.4, 0, 0.2, 1), 
    box-shadow 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    will-change: transform, box-shadow;
}

