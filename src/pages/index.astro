<!-- CURRENT TREKS: Monsoon Treks -->
<section class="trek-section">
  <h2>Current Treks</h2>
  <div class="about-underline"></div>
  <div class="trek-cards-wrapper">
    <button class="scroll-btn left" onclick="scrollCards('monsoon', -1)">&lt;</button>
    <div class="trek-cards-scroll" id="monsoon">
      {
        treks
          .filter(trek => {
            if (!trek.season) return false;
            const seasons = Array.isArray(trek.season) ? trek.season : [trek.season];
            return seasons.map(s => String(s).toLowerCase()).includes('monsoon');
          })
          .map(trek => {
            const duration = trek.overview?.facts?.find(f => f.label === "Trek Duration")?.value || trek.duration;
            const difficultyStr = Array.isArray(trek.difficulty) ? trek.difficulty.join(', ') : trek.difficulty;
            return (
              <div class="trek-card" key={trek.id}>
                <a href={`/trek/${trek.id}#trek-hero`}>
                  <img src={trek.heroImage} alt={`View of ${trek.name} trek`} loading="lazy" />
                </a>
                <h3 class="trek-name">{trek.name}</h3>
                <div class="trek-info">{duration} | {trek.region}</div>
                <div class="trek-difficulty">{difficultyStr}</div>
                <div class="trek-buttons">
                  <a href={`/trek/${trek.id}#highlights`} class="btn btn-details">View Details</a>
                  <a href={`/trek/${trek.id}#pricing-details`} class="btn btn-dates">View Dates</a>
                </div>
              </div>
            );
          })
      }
    </div>
    <button class="scroll-btn right" onclick="scrollCards('monsoon', 1)">&gt;</button>
  </div>
</section>

