<script>
document.addEventListener("DOMContentLoaded", function () {
  const row = document.getElementById("testimonialRow");
  const leftBtn = document.querySelector(".scroll-btn.left");
  const rightBtn = document.querySelector(".scroll-btn.right");

  // Scroll Function
  function scrollTestimonials(direction) {
    const card = row.querySelector(".testimonial-card");
    if (!card) return;

    const gap = parseInt(getComputedStyle(row).gap) || 0;
    const cardWidth = card.offsetWidth + gap;

    row.scrollBy({
      left: direction * cardWidth,
      behavior: "smooth"
    });

    setTimeout(updateArrowState, 400); // update after scroll animation
  }

  // Enable/Disable Arrows at edges
  function updateArrowState() {
    leftBtn.disabled = row.scrollLeft <= 0;
    rightBtn.disabled = row.scrollLeft + row.clientWidth >= row.scrollWidth;
  }

  // Attach Events to arrows
  leftBtn.addEventListener("click", () => scrollTestimonials(-1));
  rightBtn.addEventListener("click", () => scrollTestimonials(1));

  // Initial state
  updateArrowState();

  // Read More Toggle
  document.querySelectorAll('.read-more-btn').forEach(btn => {
    btn.addEventListener('click', function() {
      const card = btn.closest('.testimonial-card');
      card.classList.toggle('expanded');
      btn.textContent = card.classList.contains('expanded') ? 'Read Less' : 'Read More';
    });
  });
});
</script>


<script type="module">
function scrollCards(sectionId, direction) {
  const container = document.getElementById(sectionId);
  if (!container) return;

  // Calculate scroll by card width + gap
  const card = container.querySelector('.trek-card');
  if (!card) return;
  
  const style = window.getComputedStyle(container);
  const gap = parseInt(style.gap) || 16; // default 1rem if not set
  const scrollAmount = (card.offsetWidth + gap) * direction;

  container.scrollBy({
    left: scrollAmount,
    behavior: 'smooth'
  });
}

// Expose globally so onclick works
window.scrollCards = scrollCards;
</script>

<script>
  // Topic toggles
  document.querySelectorAll(".faq-topic-header").forEach(header => {
    header.addEventListener("click", () => {
      const expanded = header.getAttribute("aria-expanded") === "true";
      header.setAttribute("aria-expanded", !expanded);

      const body = header.nextElementSibling;
      body.setAttribute("data-open", !expanded);
      body.setAttribute("aria-hidden", expanded);
      body.style.display = expanded ? "none" : "block";
      header.querySelector(".topic-toggle").textContent = expanded ? "▶" : "▼";
    });
  });

  // Individual FAQ toggles
  document.querySelectorAll(".faq-question").forEach(question => {
    question.addEventListener("click", () => {
      const expanded = question.getAttribute("aria-expanded") === "true";
      question.setAttribute("aria-expanded", !expanded);

      const answer = question.nextElementSibling;
      answer.hidden = expanded;
      question.querySelector(".faq-toggle").textContent = expanded ? ">" : "v";
    });
  });
</script>

<script>
const heroContainer = document.querySelector(".hero .container");
const hero = document.querySelector(".contact-hero");

window.addEventListener("scroll", () => {
  const heroRect = hero.getBoundingClientRect();
