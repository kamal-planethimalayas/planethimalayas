box-shadow:
0 4px 14px rgba(0, 0, 0, 0.22);

transition:
background 0.2s ease,
color 0.2s ease,
transform 0.2s ease,
box-shadow 0.2s ease;
}

/* ===============================
CTA HOVER
================================ */

.btn-book:hover {
background: #ff7300;
color: #000;

transform: translateY(-1px);

box-shadow:
0 6px 18px rgba(0, 0, 0, 0.28);
}

