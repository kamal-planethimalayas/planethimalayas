  backdrop-filter: blur(3px);
}

.leadgen-content {
  position: relative;
  max-width: 900px;
  margin: auto;
  text-align: center;
  color: white;
}

.section-heading {
  font-family: Helvetica, sans-serif;
  font-size: 2.5rem;
  font-weight: 700;
  display: inline-block;
  padding-bottom: 6px;
  margin-bottom: 20px;
