    flex: 0 0 100%;
  }
}

/* Card image */
.trek-card img {
  width: 100%;
  height: 160px;
  object-fit: cover;
  transition: transform 0.3s ease;
    will-change: transform;
}

.trek-card:hover img {
    transform: scale(1.25) rotate(-1deg);
}

/* Card text */
.trek-name {
  font-weight: 700;
  font-size: 1.5rem;
  color: #ff7300;
  text-align: center;
  margin: 0.5rem 0;
  text-shadow: 0 1px 2px rgba(0,0,0,0.1);
}

.trek-info, .trek-difficulty {
  text-align: center;
  margin: 0 0.5rem 0.5rem;
  font-size: 1rem;
  color: black;
  font-weight: 700;
