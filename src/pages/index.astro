---
import Layout from '../layouts/Layout.astro';
import { treks } from '../data/treksData.js';
import { generalFAQs } from "../data/faqsData.js";
import NewsBanner from "../components/NewsBanner.jsx";
import NewsSection from "../components/NewsSection.jsx";
import "../styles/global.css";
---

<Layout title="Planethimalayas">

<!-- Top banner -->
<div class="banner-wrapper">
  <NewsBanner client:load />
</div>

<section class="hero-carousel-3d">
  <div class="cube-wrapper">
    <div class="cube">

      <!-- Front Face -->
      <div class="cube-face front" style="background-image: url('https://res.cloudinary.com/dr44hob9b/image/upload/v1761810023/love-himalayas_zz3cyf.jpg');">
        <div class="overlay"></div>
        <div class="hero-content">
          <h1>More Than Just A Trek</h1>
          <a href="/upcoming-treks" class="cta-button">Upcoming Treks</a>
          <p class="hero-subheading">
            Join our treks, thoughtfully crafted for deeply personal mountain experiences with unwavering focus on individual care, safety, and a genuine love for the Himalayas.
          </p>
        </div>
      </div>

      <!-- Right Face -->
      <div class="cube-face right" style="background-image: url('https://res.cloudinary.com/dr44hob9b/image/upload/v1761810048/journey-1_w9t3zk.jpg');">
        <div class="overlay"></div>
        <div class="hero-content">
          <h1>Not Just a Trek — A Journey That Stays With You</h1>
          <a href="/upcoming-treks" class="cta-button">Upcoming Treks</a>
          <p class="hero-subheading">
            Every trail we walk is a carefully chosen path into the heart of the Himalayas — not just to witness their grandeur, but to feel them under your skin and soul.
          </p>
        </div>
      </div>

      <!-- Back Face -->
      <div class="cube-face back" style="background-image: url('https://res.cloudinary.com/dr44hob9b/image/upload/v1761809893/care_pzucvr.jpg');">
        <div class="overlay"></div>
        <div class="hero-content">
          <h1>Individual Care, Every Step of the Way</h1>
          <a href="/upcoming-treks" class="cta-button">Upcoming Treks</a>
          <p class="hero-subheading">
            We keep our groups small so we can focus on you — your pace, your concerns, your joy. Our leaders walk with intention, offering safety and attention without intrusion.
          </p>
        </div>
      </div>

      <!-- Left Face -->
      <div class="cube-face left" style="background-image: url('https://res.cloudinary.com/dr44hob9b/image/upload/v1761810048/love-himalayas-3_fpus1m.jpg');">
        <div class="overlay"></div>
        <div class="hero-content">
          <h1>Built on Genuine Love for the Himalayas</h1>
          <a href="/upcoming-treks" class="cta-button">Upcoming Treks</a>
          <p class="hero-subheading">
            We live and breathe these mountains. With Planethimalayas, your trek becomes a way of giving back to the Himalayas that give us so much.
          </p>
        </div>
      </div>

    </div>
  </div>

  <!-- Arrows (for desktop) -->
  <button class="carousel-arrow left">&#10094;</button>
  <button class="carousel-arrow right">&#10095;</button>

  <!-- Dots -->
  <div class="carousel-dots">
    <button class="active"></button>
    <button></button>
    <button></button>
    <button></button>
  </div>
</section>

<div class="container">
<!-- Testimonials Section -->
<section class="testimonials reveal">
  <h2 class="testimonials-heading">What our <span>trekkers say</span></h2>

  <!-- Wrapper to hold arrows + cards -->
  <div class="testimonials-wrapper" style="position: relative;">
    <!-- Left Arrow -->
    <button class="scroll-btn left" onclick="scrollTestimonials(-1)">&#10094;</button>
    <!-- Right Arrow -->
    <button class="scroll-btn right" onclick="scrollTestimonials(1)">&#10095;</button>

    <!-- Card Container -->
    <div class="testimonials-card-wrapper" id="testimonialRow">
      
      <!-- Testimonial Card 1 -->
      <div class="testimonial-card">
        <div class="testimonial-header">
          <img src="https://res.cloudinary.com/dr44hob9b/image/upload/v1762540205/Screenshot_20251107-235350.Instagram_nvs4zy.jpg" alt="Ananya Mitra" class="testimonial-pic" />
          <div class="testimonial-info">
            <h3 class="testimonial-name">Ananya Mitra</h3>
            <p class="testimonial-profession">Kolkata</p>
            <div class="testimonial-social">
              <a href="https://instagram.com/ananya_mitra22" target="_blank">
                <i class="fab fa-instagram"></i> @ananya_mitra22
              </a>
            </div>
            <div class="testimonial-stars">★★★★★</div>
          </div>
        </div>
        <p class="testimonial-text">
          Kamal Das the leader and founder is a great person and had good knowledge about the route. The food was great and the stays were comfortable which was above the expectation in that altitude.<br>Thanks to Planethimalayas.
        </p>
        <button class="read-more-btn">Read More</button>
      </div>

      <!-- Testimonial Card 2 -->
      <div class="testimonial-card">
        <div class="testimonial-header">
          <img src="/images/main/jytte.png" alt="Jytte Scheepens" class="testimonial-pic" />
          <div class="testimonial-info">
            <h3 class="testimonial-name">Jytte Scheepens</h3>
            <p class="testimonial-profession">Freelancer | Breda, Netherlands</p>
            <div class="testimonial-social">
              <a href="https://instagram.com/flowofjytte" target="_blank">
                <i class="fab fa-instagram"></i> @flowofjytte
              </a>
            </div>
            <div class="testimonial-stars">★★★★★</div>
          </div>
        </div>
        <p class="testimonial-text">
        I did the Kashmir Great Lakes trek with kamal. This was such an unforgettable experience. Kamal is such an amazing guide. He told us so many interesting facts, I had beautiful deep talks with him about the mountains and listened to many of his stories about the experiences he's had while trekking. he's such a genuine and pure soul. I was the only female in the team, but not once I felt uncomfortable or left out. Everyone was increrdibly respectful and nice. We were allowed to walk on our own pace and didn't feel rushed or pushed. Everone can do the trek as they want, in the way they want. He respects you and really goes out of his way to make you enjoy the most. Till this day he's still a dear friend of mine and I hope to have the priviledge to go to the mountains again, together with him. If you're planning to do a trek, definitely do it with Kamal, he a 100% will make sure this trip is something you'll never forget about.
        </p>
        <button class="read-more-btn">Read More</button>
      </div>

      <!-- Testimonial Card 3 -->
      <div class="testimonial-card">
        <div class="testimonial-header">
          <img src="/images/main/clare.jpg" alt="Clare Fisher" class="testimonial-pic" />
          <div class="testimonial-info">
            <h3 class="testimonial-name">Clare Fisher</h3>
            <p class="testimonial-profession">Marketing | Canada</p>
            <div class="testimonial-social">
              <a href="https://instagram.com/clare.fisher" target="_blank">
                <i class="fab fa-instagram"></i> @clare.fisher
              </a>
            </div>
            <div class="testimonial-stars">★★★★★</div>
          </div>
        </div>
        <p class="testimonial-text">
          I had some nerves about going on a trek solo but Kamal took excellent care of me and made sure I felt safe and looked after. He was able to customize the trek to my needs and we went on lots of side quests to explore the area. Kamal is very knowledgable and has some fantastic stories to tell, so was the best company the entire time – it felt like I had friends adventuring with me! Thanks again :)
        </p>
        <button class="read-more-btn">Read More</button>
      </div>

      <!-- Testimonial Card 4 -->
      <div class="testimonial-card">
        <div class="testimonial-header">
          <img src="https://res.cloudinary.com/dr44hob9b/image/upload/v1762540205/Screenshot_20251107-235337.Instagram_itofyg.jpg" alt="Suramita Chakrabarty" class="testimonial-pic" />
          <div class="testimonial-info">
            <h3 class="testimonial-name">Suramita Chakrabarty</h3>
            <p class="testimonial-profession">Kolkata</p>
            <div class="testimonial-social">
              <a href="https://instagram.com/suramitachakrabarty" target="_blank">
                <i class="fab fa-instagram"></i> @suramitachakrabarty
              </a>
            </div>
            <div class="testimonial-stars">★★★★★</div>
          </div>
        </div>
        <p class="testimonial-text">
          Amazing staff with good and decent behaviour. Food quality was also very good. Through out the trek they had taken utmost care of everything.<br>Will definitely plan again with Mr. Kamal Das.
        </p>
        <button class="read-more-btn">Read More</button>
      </div>

      <!-- Testimonial Card 5 -->
      <div class="testimonial-card">
        <div class="testimonial-header">
          <img src="/images/main/samar.jpeg" alt="Samar" class="testimonial-pic" />
          <div class="testimonial-info">
            <h3 class="testimonial-name">Samar</h3>
            <p class="testimonial-profession">Automotive UX Designer | Pune</p>
            <div class="testimonial-social">
              <a href="https://instagram.com/wheelspin_199" target="_blank">
                <i class="fab fa-instagram"></i> @wheelspin_199
              </a>
            </div>
            <div class="testimonial-stars">★★★★★</div>
          </div>
        </div>
        <p class="testimonial-text">
          I made friendship with the mountains through Kamal sirs experience. The moment i met him at my last trek at Kedarkantha, I was impressed by his mountaineering knowledge and friendly nature that this year too (to Tungnath) and every year hereafter I am going to partner him to a new peak and new experiences in those journeys. Kudos to Planethimalayas for the exceptional work in making the love of mountains more accessible and enjoyable.
        </p>
        <button class="read-more-btn">Read More</button>
      </div>

      <!-- Testimonial Card 6 -->
      <div class="testimonial-card">
        <div class="testimonial-header">
          <img src="/images/main/akshata.jpg" alt="Akshata Poojari" class="testimonial-pic" />
          <div class="testimonial-info">
            <h3 class="testimonial-name">Akshata Poojari</h3>
            <p class="testimonial-profession">Bangalore</p>
            <div class="testimonial-social">
              <a href="https://instagram.com/akshata_r_poojari" target="_blank">
                <i class="fab fa-instagram"></i> @akshata_r_poojari
              </a>
            </div>
            <div class="testimonial-stars">★★★★★</div>
          </div>
        </div>
        <p class="testimonial-text">
          The trekking experience was absolutely unforgettable..Our guide was friendly and knowledgeable, making the whole journey fun and safe.
        </p>
        <button class="read-more-btn">Read More</button>
      </div>


    </div> <!-- /#testimonialRow -->
  </div> <!-- /.testimonials-wrapper -->
</section> <!-- /.testimonials -->

<!-- UPCOMING TREKS: Winter Treks -->
<section class="trek-section reveal">
  <h2>Upcoming <span>Treks</span></h2>
  <div class="trek-cards-wrapper">
    <button class="scroll-btn left" onclick="scrollCards('winter', -1)">&lt;</button>
    <div class="trek-cards-scroll" id="winter">
      {
        treks
          .filter(trek => Array.isArray(trek.season) && trek.season.map(s => s.toLowerCase()).includes('winter'))
          .map(trek => {
            const duration = trek.overview?.facts?.find(f => f.label === "Trek Duration")?.value || trek.duration;
            const difficultyStr = Array.isArray(trek.difficulty) ? trek.difficulty.join(', ') : trek.difficulty;
            // Capitalize function
      const capitalize = (str) => {
  if (!str) return '';

  // If it's an array (difficulty, tags etc.)
  if (Array.isArray(str)) {
    return str
      .map(item => capitalize(item))   // Recursively capitalize each item
      .join(', ');
  }

  // If it's a string
  return str
    .split(' ')
    .map(word =>
      word
        .split('-') // also split hyphens
        .map(part => part.charAt(0).toUpperCase() + part.slice(1))
        .join('-')  // join hyphens back
    )
    .join(' ');
};
            return (
              <div class="trek-card" key={trek.id}>
                <a href={`/trek/${trek.id}#trek-hero`}>
                  <img src={trek.heroImage} alt={`View of ${trek.name} trek`} loading="lazy" />
                </a>
                <h3 class="trek-name">{trek.name}</h3>
                <div class="trek-info">
                  <span>
                    <i class="fa fa-clock"></i> {duration}
                  </span>
                  <span>
                    <i class="fa fa-map-marker-alt"></i> {capitalize(trek.region)}
                  </span>
                </div>
                <div class="trek-difficulty">{capitalize(difficultyStr)}</div>
                <div class="trek-buttons">
                  <a href={`/trek/${trek.id}#trek-overview-section`} class="btn btn-details">View Details</a>
                  <a href={`/trek/${trek.id}#pricing-snippet-wrapper`} class="btn btn-dates">View Dates</a>
                </div>
              </div>
            );
          })
      }
    </div>
    <button class="scroll-btn right" onclick="scrollCards('winter', 1)">&gt;</button>
  </div>
</section>

<section class="leadgen-section reveal">
  <div class="leadgen-overlay"></div>

  <div class="leadgen-content">
    <h2 class="section-heading">Plan Your <span>Himalayan Adventure</span></h2>
    <p class="section-sub">
      Get a personalised itinerary, dates & expert guidance from Planethimalayas.
    </p>

    <form id="homepageLeadForm" action="https://formspree.io/f/xrbldkrb" method="POST">
      <div class="form-row">
        <input type="text" name="name" placeholder="Your Name" required />
        <input type="email" name="email" placeholder="Email Address" required />
      </div>

      <div class="form-row">
        <input type="text" id="phone-home" name="phone" placeholder="Phone Number" required />
        <input type="text" name="trek" placeholder="Interested Trek (optional)" />
      </div>

      <div class="custom-message-field">
        <textarea name="plan-details" placeholder="Tell us what you're planning…"></textarea>
      </div>

      <button type="submit" class="leadgen-btn">Get Details</button>
    </form>

    <!-- Error message -->
    <div id="leadgenError" style="display:none; color:red; margin-top:20px; text-align:center;"></div>

    <!-- Thank-you message -->
    <div id="leadgenThankYou" style="display:none; text-align:center; margin-top:30px;">
      <h3 style="color:#ff7300; text-shadow:0 0 8px #ff7300;">Thank You!</h3>
      <p style="color:white;">We’ve received your details. Our team will reach out shortly.</p>
      <a href="/upcoming-treks" class="leadgen-btn">Explore Upcoming Treks</a>
    </div>
  </div>
</section>

<!-- News Section -->
<section class="news-section reveal">
  <h2 class="news-section-heading">News & <span>Articles</span></h2>
  <NewsSection client:load />
</section>

<!-- Faqs Section -->
<section class="faqs-section reveal">
    <h2 class="faqs-section-heading">FA<span>Qs</span></h2>

    <!-- FAQ topics -->
<!-- FAQ topics -->
{generalFAQs.map((section, sectionIndex) => (
          <div class="faq-topic" id={`faq-topic-${sectionIndex}`}>
            <button class="faq-topic-header" aria-expanded="false">
              {section.topic}
              <span class="toggle">▶</span>
            </button>
            <div class="faq-topic-body" hidden>
              {section.sections
                ? section.sections.map((sub, subIndex) => (
                    <div class="faq-subtopic" id={`faq-${sectionIndex}-${subIndex}`}>
                      <button class="faq-subtopic-header" aria-expanded="false">
                        {sub.subtopic}
                        <span class="toggle">▶</span>
                      </button>
                      <div class="faq-subtopic-body" hidden>
                        {sub.faqs.map((faq, faqIndex) => (
                          <div class="faq-item" id={`faq-${sectionIndex}-${subIndex}-${faqIndex}`}>
                            <button class="faq-question" aria-expanded="false">
                              {faq.question}
                              <span class="toggle">+</span>
                            </button>
                            <div class="faq-answer" hidden>
                              <div set:html={faq.answer}></div>
                            </div>
                          </div>
                        ))}
                      </div>
                    </div>
                  ))
                : section.faqs.map((faq, faqIndex) => (
                    <div class="faq-item" id={`faq-${sectionIndex}-${faqIndex}`}>
                      <button class="faq-question" aria-expanded="false">
                        {faq.question}
                        <span class="toggle">+</span>
                      </button>
                      <div class="faq-answer" hidden>
                        <div set:html={faq.answer}></div>
                      </div>
                    </div>
              ))}
            </div>
          </div>
))}

    <!-- Link to full FAQs page -->
    <div class="faq-footer">
      <a href="/faqs" target='_blank' rel='noopener noreferrer'>Explore all FAQs →</a>
    </div>
</section>

<style>

.banner-wrapper {
  width: 100%;
  height: 30px;
  position: absolute;   /* pulls it out of flow */
  top: 110px;           /* two navbars stacked (55px each) */
  z-index: 90;          /* above hero but below navbars */
  background: transparent;
  overflow: hidden;
}

@media (max-width: 768px) {
  .banner-wrapper {
    top: 55px; /* only one navbar in mobile */
  }
}

.hero-carousel-3d {
  perspective: 30000px;
  width: 100%;
  height: 120vh;
  position: relative;
  overflow: hidden;
  color: white;
}

.cube-wrapper {
  width: 100%;
  height: 120vh;
  position: relative;
  transform-style: preserve-3d;
}

.cube {
  width: 100%;
  height: 100%;
  position: absolute;
  transform-style: preserve-3d;
  transform: rotateY(0deg);
  transition: transform 1s linear;
}

/* Cube faces */
.cube-face {
  position: absolute;
  width: 100%;
  height: 100%;
  background-size: cover;
  background-position: center;
  backface-visibility: hidden;
}

/* Position each face */
.cube-face.front  { transform: rotateY(0deg) translateZ(50vw); }
.cube-face.right  { transform: rotateY(90deg) translateZ(50vw); }
.cube-face.back   { transform: rotateY(180deg) translateZ(50vw); }
.cube-face.left   { transform: rotateY(-90deg) translateZ(50vw); }

/* Optional overlay */
.cube-face .overlay {
  position: absolute;
  inset: 0;
  background: rgba(0,0,0,0.25);
  z-index: 1;
}

.hero-content {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  text-align: center;
  z-index: 2;
  width: 85%;
  max-width: 1000px;
}

.hero-content h1 {
  font-family: Helvetica, sans-serif;
  font-size: 4rem;
  font-weight: bold;
  margin-bottom: 3rem;
  color: white;
  text-shadow: 3px 3px 6px rgba(0, 0, 0, 0.6);
}

.hero-subheading {
  font-family: "Roboto", sans-serif;
  font-size: 1.5rem;
  margin-top: 1.5rem;
  color: white;
  text-shadow: 2px 2px 5px rgba(0, 0, 0, 0.7);
}

.cta-button {
  display: inline-block;
  background: transparent;
  color: #ff7300;
  font-family: "Roboto", sans-serif;
  font-weight: 700;
  padding: 1rem 2.5rem;
  border-radius: 8px;
  border: 2px solid #ff7300;
  text-decoration: none;
  box-shadow:
    0 4px 12px rgba(255, 115, 0, 0.45),
    0 0 10px rgba(255, 115, 0, 0.3);

  transition: transform 0.3s ease, box-shadow 0.3s ease;
}

.cta-button:hover {
  background: #ff7300;
  color: #000;
  border: 2px solid #ff7300;
  transform: translateY(-6px);

  box-shadow:
    0 8px 25px rgba(255, 115, 0, 0.8),
    0 0 22px rgba(255, 115, 0, 1); /* bright brand orange glow */
}

/* Arrows */
.carousel-arrow {
  position: absolute;
  top: 50%;
  transform: translateY(-50%);
  background: transparent;
  color: white;
  border: none;
  font-size: 2rem;
  cursor: pointer;
  z-index: 3;
  padding: 0.4rem 0.8rem;
  border-radius: 50%;
  transition: background 0.3s ease;
  box-shadow: 0 4px 10px rgba(0,0,0,0.2);
}

.carousel-arrow:hover {
  background: #ff7300;
  color: black;
  box-shadow: 0 8px 20px #ff7300, 0 6px 15px rgba(0, 0, 0, 0.4);
  transform: translateY(-50%) scale(1.05);
}

.carousel-arrow.left {
  left: 50px;
}
.carousel-arrow.right {
  right: 50px;
}

/* Dots */
.carousel-dots {
  position: absolute;
  bottom: 25px;
  left: 50%;
  transform: translateX(-50%);
  display: flex;
  gap: 10px;
  z-index: 3;
}

.carousel-dots button {
  appearance: none;
  -webkit-appearance: none;
  width: 12px;
  height: 12px;
  border-radius: 50%;
  border: 2px solid #ff7300;
  background-color: transparent;
  cursor: pointer;
  padding: 0;
  margin: 0;
  box-sizing: content-box;
  display: inline-block;
  transition: background 0.3s ease, transform 0.3s ease;
  box-shadow: 0 4px 10px rgba(0,0,0,0.2);
}

.carousel-dots button.active {
  background-color: #ff7300;
  transform: scale(1.05);
  box-shadow: 0 8px 20px #ff7300, 0 6px 15px rgba(0, 0, 0, 0.4);
}

/* Responsive */
@media (max-width: 768px) {
  .hero-carousel-3d {
    height: 90vh;
    margin-top: -55px;
  }
  .carousel-slide {
    height: 75vh;
  }
  .hero-content h1 {
    font-size: 2rem;
  }
  .hero-subheading {
    font-size: 1rem;
  }
  .cta-button {
    padding: 0.6rem 2rem;
  }
  .carousel-arrow {
    display: none; /* hide arrows on mobile */
  }
}

/* Hide dots on desktop */
@media (min-width: 769px) {
  .carousel-dots {
    display: none;
  }
}

/* Testimonials Section */
.testimonials {
  background-color: white; 
  color: #000;            /* white text globally */
  position: relative;
}

.testimonials-heading {
  font-size: 2.5rem;
  font-family: 'Helvetica', sans-serif;
  text-align: left;
  color: #000;
}

/* Hide scrollbar but keep scroll functionality */
.testimonials-card-wrapper {
  display: flex;
  gap: 1.5rem;
  overflow-x: auto; /* still scrollable */
  scroll-behavior: smooth;
  padding-bottom: 2rem;
  padding-top: 2rem;
  position: relative;
  scroll-snap-type: x mandatory;
  
  /* Hide scrollbar for all browsers */
  -ms-overflow-style: none;  /* IE and Edge */
  scrollbar-width: none;     /* Firefox */
}
.testimonials-card-wrapper::-webkit-scrollbar {
  display: none; /* Chrome, Safari, Opera */
}

/* Individual cards - dark theme + hover animation */
.testimonial-card {
  flex: 0 0 32%; /* 3 per row on desktop */
  max-width: 33.3333%;
  scroll-snap-align: start;
  background: #000;
  border-radius: 12px;
  border: 2px solid #ff7300;
  padding: 2rem;
  color: #fff;
  transform-style: preserve-3d;
  transition: 
    transform 0.4s cubic-bezier(0.22, 1, 0.36, 1),
    box-shadow 0.4s cubic-bezier(0.22, 1, 0.36, 1),
    border 0.3s ease;
  box-shadow:
    0 4px 12px rgba(255, 115, 0, 0.45),
    0 0 10px rgba(255, 115, 0, 0.3);
}

.testimonial-card:hover {
  transform: translateY(-16px) rotateX(4deg) rotateY(2deg);

  /* Directional premium glow */
  box-shadow:
    0 -4px 10px rgba(0, 0, 0, 0.1),          /* soft shadow on top */
