inset: 0;

width: 100%;
height: 100%;

object-fit: cover;
object-position: 15% 100%;

display: block;
}

/* ===============================
IMAGE OVERLAY
Darker on left, almost clear
toward the image side
================================ */

.trek-overlay {
position: absolute;
inset: 0;

background:
linear-gradient(
90deg,
rgba(0, 0, 0, 0.78) 0%,
rgba(0, 0, 0, 0.62) 28%,
rgba(0, 0, 0, 0.28) 52%,
rgba(0, 0, 0, 0.05) 78%,
rgba(0, 0, 0, 0) 100%
);

pointer-events: none;
}

/* ===============================
CONTENT
================================ */

.trek-content {
