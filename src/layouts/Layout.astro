  color: black;
}

.result-item:hover {
  background: #f9f9f9;
}

/* ================================
   LEAD GEN MODAL — GLASSMORPHISM
   ================================ */

/* Fullscreen Backdrop */
#leadGenModal {
  display: none;
  position: fixed;
  inset: 0;
  z-index: 9999;

  background: rgba(0,0,0,0.55);
  backdrop-filter: blur(3px);

  overflow-y: auto;          /* 🔥 allow scrolling */
}

/* Modal Box */
#leadGenModal .modal-content {
  position: relative;
  max-width: 900px;
  margin: 8% auto;
  padding: 40px 35px;
  border-radius: 18px;
  overflow: hidden;

  background: url("https://res.cloudinary.com/dr44hob9b/image/upload/v1762016477/IMG_20190918_073624_xskg9n.jpg")
              center / cover no-repeat;
  box-shadow: 0 30px 80px rgba(0,0,0,0.5);
}

/* Dark Overlay for Contrast */
#leadGenModal .modal-content::before {
  content: "";
  position: absolute;
  inset: 0;
  background: linear-gradient(
    180deg,
    rgba(0,0,0,0.6),
    rgba(0,0,0,0.45)
  );
  z-index: 0;
}

/* Bring content above overlay */
#leadGenModal .modal-content > * {
  position: relative;
  z-index: 1;
}

/* Close Button */
#leadGenModal .modal-close {
  position: absolute;
  top: 18px;
  right: 22px;
  font-size: 22px;
  color: #ff7300;
  cursor: pointer;
  transition: transform 0.2s ease, color 0.2s ease;
}

#leadGenModal .modal-close:hover {
  transform: scale(1.15);
  color: #fff;
}

/* Heading & Text */
#leadGenModal h2 {
  font-family: Helvetica, sans-serif;
  font-size: 2rem;
  color: #ff7300;
  text-align: center;
  margin-bottom: 10px;
}

#leadGenModal p {
  text-align: center;
  color: #f1f1f1;
  margin-bottom: 25px;
  font-size: 1rem;
}

/* Form Groups */
#leadGenModal .form-group {
  margin-bottom: 18px;
}

/* Labels */
#leadGenModal label {
  display: block;
  font-weight: 600;
  margin-bottom: 6px;
  color: #fff;
  font-size: 0.95rem;
}

/* ================================
   GLASS INPUTS & SELECT
   ================================ */
#leadGenModal input,
#leadGenModal select {
  width: 100%;
  padding: 14px 14px;
  border-radius: 12px;
  font-size: 15px;
  color: #fff;

  background: rgba(255,255,255,0.15);
  backdrop-filter: blur(10px);
  -webkit-backdrop-filter: blur(10px);

