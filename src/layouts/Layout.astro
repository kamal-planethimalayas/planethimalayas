<script>
document.addEventListener('DOMContentLoaded', () => {
  const hamburger = document.getElementById('hamburger-btn');
  const navLinks = document.getElementById('nav-links');

  hamburger.addEventListener('click', () => {
    // Toggle the mobile menu
    navLinks.classList.toggle('show');

    // Optional: toggle active class on hamburger for animation
    hamburger.classList.toggle('active');
  });
});
</script>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const topNavbar = document.querySelector('nav.top-navbar');
    const mainNavbar = document.querySelector('nav.main-navbar');

    const topHeight = topNavbar.offsetHeight;
    const mainHeight = mainNavbar.offsetHeight;

    let lastScrollY = window.scrollY;
    let stage = 0;

    window.addEventListener('scroll', () => {
      const currentScrollY = window.scrollY;
      if (currentScrollY > lastScrollY) {
        if (stage === 0 && currentScrollY > 50) {
          topNavbar.style.transform = `translateY(-${topHeight}px)`;
          mainNavbar.style.transform = `translateY(0)`;
          stage = 1;
        } else if (stage === 1 && currentScrollY > topHeight + 50) {
          mainNavbar.style.transform = `translateY(-${mainHeight + topHeight}px)`;
          stage = 2;
        }
      } else {
        topNavbar.style.transform = 'translateY(0)';
        mainNavbar.style.transform = 'translateY(0)';
        stage = 0;
      }
      lastScrollY = currentScrollY;
    });
  });
</script>

<script>
document.addEventListener('DOMContentLoaded', () => {
  const topNavbar = document.querySelector('nav.top-navbar');
  const mainNavbar = document.querySelector('nav.main-navbar');
  let lastScrollY = window.scrollY;
  let hideStage = 0;

  function setNavbarPositions() {
    if (topNavbar && mainNavbar) {
      const topHeight = topNavbar.offsetHeight;
      document.documentElement.style.setProperty('--top-navbar-height', `${topHeight}px`);
    }
  }

  setNavbarPositions();
  window.addEventListener('resize', setNavbarPositions);

  window.addEventListener('scroll', () => {
    const currentScrollY = window.scrollY;
    if (currentScrollY > lastScrollY) {
      if (hideStage === 0 && currentScrollY > 50) {
        topNavbar.classList.add('hide');
        hideStage = 1;
      } else if (hideStage === 1 && currentScrollY > 150) {
        mainNavbar.classList.add('hide');
        hideStage = 2;
      }
    } else {
      if (hideStage === 2) {
        mainNavbar.classList.remove('hide');
        hideStage = 1;
      } else if (hideStage === 1) {
        topNavbar.classList.remove('hide');
        hideStage = 0;
      }
    }
    lastScrollY = currentScrollY;
  });
});
</script>

<script>
document.addEventListener('DOMContentLoaded', function () {
  const profileContainer = document.getElementById('.profile-container');

  // Use the global supabase client you already have
  async function updateNavbar() {
    try {
      const { data: { session } } = await supabase.auth.getSession();

      if (session && session.user) {
        profileContainer.innerHTML = `
          <a href="/my-bookings" class="profile-button">👤 My Bookings</a>
          <button id="logout-btn" class="profile-button">Logout</button>
        `;

        document.getElementById('logout-btn').addEventListener('click', async function () {
          await supabase.auth.signOut();
          updateNavbar(); // refresh navbar after logout
        });
      } else {
        profileContainer.innerHTML = `
          <a href="/auth" class="profile-button">👤 My Profile</a>
        `;
      }
    } catch (err) {
      console.error('Navbar update failed', err);
    }
  }

  updateNavbar();

  // Listen for auth state changes
  supabase.auth.onAuthStateChange((_event, session) => {
    updateNavbar();
  });
});
</script>






</body>
</html>
