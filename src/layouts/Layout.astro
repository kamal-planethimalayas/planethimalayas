---
import { treks } from '../data/treksData.js';
import WhyPlanethimalayas from '../components/WhyPlanethimalayas.astro';
const { title = "Planethimalayas", description = "Explore treks in the Himalayas with Planethimalayas" } = Astro.props;
import Footer from '../components/Footer.astro';
import "../styles/global.css";
import "react-phone-input-2/lib/style.css";
const brandColor = '#ff7300';
import { supabase } from '../lib/supabaseClient';
import AuthButton from "../components/AuthButton.jsx";
import SearchBox from "../components/SearchBox.jsx";
---


