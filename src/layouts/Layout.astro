      body {
        font-family: Helvetica, sans-serif;
        padding-top: 110px; /* total height of 2 navbars */
      }

      /* Hide both together */
      nav.top-navbar.hide {
        transform: translateY(-100%);
      }

      nav.main-navbar.hide {
        transform: translateY(-200%);
      }

      /* --- Top Navbar --- */
      nav.top-navbar {
        top: 0;
        left: 0;
        right: 0;
        height: 55px;
        background-color: white;
        display: flex;
        justify-content: space-between;
        padding:0 24px;
        align-items: center;
        z-index: 1099;
        position: fixed;
        transition: transform 0.3s ease;
        will-change: transform;
      }

      nav.top-navbar .left {
        display: flex;
        align-items: center;
        gap: 12px;
      }

      nav.top-navbar .left img.logo {
        width: 50px;
        height: 50px;
        object-fit: contain;
      }

      nav.top-navbar .left .brand-name {
        font-weight: 700;
        font-size: 1.5rem;
        user-select: none;
        color: black;
      }

      nav.top-navbar .left .brand-name .orange {
        color: var(--brand-color);
      }

      nav.top-navbar .right {
        display: flex;
        align-items: center;
        gap: 24px;
      }

      nav.top-navbar .profile-button {
        color: black;
        border: none;
        padding: 6px 18px;
        border-radius: 6px;
        font-weight: 400;
        text-decoration: none;
        cursor: pointer;
        transition: background-color 0.3s ease;
        white-space: nowrap;
      }
      nav.top-navbar .profile-button:hover,
      nav.top-navbar .profile-button:focus {
        background-color: var(--brand-color);
      }

      nav.top-navbar .search-wrapper {
        position: relative;
      }
      

      /* --- Main Navbar --- */
      nav.main-navbar {
        top: 55px;
        left: 0;
        right: 0;
        height: 55px;
        background-color: var(--brand-color);
        display: flex;
        justify-content: flex-end;
        padding-right:24px;
        align-items: center;
        z-index: 1099;
        position: fixed;
        transition: transform 0.3s ease;
        will-change: transform;
      }

      nav.main-navbar ul.nav-links {
        list-style: none;
        display: flex;
        gap: 2rem;
        margin: 0;
        padding: 0;
        flex-grow: 1;
        justify-content: center;
      }

      nav.main-navbar ul.nav-links li a {
        font-weight: 700;
        color: black;
        text-decoration: none;
        padding: 8px 16px;
        border-radius: 8px;
        transition: background-color 0.3s ease, color 0.3s ease;
        user-select: none;
      }

      nav.main-navbar ul.nav-links li a:hover,
      nav.main-navbar ul.nav-links li a:focus {
        background: white;
        color: var(--brand-color);
        outline: none;
      }

      /* Hamburger styles */
      .hamburger {
        position:relative;
        z-index: 1300;
        display: none;
        flex-direction: column;
        gap: 5px;
        cursor: pointer;
        background: none;
        border: none;
        padding: 4px;
        margin-left: 12px;
        transition: border 0.3s ease;
        border: 4px solid transparent;
        border-radius: 10px;
      }

      .hamburger span {
        display: block;
        width: 22px;
        height: 3px;
        background: black;
        border-radius: 2px;
        transition: border-color 0.3s ease;
      }

      .hamburger:hover,
      .hamburger:focus,
      .hamburger.active {
        border-color: var(--brand-color);
      }

      /* Mobile styles */
