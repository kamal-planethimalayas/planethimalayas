      body {
        font-family: Helvetica, sans-serif;
        padding-top: 110px; /* total height of 2 navbars */
      }

      /* Hide both together */
      nav.top-navbar.hide {
        transform: translateY(-100%);
      }

      nav.main-navbar.hide {
        transform: translateY(-200%);
      }

      /* --- Top Navbar --- */
      nav.top-navbar {
        top: 0;
        left: 0;
        right: 0;
        height: 55px;
        background-color: white;
        display: flex;
        justify-content: space-between;
        padding:0 24px;
        align-items: center;
        z-index: 1099;
        position: fixed;
        transition: transform 0.3s ease;
        will-change: transform;
      }

      nav.top-navbar .left {
        display: flex;
        align-items: center;
        gap: 12px;
      }

      nav.top-navbar .left img.logo {
        width: 50px;
        height: 50px;
        object-fit: contain;
      }

      nav.top-navbar .left .brand-name {
        font-weight: 700;
        font-size: 1.5rem;
        user-select: none;
        color: black;
      }

      nav.top-navbar .left .brand-name .orange {
        color: var(--brand-color);
      }

      nav.top-navbar .right {
        display: flex;
        align-items: center;
        gap: 12px;
      }

    


      /* --- Main Navbar --- */
      nav.main-navbar {
        top: 55px;
        left: 0;
        right: 0;
        height: 55px;
        background-color: var(--brand-color);
        display: flex;
        justify-content: flex-end;
        padding-right:24px;
        align-items: center;
        z-index: 1099;
        position: fixed;
        transition: transform 0.3s ease;
        will-change: transform;
      }

      nav.main-navbar ul.nav-links {
        list-style: none;
        display: flex;
        gap: 2rem;
        margin: 0;
        padding: 0;
        flex-grow: 1;
        justify-content: center;
      }

      nav.main-navbar ul.nav-links li a {
        font-weight: 700;
        color: black;
        text-decoration: none;
        padding: 8px 16px;
        border-radius: 8px;
        transition: background-color 0.3s ease, color 0.3s ease;
        user-select: none;
      }

      nav.main-navbar ul.nav-links li a:hover,
      nav.main-navbar ul.nav-links li a:focus {
        background: white;
        color: var(--brand-color);
        outline: none;
      }

     /* Hamburger styles - unchanged */
.hamburger {
  position: relative;
  z-index: 1300; /* above menu */
  display: none;
  flex-direction: column;
  gap: 5px;
  cursor: pointer;
  background: none;
  border: none;
  padding: 4px;
  margin-left: 2px;
  transition: border 0.3s ease;
  border: 4px solid transparent;
  border-radius: 10px;
}

.hamburger span {
  display: block;
  width: 22px;
  height: 3px;
  background: black;
  border-radius: 2px;
  transition: border-color 0.3s ease;
}

.hamburger:hover,
.hamburger:focus,
.hamburger.active {
  border-color: var(--brand-color);
}

/* Mobile styles */
@media (max-width: 768px) {
  nav.main-navbar {
    height: 0; 
    position: fixed;   /* so menu slides over content */
    top: 0;
    right: 0;
    width: auto;
    z-index: 1200;     /* below hamburger */
  }

  nav.main-navbar ul.nav-links {
    display: flex;
    flex-direction: column;
    position: fixed;  /* fixed so it scrolls with page */
    top: 55px;        /* below top navbar */
    right: 0;
    width: 50vw;
    max-width: 300px;
    height: 100vh;    /* full screen height */
    background-color: var(--brand-color);
    transform: translateX(100%);  /* hidden by default */
    transition: transform 0.3s ease;
    padding-top: 1rem;
    z-index: 1100;     /* below hamburger */
    overflow-y: auto;
    border-bottom-left-radius: 12px;
    border-top-left-radius: 12px;
    box-shadow: -2px 0 8px rgba(0,0,0,0.25);
  }

  nav.main-navbar ul.nav-links.show {
    transform: translateX(0);  /* slide in */
  }

  .hamburger {
    display: flex;  /* show hamburger on mobile */
  }

  nav.top-navbar .profile-button {
    display: none;
  }
}

/* Desktop - hide hamburger */
@media (min-width: 769px) {
  nav.top-navbar .hamburger {
    display: none;
  }
}

main {
