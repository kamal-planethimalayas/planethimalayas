        nav.main-navbar {
          height: 0px;
          position: absolute;
          top: 1px;
          right: 0;
          width: auto;
          z-index: 1100;
        }

        nav.main-navbar ul.nav-links {
          display: none;
          flex-direction: column;
          background-color: var(--brand-color);
