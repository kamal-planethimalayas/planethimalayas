          border-bottom-right-radius: 12px;
          box-shadow: -2px 0 8px rgba(0,0,0,0.25);
          transition: transform 0.3s ease, opacity 0.3s ease;
    transform: translateX(100%);
    opacity: 0;
        }

        nav.main-navbar ul.nav-links.show {
