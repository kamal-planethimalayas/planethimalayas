    border-bottom-left-radius: 12px;
    border-top-left-radius: 12px;
    box-shadow: -2px 0 8px rgba(0,0,0,0.25);
  }

  nav.main-navbar ul.nav-links.show {
    transform: translateX(0);  /* slide in */
