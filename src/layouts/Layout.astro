<script>
document.addEventListener("DOMContentLoaded", () => {
  const hamburger = document.querySelector(".hamburger");
  const navLinks = document.querySelector("nav.main-navbar ul.nav-links");

  hamburger.addEventListener("click", () => {
    navLinks.classList.toggle("show");
  });

  // Detect clicks outside the menu
  document.addEventListener("click", (e) => {
    if (
      navLinks.classList.contains("show") &&
      !navLinks.contains(e.target) &&
      !hamburger.contains(e.target)
    ) {
      navLinks.classList.remove("show");
    }
  });
});
</script>

<script>
document.addEventListener('DOMContentLoaded', () => {
  const topNavbar = document.querySelector('nav.top-navbar');
  const mainNavbar = document.querySelector('nav.main-navbar');
  let lastScrollY = window.scrollY;
  let hideStage = 0;

  function setNavbarPositions() {
    if (topNavbar && mainNavbar) {
      const topHeight = topNavbar.offsetHeight;
      document.documentElement.style.setProperty('--top-navbar-height', `${topHeight}px`);
    }
  }

  setNavbarPositions();
  window.addEventListener('resize', setNavbarPositions);

  window.addEventListener('scroll', () => {
    const currentScrollY = window.scrollY;
    if (currentScrollY > lastScrollY) {
      if (hideStage === 0 && currentScrollY > 50) {
        topNavbar.classList.add('hide');
        hideStage = 1;
      } else if (hideStage === 1 && currentScrollY > 150) {
        mainNavbar.classList.add('hide');
        hideStage = 2;
      }
    } else {
      if (hideStage === 2) {
        mainNavbar.classList.remove('hide');
        hideStage = 1;
      } else if (hideStage === 1) {
        topNavbar.classList.remove('hide');
        hideStage = 0;
      }
    }
    lastScrollY = currentScrollY;
  });
});
</script>

<script>
  const toggleBtn = document.getElementById("mobile-search-toggle");
  const dropdown = document.getElementById("mobile-search-dropdown");

  toggleBtn.addEventListener("click", () => {
    dropdown.style.display = dropdown.style.display === "block" ? "none" : "block";
  });

  // Close dropdown on outside click
  document.addEventListener("click", (e) => {
    if (
      !dropdown.contains(e.target) &&
      !toggleBtn.contains(e.target)
    ) {
      dropdown.style.display = "none";
    }
  });
</script>

<script>
(function () {
  const btn = document.getElementById("scrollTopBtn");

  if (!btn) return;

  function toggleScrollTop() {
    const windowScrolled = window.scrollY > 300;

    // Check if ANY scrollable container has been scrolled
    const containerScrolled = [...document.querySelectorAll("*")]
      .some(el =>
        el.scrollHeight > el.clientHeight && el.scrollTop > 300
      );

    if (windowScrolled || containerScrolled) {
      btn.style.display = "flex";
      btn.style.opacity = "1";
    } else {
      btn.style.opacity = "0";
      btn.style.display = "none";
    }
  }

  // Listen to window scroll
  window.addEventListener("scroll", toggleScrollTop, { passive: true });

  // Listen to scroll on scrollable containers
  document.addEventListener("scroll", toggleScrollTop, {
    passive: true,
    capture: true
  });

  // Scroll to top (global)
  btn.addEventListener("click", () => {
    window.scrollTo({ top: 0, behavior: "smooth" });

    // Reset any scrollable containers
    document.querySelectorAll("*").forEach(el => {
      if (el.scrollHeight > el.clientHeight) {
        el.scrollTo({ top: 0, behavior: "smooth" });
      }
    });
  });
})();
</script>

<script is:client>
window.addEventListener('DOMContentLoaded', () => {
  const modal = document.getElementById('leadGenModal');
  const closeBtn = modal.querySelector('.modal-close');
  const form = document.getElementById('leadGenForm');
  const thankYou = document.getElementById('leadGenThankYou');
  const trekInput = document.getElementById('trekName');
  const phoneField = document.getElementById('phone');

  // Open/Close modal
  const openModal = (trekName = "") => {
    trekInput.value = trekName; // prefill trek name if provided
    modal.style.display = 'block';
  };
  const closeModal = () => {
    modal.style.display = 'none';
  };

  // Automatic popup after 8s on first visit
  if (!sessionStorage.getItem('leadGenShown')) {
    setTimeout(() => {
      openModal();
      sessionStorage.setItem('leadGenShown', 'true');
    }, 8000);
  }

  // Close modal on close button or outside click
  closeBtn.addEventListener('click', closeModal);
  window.addEventListener('click', (e) => {
    if (e.target === modal) closeModal();
  });

  // Open modal when any Enquire/Plan Now button is clicked
  document.querySelectorAll('.enquire-now-btn, .plan-now-btn').forEach(btn => {
    btn.addEventListener('click', () => openModal(btn.dataset.trek));
  });

  // Initialize intl-tel-input for phone
  const phoneInput = intlTelInput(phoneField, {
    initialCountry: "in",
    separateDialCode: true,
    utilsScript: "https://cdn.jsdelivr.net/npm/intl-tel-input@18.1.1/build/js/utils.js"
  });

  // Form submission
  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    const formData = new FormData(form);

    // Get full phone number including country code
    formData.set("phone", phoneInput.getNumber());

    try {
      const res = await fetch(form.action, {
        method: 'POST',
        body: formData,
        headers: { 'Accept': 'application/json' }
      });

      if (res.ok) {
        form.style.display = 'none';
        thankYou.style.display = 'block';
      } else {
        alert('There was a problem submitting the form.');
      }
    } catch (err) {
      console.error(err);
      alert('There was a problem submitting the form.');
    }
  });
});
</script>

